# DockerHosting / Portainer deployment settings
COMPOSE_PROJECT_NAME=vk-taxi
TZ=Asia/Yekaterinburg

# PostgreSQL. Use a URL-safe password: letters and digits only.
POSTGRES_DB=taxi
POSTGRES_USER=taxi
POSTGRES_PASSWORD=CHANGE_TO_RANDOM_HEX_PASSWORD

# VK community
VK_TOKEN=PASTE_COMMUNITY_TOKEN
VK_CHAT_USER_TOKEN=PASTE_USER_TOKEN_IF_DRIVER_CHAT_IS_USED
VK_GROUP_ID=123456789
VK_API_VERSION=5.199
ADMIN_VK_IDS=123456789

# Web admin panel
SECRET_KEY=CHANGE_TO_RANDOM_64_HEX_SECRET
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_TO_STRONG_ADMIN_PASSWORD
ADMIN_PASSWORD_HASH=
ADMIN_PORT=3000
ADMIN_BIND_IP=0.0.0.0
# Keep 0 while opening the panel by http://SERVER_IP:3000.
# Set to 1 only after HTTPS is configured.
FLASK_COOKIE_SECURE=0
WEB_WORKERS=1
WEB_THREADS=4
# Web-only resilience. /live detects HTTP hangs; /health checks the database.
ADMIN_WATCHDOG_ENABLED=1
ADMIN_WATCHDOG_INTERVAL=15
ADMIN_WATCHDOG_FAILURES=4
ADMIN_WATCHDOG_TIMEOUT=3
ADMIN_WATCHDOG_STARTUP_GRACE=120
WEB_TIMEOUT=60
WEB_GRACEFUL_TIMEOUT=30
WEB_MAX_REQUESTS=2000
WEB_MAX_REQUESTS_JITTER=200
DB_CONNECT_TIMEOUT=5
ADMIN_DB_STATEMENT_TIMEOUT_MS=30000
ADMIN_DB_LOCK_TIMEOUT_MS=5000
ADMIN_DB_IDLE_TRANSACTION_TIMEOUT_MS=60000

# Database pools
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=280

# Bot workers and timers
BOT_WORKERS=16
BOT_MAX_PENDING_EVENTS=1000
OUTBOX_WORKERS=8
TIMER_WORKERS=8
SETTINGS_CACHE_TTL=30
MAINTENANCE_INTERVAL=60
PROCESSED_EVENTS_RETENTION_HOURS=12
OUTBOX_RETENTION_HOURS=24

# VK driver chat and business settings
DRIVER_FALLBACK_CHAT_PEER_ID=0
DRIVER_CHAT_PEER_ID=0
DRIVER_ACCEPT_TIMEOUT=60
DRIVER_CHAT_TIMEOUT=2700
DISPATCHER_COMMISSION=0.10
PASSENGER_POLL_TIMEOUT=60

# Verification and maps
VERIFY_ENABLED=true
VERIFY_MIN_FRIENDS=10
VERIFY_MIN_ACCOUNT_MONTHS=6
VERIFY_TTL_DAYS=30
MAPS_PROVIDER=yandex
MAPS_API_KEY=
SUPPORT_LINK=https://vk.me/club123456789

LOG_LEVEL=INFO

# Android driver notification app
FIREBASE_SERVICE_ACCOUNT_FILE=/app/secrets/firebase-service-account.json
# Alternative for Portainer-only installs: paste one-line base64 service-account JSON.
FIREBASE_SERVICE_ACCOUNT_B64=
VK_BOT_URL=https://vk.me/club0
PUSH_SOUND_DIR=/app/data/push_sounds
DRIVER_APP_APK_FILE=/app/downloads/BEZTAKSY.apk

# V179: bot-only safeguards; seconds unless indicated otherwise.
BOT_WATCHDOG_ENABLED=1
BOT_TASK_TIMEOUT=180
BOT_STARTUP_TIMEOUT=180
BOT_POLL_STALL_TIMEOUT=90
BOT_OUTBOX_STALL_TIMEOUT=90
BOT_DB_STATEMENT_TIMEOUT_MS=30000
BOT_DB_LOCK_TIMEOUT_MS=5000
BOT_DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
