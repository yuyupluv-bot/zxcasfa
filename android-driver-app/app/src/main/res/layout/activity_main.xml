<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/app_background"
            android:contentDescription="@string/menu_open"
            android:elevation="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            app:navigationIcon="@drawable/ic_menu"
            app:title="Главная"
            app:titleTextColor="@color/app_text" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/mainScreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="32dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.05"
                        android:text="БЕЗТАКСЫ"
                        android:textColor="@color/app_accent"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Уведомления водителя"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/readinessCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Готовность приложения"
                            android:textColor="@color/app_text"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/notificationStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_status"
                            android:text="●  Уведомления"
                            android:textColor="@color/app_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/backgroundStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_status"
                            android:text="●  Работа в фоне"
                            android:textColor="@color/app_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/backgroundButton"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="16dp"
                            android:text="НАСТРОИТЬ РАБОТУ В ФОНЕ"
                            android:textColor="@color/app_text"
                            app:cornerRadius="14dp"
                            app:strokeColor="@color/app_border" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/codeSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Подключение"
                            android:textColor="@color/app_text"
                            android:textSize="23sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3dp"
                            android:text="Получите одноразовый код в VK-боте:\nМои сведения → Подключить приложение"
                            android:textColor="@color/app_text_secondary"
                            android:textSize="15sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:hint="Код подключения"
                            app:boxBackgroundColor="@color/app_surface"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxStrokeColor="@color/app_accent">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/code"
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:gravity="center"
                                android:inputType="number"
                                android:letterSpacing="0.18"
                                android:maxLength="10"
                                android:textColor="@color/app_text"
                                android:textSize="28sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/connect"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="14dp"
                            android:backgroundTint="@color/app_accent"
                            android:text="ПОДКЛЮЧИТЬ"
                            android:textColor="@color/app_accent_on"
                            android:textStyle="bold"
                            app:cornerRadius="14dp" />

                        <TextView
                            android:id="@+id/status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="Не подключено"
                            android:textColor="@color/app_text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dashboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/statusDot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status"
                            android:text="●  Подключено"
                            android:textColor="@color/app_positive"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/driverName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="Водитель"
                            android:textColor="@color/app_text"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/connectionText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Уведомления включены"
                            android:textColor="@color/app_text_secondary"
                            android:textSize="16sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/toggleNotifications"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="22dp"
                            android:backgroundTint="@color/app_accent"
                            android:text="ВЫКЛЮЧИТЬ УВЕДОМЛЕНИЯ"
                            android:textColor="@color/app_accent_on"
                            android:textStyle="bold"
                            app:cornerRadius="14dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/test"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:text="ТЕСТ ЗВУКА"
                        android:textColor="@color/app_text"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/app_border" />
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/settingsScreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="40dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Звук и вибрация"
                        android:textColor="@color/app_text"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/volumeValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Громкость сигнала · 100%"
                            android:textColor="@color/app_text"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <SeekBar
                            android:id="@+id/volumeSeek"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            android:min="0"
                            android:progress="100"
                            android:progressTint="@color/app_accent"
                            android:thumbTint="@color/app_accent" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Учитывается системная громкость будильника. Приложение не меняет её самостоятельно."
                            android:textColor="@color/app_text_secondary"
                            android:textSize="14sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/vibrationSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="10dp"
                            android:checked="true"
                            android:text="Вибрация"
                            android:textColor="@color/app_text"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="Сценарии уведомлений"
                        android:textColor="@color/app_text"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/orderSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:checked="true"
                            android:text="Новая заявка"
                            android:textColor="@color/app_text"
                            android:textSize="16sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/parallelSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:checked="true"
                            android:text="Параллельная заявка"
                            android:textColor="@color/app_text"
                            android:textSize="16sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/cancelSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:checked="true"
                            android:text="Отмена заявки"
                            android:textColor="@color/app_text"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="Оформление"
                        android:textColor="@color/app_text"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/themeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/themeLight"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="Светлая тема"
                            android:textColor="@color/app_text"
                            android:textSize="16sp" />

                        <RadioButton
                            android:id="@+id/themeDark"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="Тёмная тема"
                            android:textColor="@color/app_text"
                            android:textSize="16sp" />
                    </RadioGroup>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="Системные разрешения"
                        android:textColor="@color/app_text"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/notificationSettingsButton"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="НАСТРОЙКИ УВЕДОМЛЕНИЙ"
                            android:textColor="@color/app_text"
                            app:cornerRadius="14dp"
                            app:strokeColor="@color/app_border" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/batterySettingsButton"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="10dp"
                            android:text="ОГРАНИЧЕНИЯ В ФОНЕ"
                            android:textColor="@color/app_text"
                            app:cornerRadius="14dp"
                            app:strokeColor="@color/app_border" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/privacyButton"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:text="Политика конфиденциальности"
                            android:textColor="@color/app_text_secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/disconnectButton"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="10dp"
                            android:text="ОТКЛЮЧИТЬ УСТРОЙСТВО"
                            android:textColor="@color/app_danger"
                            app:cornerRadius="14dp"
                            app:strokeColor="@color/app_danger" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/app_surface"
        android:fitsSystemWindows="true"
        app:itemIconTint="@color/app_text"
        app:itemTextColor="@color/app_text"
        app:menu="@menu/drawer_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
