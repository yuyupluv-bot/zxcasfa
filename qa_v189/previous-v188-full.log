filter(Order.id == pending_offer.id)\n        .with_for_update()\n        .one_or_none()\n    )\n    if (\n        offer is None\n        or offer.status != "searching"\n        or offer.offered_driver_id != driver.id\n        or offer.driver_id is not None\n    ):\n        return False\n\n    timers.cancel("accept", offer.id)\n    order_service.finalize_offer_message(\n        session,\n        offer,\n        "Заявка передана следующему свободному водителю.",\n    )\n    offer.offered_driver_id = None\n    offer.status = "created"\n    # Repair a legacy/raced queue row before selecting the next recipient.\n    queue_service.mark_assigned(session, driver)\n    audit.record(\n        session,\n        "stale_offer_released",\n        f"offer={offer.id} active={current_order.id} driver={driver.id}",\n    )\n    order_service.offer_to_next_driver(\n        session,\n        offer,\n        temporary_exclude_driver_ids={driver.id},\n    )\n    return True\n\n\ndef _has_active_order(session: Session, user: User) -> bool:\n    """Req 4: True if the user has an active order (as passenger or driver).\n\n    Dispatchers and admins are exempt: they manage orders and must keep menu\n    access at all times.\n    """\n    if user.role in (ROLE_ADMIN, ROLE_DISPATCHER):\n        return False\n    return bool(\n        active_order_for(session, user)\n        or active_order_for(session, user, as_driver=True)\n        or (user.role == ROLE_DRIVER and offered_order_for(session, user))\n    )\n\n\ndef _menu_lock_notice(session: Session, user: User) -> None:\n    """Req 4: inform the user the menu is locked until the order is finished."""\n    keyboard = None\n    if user.has_role(ROLE_DRIVER):\n        active = active_order_for(session, user, as_driver=True)\n        state = get_state(session, user.vk_id).state\n        if (\n            active\n            and state not in (States.D_DELIVERY_PRICE, States.D_CUSTOM_PRICE, States.D_OFFER)\n            and not (\n                delivery_service.is_delivery(active)\n                and not active.actuality_confirmed\n            )\n        ):\n            keyboard = _active_driver_order_keyboard(session, active)\n    vk.send_message(user.vk_id, msg(session, "msg_menu_locked"), keyboard=keyboard)\n\n\ndef send_bot_message(session: Session, vk_id: int, key: str, keyboard=None, **fmt) -> None:\n    """Send an admin-editable message (with optional attached photo)."""\n    text, file_id = bm.render(session, key, **fmt)\n    vk.send_message(vk_id, text, keyboard=keyboard, attachment=file_id or None)\n\n\n# --------------------------------------------------------------------------- #\n#  Entry point                                                                 #\n# --------------------------------------------------------------------------- #\nHANDLER_ERROR_NOTICE = (\n    "\\u26a0\\ufe0f Не получилось обработать действие. Попробуйте ещё раз или напишите «меню»."\n)\n\n\ndef handle_message(session: Session, event) -> None:\n    """Wrapper: a crashing handler must never answer a person with silence.\n\n    The exception is re-raised so the transaction is rolled back and no\n    half-written order is committed, but the person always gets a reply.\n    """\n    try:\n        return _handle_message_impl(session, event)\n    except Exception as exc:  # noqa: BLE001\n        log.exception("handle_message failed: %s", exc)\n        try:\n            message = getattr(getattr(event, "obj", None), "message", None) or {}\n            vk_id = int(message.get("from_id") or 0)\n            peer_id = int(message.get("peer_id") or vk_id)\n            if vk_id > 0 and peer_id == vk_id:\n                vk.send_message(vk_id, HANDLER_ERROR_NOTICE)\n        except Exception:  # noqa: BLE001\n            log.exception("Failed to notify the user about a handler error")\n        raise\n\n\ndef _handle_message_impl(session: Session, event) -> None:\n    # Do not call this local variable `msg`: that name is the imported\n    # settings_service.msg() function used throughout onboarding. Shadowing it\n    # made the first incoming message fail with "dict object is not callable".\n    message = event.obj.message\n    vk_id = message["from_id"]\n    text = (message.get("text") or "").strip()\n    payload = parse_payload(message.get("payload"))\n    if vk_id < 0:  # ignore messages from groups/communities\n        return\n\n    # Price questions are observed independently of normal conversation state.\n    try:\n        from . import common_chat_notices\n        with session.begin_nested():\n            common_chat_notices.notify_price_question(session, message)\n    except Exception:  # noqa: BLE001\n        log.exception("Price-question notice processing failed")\n\n    # A notice failure must not break normal message processing.\n    if int(message.get("peer_id") or 0) >= 2_000_000_000:\n        try:\n            from . import common_chat_notices\n            with session.begin_nested():\n                common_chat_notices.handle_message(session, message)\n        except Exception:  # noqa: BLE001\n            log.exception("Common-chat notice processing failed")\n\n    # Blocked IDs are handled before user lookup and attachment hydration. The\n    # first message gets one notice; every later message is dropped silently.\n    blocked_ids = _cached_blocked_vk_ids(session)\n    if vk_id in blocked_ids:\n        if vk_id not in _blocked_notified_vk_ids:\n            row = session.query(BlockedUser).filter(BlockedUser.vk_id == vk_id).one_or_none()\n            if row and not row.notice_sent:\n                send_bot_message(session, vk_id, "blocked")\n                row.notice_sent = True\n                with _blocked_cache_lock:\n                    _blocked_notified_vk_ids.add(vk_id)\n        return\n\n    # One user lookup instead of three sequential queries on every allowed message.\n    user = session.query(User).filter(User.vk_id == vk_id).one_or_none()\n    if user and user.is_blocked:\n        row = session.query(BlockedUser).filter(BlockedUser.vk_id == vk_id).one_or_none()\n        if row is None:\n            row = BlockedUser(vk_id=vk_id, reason="Заблокирован администратором", notice_sent=False)\n            session.add(row)\n            session.flush()\n        if not row.notice_sent:\n            send_bot_message(session, vk_id, "blocked")\n            row.notice_sent = True\n        _invalidate_blocked_cache()\n        return\n\n    is_new_user = user is None\n    if user is None:\n        user = User(vk_id=vk_id, full_name=f"id{vk_id}")\n        session.add(user)\n        session.flush()\n    if vk_id in config.ADMIN_VK_IDS and not user.has_role(ROLE_ADMIN):\n        user.grant_role(ROLE_ADMIN)\n        if user.rating_count == 0 and user.role == ROLE_PASSENGER:\n            user.role = ROLE_ADMIN\n    cmd = payload.get("cmd")\n    # Some VK clients occasionally send the regular-keyboard label without\n    # its payload.  The parallel-list back button then looks pressed in chat\n    # but the bot receives only plain text.  Recover this one safe navigation\n    # action from its exact label instead of silently forwarding it to chat.\n    if not cmd and user.has_role(ROLE_DRIVER):\n        plain_button_text = re.sub(r"^[^\\wа-яё]+", "", text.casefold()).strip()\n        if plain_button_text in (\n            "вернуться к активной заявке",\n            "вернуться к заявке",\n        ):\n            payload = {"cmd": "parallel_back"}\n            cmd = "parallel_back"\n\n    # A few VK clients drop button payloads. Only a private, exact finish\n    # label for a driver\'s in-progress order may recover the command.\n    if not cmd and user.has_role(ROLE_DRIVER) and int(message.get("peer_id") or vk_id) == vk_id:\n        recovered_cmd = driver_trip_command_from_label(text)\n        if recovered_cmd:\n            ride = active_order_for(session, user, as_driver=True)\n            if ride and ride.status == "in_progress":\n                payload = {"cmd": recovered_cmd}\n                cmd = recovered_cmd\n                log.info("Recovered finish label without payload: driver=%s order=%s", user.id, ride.id)\n\n    # Messages written inside the common driver conversation must never be\n    # routed through a driver\'s/passenger\'s private FSM. Remember the real\n    # conversation peer_id for dispatch, then ignore ordinary chat text. The\n    # only conversation action allowed through is the inline «Взять заявку»\n    # button attached by the bot.\n    peer_id = int(message.get("peer_id") or vk_id)\n    is_conversation = peer_id != vk_id and peer_id >= 2_000_000_000\n    if is_conversation:\n        command = text.casefold().strip()\n        if user.has_role(ROLE_ADMIN) and command in ("!назначить водительский чат", "!назначить чат заявок"):\n            set_setting(session, "driver_fallback_chat_peer_id", peer_id)\n            return vk.send_message(peer_id, f"✅ Единый чат заявок настроен: {peer_id}")\n        # An inline button in the driver chat must work for every user who\n        # *has* the driver role, even if their currently selected bot role is\n        # passenger. Do not send this event through the normal role router.\n        allowed_conversation_cmds = ("chat_take", "booking_take")\n        if cmd in allowed_conversation_cmds and user.has_role(ROLE_DRIVER):\n            pending_offer = offered_order_for(session, user)\n            if pending_offer and not queue_service.offer_lock_is_live(session, user):\n                # A dead reservation must never lock a driver out of the chat.\n                pending_offer.offered_driver_id = None\n                session.flush()\n                log.warning(\n                    "Released stale offer lock order=%s driver=%s before chat claim",\n                    pending_offer.id,\n                    user.id,\n                )\n                pending_offer = None\n            # A claim in the requests chat is never blocked by a pending\n            # offer: driver_take_from_chat hands that offer to the next\n            # driver. Only the booking button keeps the old lock.\n            if pending_offer and cmd != "chat_take":\n                _chat_claim_reply(\n                    session,\n                    user,\n                    f"сначала ответьте на заявку #{pending_offer.number} в личных сообщениях бота.",\n                )\n                return _driver_offer_lock_notice(session, user, pending_offer)\n        if cmd in allowed_conversation_cmds and not abuse_service.allow_event(session, user, payload):\n            return\n        if cmd == "booking_take":\n            if not user.has_role(ROLE_DRIVER):\n                return vk.send_message(vk_id, "Взять бронь может только водитель.")\n            return driver_take_booking(session, user, payload.get("booking_id"))\n        if cmd == "chat_take":\n            if not user.has_role(ROLE_DRIVER):\n                _chat_claim_reply(session, user, "взять заявку может только водитель.")\n                return vk.send_message(vk_id, "Взять заявку может только водитель.")\n            return driver_take_from_chat(session, user, payload.get("order_id"))\n        if cmd == "chat_price_offer":\n            if not user.has_role(ROLE_DRIVER):\n                return vk.send_message(vk_id, "Предложить цену может только водитель.")\n            return customer_price_service.reserve_from_chat(\n                session, user, payload.get("order_id")\n            )\n        # Only bot-owned claim buttons may be processed inside the driver\n        # conversation. Ordinary group discussion must never touch user FSMs.\n        if cmd not in allowed_conversation_cmds:\n            return\n\n    # Apply anti-flood checks before attachment hydration and business queries.\n    # Ordinary driver-chat discussion was returned above and does not count.\n    if not is_conversation and not abuse_service.allow_event(session, user, payload):\n        return\n\n    # Voice messages are occasionally sparse in Bot Long Poll. Hydrate only\n    # allowed messages so blocked/limited users cannot consume VK resources.\n    attachments = vk.message_attachments(message)\n\n    # Community subscription is optional. New and existing passengers proceed\n    # directly to the normal onboarding/menu flow without a groups.isMember\n    # request or a «Я подписался» gate. Keep accepting clicks from old\n    # subscription messages so previously sent keyboards do not dead-end.\n    if cmd == "check_subscription":\n        return show_main_menu(session, user)\n\n    # One best-effort VK profile lookup. VK sex values are public profile\n    # metadata: 1=female, 2=male, 0=not specified. Remember the result so normal\n    # commands never repeat this request.\n    if user.full_name == f"id{vk_id}" or not user.driver_gender:\n        profile = vk.get_user_info(vk_id)\n        profile_name = f"{profile.get(\'first_name\', \'\')} {profile.get(\'last_name\', \'\')}".strip()\n        if profile_name:\n            user.full_name = profile_name\n        if not user.driver_gender:\n            sex = profile.get("sex")\n            user.driver_gender = "female" if sex == 1 else "male" if sex == 2 else "unknown"\n\n    # Second onboarding gate: best-effort anti-fraud verification. Missing VK\n    # values are skipped by verification.verify_user, so API/privacy failures\n    # never reject an otherwise valid subscriber.\n    if user.role == ROLE_PASSENGER:\n        account_allowed, _ = verification.verify_user(session, user)\n        if not account_allowed:\n            vk.send_message(vk_id, msg(session, "msg_fake_account"))\n            return\n    # Fake-call lockdown (highest priority): a passenger who owes a false-call\n    # payment can do NOTHING except request the driver\'s profile link. This is\n    # checked BEFORE the global «start»/«меню»/role commands so typing\n    # «Старт» can no longer be used to escape the restriction. Admins are\n    # exempt so support staff never lock themselves out.\n    if user.role != ROLE_ADMIN and fake_calls_service.is_passenger_blocked(user):\n        if fake_calls_service.handle_locked_input(session, user, cmd):\n            return\n\n    state = get_state(session, vk_id).state\n    pending_offer = None\n    if user.has_role(ROLE_DRIVER):\n        pending_offer = offered_order_for(session, user)\n        current_driver_order = active_order_for(session, user, as_driver=True)\n        if pending_offer and current_driver_order:\n            if _release_stale_offer_for_active_ride(\n                session, user, pending_offer, current_driver_order\n            ):\n                pending_offer = None\n\n        # A durable driver input state always wins over an ordinary offer.\n        # In particular, a fare typed after «🏁 Завершить» must not be turned\n        # into D_OFFER by a stale offer card.\n        if state in _DRIVER_OWNED_INPUT_STATES:\n            return handle_driver(session, user, state, text, payload, attachments)\n        # A valid finish button belongs to the active driver\'s trip even\n        # when the selected menu role is dispatcher/admin/passenger.\n        if cmd == "finish" and current_driver_order is not None:\n            return handle_driver(session, user, state, text, payload, attachments)\n\n    # While an ordinary request is on the driver\'s screen, it is an exclusive\n    # decision: accept, decline, or wait for the timeout that removes the\n    # driver from the line. No menu, role switch, text, or unrelated button may\n    # replace the live offer.\n    if user.role == ROLE_DRIVER and pending_offer:\n        if cmd not in _DRIVER_OFFER_ALLOWED_CMDS:\n            return _driver_offer_lock_notice(session, user, pending_offer)\n\n    # Leaving the 90-second direct-selection input must release the driver;\n    # otherwise a plain «Меню» would strand an invisible reservation.\n    is_start_command = (\n        text.lower() in ("начать", "start", "/start", "меню") or cmd == "start"\n    )\n    if state == States.P_DIRECT_TEXT and (is_start_command or cmd == "change_role"):\n        cancel_direct_driver_selection(\n            session, user, notify_passenger=False, notify_driver=True\n        )\n\n    # Global commands available from anywhere. «Начать» now opens the main\n    # menu immediately; community membership is not required.\n    if is_start_command:\n        # Requirement 4: block returning to the menu while an order is active.\n        if _has_active_order(session, user):\n            return _menu_lock_notice(session, user)\n        return show_main_menu(session, user)\n    if cmd == "change_role":\n        return show_role_choice(session, user)\n    if cmd == "role_set":\n        return do_role_set(session, user, payload.get("role"))\n\n    try:\n        if user.role == ROLE_ADMIN:\n            handle_admin(session, user, state, text, payload, attachments)\n        elif user.role == ROLE_DISPATCHER:\n            handle_dispatcher(session, user, state, text, payload, attachments)\n        elif user.role == ROLE_DRIVER:\n            handle_driver(session, user, state, text, payload, attachments)\n        else:\n            handle_passenger(session, user, state, text, payload, attachments)\n    except Exception as exc:  # noqa: BLE001\n        log.exception("Handler error for %s: %s", vk_id, exc)\n        vk.send_message(vk_id, "⚠️ Произошла ошибка. Попробуйте ещё раз или напишите «Меню».")\n\n\ndef handle_group_join(session: Session, vk_id: int) -> None:\n    """Send editable rules immediately after a user joins the community."""\n    if not vk_id or vk_id < 0:\n        return\n    user = get_or_create_user(session, vk_id)\n    rules = get_cached(session, "community_rules", "Правила сообщества пока не заполнены.") or ""\n    vk.send_message(vk_id, rules)\n    user.subscription_rules_sent = True\n\n\n# --------------------------------------------------------------------------- #\n#  Common / onboarding / role switching                                        #\n# --------------------------------------------------------------------------- #\ndef show_start(session: Session, user: User) -> None:\n    text, file_id = bm.render(session, "welcome")\n    vk.send_message(user.vk_id, text, attachment=file_id or None)\n    show_main_menu(session, user)\n\n\ndef show_role_choice(session: Session, user: User) -> None:\n    """«Смена роли» — only for users who have more than the passenger role."""\n    if not can_switch_role(user):\n        vk.send_message(user.vk_id, "У вас только роль пассажира.", keyboard=kb.passenger_menu(False))\n        return set_state(session, user.vk_id, States.MAIN_MENU)\n    vk.send_message(\n        user.vk_id,\n        "Выберите роль:",\n        keyboard=kb.role_choice_keyboard(user.roles_list()),\n    )\n    set_state(session, user.vk_id, States.CHOOSING_ROLE)\n\n\ndef do_role_set(session: Session, user: User, role: str | None) -> None:\n    if not role or not user.has_role(role):\n        return show_role_choice(session, user)\n    # Leaving driver mode while online -> step out of the queue cleanly.\n    if user.role == ROLE_DRIVER and role != ROLE_DRIVER and user.driver_status != "offline":\n        # Use the same safe departure path so a selected-driver offer is\n        # cancelled instead of leaking into the ordinary FIFO queue.\n        driver_go_offline(session, user)\n    user.role = role\n    show_main_menu(session, user)\n\n\ndef show_main_menu(session: Session, user: User) -> None:\n    switch = can_switch_role(user)\n    if user.role == ROLE_ADMIN:\n        vk.send_message(user.vk_id, "🛠 Меню администратора:", keyboard=kb.admin_menu(switch))\n        set_state(session, user.vk_id, States.ADM_MENU)\n    elif user.role == ROLE_DISPATCHER:\n        vk.send_message(user.vk_id, "📋 Меню диспетчера:", keyboard=kb.dispatcher_menu(switch))\n        set_state(session, user.vk_id, States.DISP_MENU)\n    elif user.role == ROLE_DRIVER:\n        if user.driver_gender not in ("male", "female"):\n            return driver_gender_prompt(session, user, return_to="menu")\n        on_line = user.driver_status in ("online", "busy")\n        has_bookings = booking_service.has_taken_driver_bookings(session, user)\n        if user.driver_status == "away":\n            vk.send_message(\n                user.vk_id,\n                "☕ Вы отлучились.",\n                keyboard=kb.driver_away_menu(switch, has_taken_bookings=has_bookings),\n            )\n        else:\n            vk.send_message(\n                user.vk_id,\n                "🚗 Меню водителя:",\n                keyboard=kb.driver_menu(on_line, switch, has_taken_bookings=has_bookings),\n            )\n        set_state(session, user.vk_id, States.D_MENU)\n    else:\n        labels = _passenger_labels(session)\n        has_booking = booking_service.has_active_passenger_booking(session, user)\n        vk.send_message(\n            user.vk_id,\n            "🏠 Главное меню:",\n            keyboard=kb.passenger_menu(switch, labels, has_booking=has_booking),\n        )\n        set_state(session, user.vk_id, States.MAIN_MENU)\n\n\n# --------------------------------------------------------------------------- #\n#  Driver list views (shared by passengers & dispatchers)                      #\n# --------------------------------------------------------------------------- #\ndef _driver_line(user: User, with_status: bool = False) -> str:\n    car = user.car_full\n    line = f"• {user.full_name or (\'id\' + str(user.vk_id))} — {format_rating(user)}"\n    if car and car != "\\u2014":\n        line += f"\\n   🚗 {car}"\n    if with_status:\n        line += f"\\n   {status_label(user.driver_status)}"\n    return line\n\n\nDIRECT_DRIVER_TEXT_TIMEOUT = 90\nDIRECT_DRIVER_PAGE_SIZE = 30\n\n\n_DISPLAY_ACTIVE_ORDER_STATUSES = ("assigned", "arrived", "in_progress", "parallel_assigned")\n_DISPLAY_CITY_PATTERNS = {\n    "Пашия": r"паши(?:я|и|ю)",\n    "Кусья": r"кусь(?:я|и|ю)",\n    "Чусовой": r"(?:чус(?:а)?|чусов(?:ой|ого|ом|ому))",\n    "Тёплая гора": r"т[её]пл(?:ая|ой|ую)\\s+гор(?:а|ы|у|е)",\n    "Сараны": r"саран(?:ы|ов|ам|ах)",\n    "Койва": r"койв(?:а|ы|у|е|ой)",\n    "Подхоз": r"подхоз(?:а|у|е|ом)?",\n    "Дачи": r"дач(?:и|ах|ам|ами)?",\n}\n_DISPLAY_ORIGIN_LABELS = {\n    "Пашия": "из Пашии",\n    "Кусья": "из Кусьи",\n    "Чусовой": "из Чусового",\n    "Сараны": "из Саранов",\n    "Тёплая гора": "из Тёплой горы",\n    "Койва": "из Койвы",\n    "Подхоз": "из Подхоза",\n    "Дачи": "из Дач",\n}\n_DISPLAY_DESTINATION_LABELS = {\n    "Пашия": "до Пашии",\n    "Кусья": "до Кусьи",\n    "Чусовой": "до Чусового",\n    "Сараны": "до Саранов",\n    "Тёплая гора": "до Тёплой горы",\n    "Койва": "до Койвы",\n    "Подхоз": "до Подхоза",\n    "Дачи": "до Дач",\n}\n\n\ndef _without_station_pashiya(text: str | None) -> str:\n    """Do not confuse the Gornozavodsk railway station with Pashiya village."""\n    return re.sub(\n        r"\\b(?:ст\\.?|станци(?:я|и))\\s+паши(?:я|и|ю)\\b",\n        " ",\n        (text or "").casefold(),\n    )\n\n\ndef _display_city_in(text: str | None) -> str | None:\n    value = _without_station_pashiya(text)\n    for city, pattern in _DISPLAY_CITY_PATTERNS.items():\n        if re.search(rf"\\b{pattern}\\b", value):\n            return city\n    return None\n\n\ndef _display_origin_city(text: str | None, *, anywhere: bool = False) -> str | None:\n    """Recognize «из/с» and a locality beginning at word one or two."""\n    value = _without_station_pashiya(text)\n    for city, pattern in _DISPLAY_CITY_PATTERNS.items():\n        if re.search(rf"\\b(?:из|с)\\s+{pattern}\\b", value):\n            return city\n    if anywhere:\n        return _display_city_in(value)\n    for city, pattern in _DISPLAY_CITY_PATTERNS.items():\n        match = re.search(rf"\\b{pattern}\\b", value)\n        if match and len(re.findall(r"[а-яё]+", value[:match.start()])) <= 1:\n            return city\n    return None\n\n\ndef _display_route_direction(order: Order | None) -> tuple[str | None, str | None]:\n    """Return (origin, destination) for the compact driver-status display.\n\n    A dash or «до» divides the route into departure and destination parts.\n    Explicit «из/с» and a village in word one or two also identify departure.\n    This is display-only and deliberately does not alter dispatch routing.\n    """\n    if order is None:\n        return None, None\n    route = (order.route_text or "").strip()\n    if not route:\n        route = f"{order.address_from or \'\'} - {order.address_to or \'\'}"\n\n    origin = destination = None\n    dash = re.search(r"[-–—]", route)\n    if dash:\n        before, after = route[:dash.start()], route[dash.end():]\n        origin = _display_origin_city(before, anywhere=True)\n        destination = _display_city_in(after)\n    else:\n        divider = re.search(r"\\bдо\\b", route, re.IGNORECASE)\n        if divider:\n            before, after = route[:divider.start()], route[divider.end():]\n            # A village written before «до» is the departure point.\n            origin = _display_origin_city(before, anywhere=True)\n            destination = _display_city_in(after)\n        else:\n            origin = _display_origin_city(route)\n\n    # Structured address fields are useful for legacy orders whose route_text\n    # contains only one half of the route.\n    if origin is None:\n        origin = _display_origin_city(order.address_from)\n    if destination is None and (\n        not order.route_text or order.address_to != order.route_text\n    ):\n        destination = _display_city_in(order.address_to)\n    if origin == destination:\n        # An explicit destination wins over a weaker first-two-word guess.\n        origin = None\n    return origin, destination\n\n\ndef _active_orders_by_driver(session: Session, driver_ids: list[int]) -> dict[int, Order]:\n    """Load the newest active ride per ordinary or parallel driver."""\n    if not driver_ids:\n        return {}\n    result: dict[int, Order] = {}\n    ordinary = (\n        session.query(Order)\n        .filter(\n            Order.driver_id.in_(driver_ids),\n            Order.status.in_(_DISPLAY_ACTIVE_ORDER_STATUSES),\n        )\n        .order_by(Order.created_at.desc())\n        .all()\n    )\n    for order in ordinary:\n        if order.driver_id is not None:\n            result.setdefault(order.driver_id, order)\n    parallel = (\n        session.query(Order)\n        .filter(\n            Order.parallel_driver_id.in_(driver_ids),\n            Order.status.in_(_DISPLAY_ACTIVE_ORDER_STATUSES),\n        )\n        .order_by(Order.created_at.desc())\n        .all()\n    )\n    for order in parallel:\n        if order.parallel_driver_id is not None:\n            result.setdefault(order.parallel_driver_id, order)\n    return result\n\n\ndef _dispatcher_passenger_details(\n    session: Session,\n    active_orders: dict[int, Order],\n) -> dict[int, tuple[str, int]]:\n    """Build passenger labels for the dispatcher-only driver queue.\n\n    Ordinary passenger names are VK mention links. Dispatcher-created orders\n    have no separate VK passenger account, so their entered customer name is\n    shown as plain text instead.\n    """\n    passenger_ids = {\n        order.passenger_id\n        for order in active_orders.values()\n        if order.passenger_id and not _is_dispatcher_order(order)\n    }\n    passengers = {\n        passenger.id: passenger\n        for passenger in (\n            session.query(User).filter(User.id.in_(passenger_ids)).all()\n            if passenger_ids else []\n        )\n    }\n    result: dict[int, tuple[str, int]] = {}\n    for driver_id, order in active_orders.items():\n        if _is_dispatcher_order(order):\n            label = (order.customer_name or "клиент диспетчера").strip()\n        else:\n            passenger = passengers.get(order.passenger_id)\n            label = _vk_label(passenger) if passenger else "пассажир"\n        result[driver_id] = (label, order.number)\n    return result\n\n\ndef _render_driver_statuses(\n    items: list[dict],\n    current_driver_id: int | None = None,\n    *,\n    numbered: bool = False,\n    show_rating: bool = True,\n    show_passenger_details: bool = False,\n    group_free_by_line: bool = False,\n) -> list[str]:\n    """Render queue rows; passenger details are dispatcher-only."""\n    order_weight = {"online": 0, "considering": 1, "away": 2, "busy": 3}\n    items = sorted(\n        items,\n        key=lambda item: (order_weight.get(item["status"], 9), item.get("position", 0)),\n    )\n    if group_free_by_line:\n        # Each free line is a separate FIFO, not a global position shared\n        # with busy/away drivers. Canonical names come from DriverQueue.city_id.\n        groups: dict[str, list[dict]] = {}\n        for item in items:\n            if item["status"] == "online":\n                location = item.get("line_name") or item["driver"].current_line or "Линия не указана"\n                groups.setdefault(location, []).append(item)\n        result: list[str] = []\n        for location in sorted(groups, key=lambda name: (name != "Горнозаводск", name.casefold())):\n            if result:\n                result.append("")\n            for rank, item in enumerate(groups[location], 1):\n                driver = item["driver"]\n                name = driver.full_name or ("id" + str(driver.vk_id))\n                if driver.id == current_driver_id:\n                    name += " (вы)"\n                rating = f" — {format_rating(driver)}" if show_rating else ""\n                prefix = f"{rank}. " if numbered else ""\n                result.append(f"{prefix}🟢 {name} — свободен — {location}{rating}")\n        other = [item for item in items if item["status"] != "online"]\n        if other:\n            if result:\n                result.append("")\n            result.append("Другие статусы:")\n            result.extend(_render_driver_statuses(\n                other, current_driver_id, numbered=False,\n                show_rating=show_rating,\n                show_passenger_details=show_passenger_details,\n            ))\n        return result\n    regular: list[str] = []\n    origin_labels = _DISPLAY_ORIGIN_LABELS\n    destination_labels = _DISPLAY_DESTINATION_LABELS\n    to_city: dict[str, list[str]] = {\n        city: [] for city in destination_labels\n    }\n\n    for item in items:\n        driver = item["driver"]\n        name = driver.full_name or ("id" + str(driver.vk_id))\n        if driver.id == current_driver_id:\n            name += " (вы)"\n        rating = f" — {format_rating(driver)}" if show_rating else ""\n        status = item["status"]\n        if status == "online":\n            location = driver.current_line or "Локация не указана"\n            regular.append(f"🟢 {name} — свободен — {location}{rating}")\n            continue\n        if status == "away":\n            regular.append(f"🟡 {name} — отлучился{rating}")\n            continue\n        if status == "considering":\n            regular.append(f"🟠 {name} — рассматривает заявку{rating}")\n            continue\n\n        origin, destination = _display_route_direction(item.get("order"))\n\n        if show_passenger_details:\n            passenger_label = item.get("passenger_label")\n            order_id = item.get("order_id")\n            if passenger_label and order_id:\n                route_label = (\n                    destination_labels.get(destination)\n                    or origin_labels.get(origin)\n                )\n                route_suffix = f" — {route_label}" if route_label else ""\n                regular.append(\n                    f"🔴 {name} — на заявке — {passenger_label}, "\n                    f"заявка #{order_id}{route_suffix}{rating}"\n                )\n                continue\n\n        if destination in to_city:\n            to_city[destination].append(\n                f"🔴 {name} — на заявке — {destination_labels[destination]}{rating}"\n            )\n            continue\n        location = origin_labels.get(origin) or driver.current_line or "Локация не указана"\n        regular.append(f"🔴 {name} — на заявке — {location}{rating}")\n\n    result = regular\n    for city in destination_labels:\n        if not to_city[city]:\n            continue\n        if result:\n            result.append("")\n        result.append(f"На заявке {destination_labels[city]}:")\n        result.extend(to_city[city])\n    if numbered:\n        number = 0\n        numbered_result = []\n        for line in result:\n            if line.startswith(("🟢", "🟠", "🟡", "🔴")):\n                number += 1\n                line = f"{number}. {line}"\n            numbered_result.append(line)\n        result = numbered_result\n    return result\n\n\ndef _render_passenger_driver_statuses(items: list[dict]) -> list[str]:\n    """Passenger view: other free lines at the bottom, blank-line groups only.\n\n    This is presentation only. Preserve the shared status/route/rating renderer\n    and the input FIFO order inside each line; do not change dispatch or the\n    separate numbered driver/dispatcher queue.\n    """\n    main: list[dict] = []\n    groups: dict[str, list[dict]] = {}\n    for item in items:\n        driver = item["driver"]\n        location = (item.get("line_name") or driver.current_line or "").strip()\n        line_key = location.casefold()\n        if item["status"] == "online" and line_key and line_key != "горнозаводск":\n            groups.setdefault(line_key, []).append(item)\n        else:\n            # All non-free statuses stay above the other-line free groups.\n            # A missing line is not guessed to be a village line.\n            main.append(item)\n    result = _render_driver_statuses(main)\n    preferred = {name: index for index, name in enumerate(\n        ("пашия", "кусья", "чусовой", "сараны")\n    )}\n    for line_key in sorted(groups, key=lambda name: (preferred.get(name, len(preferred)), name)):\n        rows = _render_driver_statuses(groups[line_key])\n        if not rows:\n            continue\n        if result:\n            result.append("")\n        result.extend(rows)\n    return result\n\n\ndef _show_driver_status_overview(session: Session, user: User) -> None:\n    """Passenger list with the same statuses and route directions as the queue."""\n    drivers = queue_service.all_drivers(session)\n    statuses = queue_service.actual_driver_statuses(session, drivers)\n    # Keep «Свободен» and «Выбор водителя» in exact parity: every passenger-\n    # visible free driver must have a working selection button.\n    selectable_ids = {driver.id for driver in _direct_driver_candidates(session)}\n    free = [\n        driver for driver in drivers\n        if statuses.get(driver.id) == "online" and driver.id in selectable_ids\n    ]\n    considering = [driver for driver in drivers if statuses.get(driver.id) == "considering"]\n    busy = [driver for driver in drivers if statuses.get(driver.id) == "busy"]\n    away = [driver for driver in drivers if statuses.get(driver.id) == "away"]\n    visible = free + considering + busy + away\n    active_orders = _active_orders_by_driver(session, [driver.id for driver in visible])\n    items = []\n    for index, driver in enumerate(visible):\n        driver_status = statuses.get(driver.id)\n        if driver_status == "away":\n            status = "Отлучился"\n            display_status = "away"\n        elif driver_status == "considering":\n            status = "Рассматривает заявку"\n            display_status = "considering"\n        elif driver_status == "busy":\n            status = "На заявке"\n            display_status = "busy"\n        else:\n            status = "Свободен"\n            display_status = "online"\n        items.append({\n            "driver": driver,\n            "status": display_status,\n            "status_text": status,\n            "order": active_orders.get(driver.id),\n            "position": index,\n        })\n    lines = ["🚗 Водители сейчас:", ""]\n    lines.extend(_render_passenger_driver_statuses(items))\n    if not visible:\n        lines.append("Свободных, занятых и отлучившихся водителей сейчас нет.")\n    active = active_order_for(session, user)\n    entering_order = get_state(session, user.vk_id).state == States.P_ADDR\n    if active and active.status == "arrived":\n        keyboard = kb.passenger_arrived_keyboard(active.id)\n    elif active and active.status == "in_progress":\n        keyboard = kb.passenger_in_ride_keyboard(active.id)\n    elif active and (active.arrival_eta or active.parallel_eta):\n        keyboard = kb.passenger_ride_keyboard(active.id)\n    elif active and active.driver_id:\n        keyboard = kb.passenger_assigned_keyboard(active.id)\n    elif active:\n        keyboard = kb.passenger_waiting_keyboard(active.id)\n    elif entering_order:\n        keyboard = kb.passenger_order_entry_keyboard()\n    else:\n        keyboard = kb.passenger_menu(can_switch_role(user), _passenger_labels(session))\n    vk.send_message(user.vk_id, "\\n".join(lines), keyboard=keyboard)\n\n\ndef show_free_drivers(session: Session, user: User) -> None:\n    """Show passenger-visible statuses and directions without replacing the menu."""\n    state = get_state(session, user.vk_id).state\n    if active_order_for(session, user) or state not in (\n        States.MAIN_MENU, States.P_DRIVER_SELECT,\n    ):\n        return _show_driver_status_overview(session, user)\n    drivers = queue_service.all_drivers(session)\n    statuses = queue_service.actual_driver_statuses(session, drivers)\n    selectable_ids = {driver.id for driver in _direct_driver_candidates(session)}\n    free = [\n        driver for driver in drivers\n        if statuses.get(driver.id) == "online" and driver.id in selectable_ids\n    ]\n    considering = [driver for driver in drivers if statuses.get(driver.id) == "considering"]\n    busy = [driver for driver in drivers if statuses.get(driver.id) == "busy"]\n    away = [driver for driver in drivers if statuses.get(driver.id) == "away"]\n    visible = free + considering + busy + away\n    active_orders = _active_orders_by_driver(session, [driver.id for driver in visible])\n    items = []\n    for index, driver in enumerate(visible):\n        driver_status = statuses.get(driver.id)\n        if driver_status == "away":\n            status = "Отлучился"\n            display_status = "away"\n        elif driver_status == "considering":\n            status = "Рассматривает заявку"\n            display_status = "considering"\n        elif driver_status == "busy":\n            status = "На заявке"\n            display_status = "busy"\n        else:\n            status = "Свободен"\n            display_status = "online"\n        items.append({\n            "driver": driver,\n            "status": display_status,\n            "status_text": status,\n            "order": active_orders.get(driver.id),\n            "position": index,\n        })\n    text_lines = ["🚗 Водители сейчас:", ""]\n    text_lines.extend(_render_passenger_driver_statuses(items))\n    if not visible:\n        text_lines.append("Свободных, занятых и отлучившихся водителей сейчас нет.")\n    has_booking = booking_service.has_active_passenger_booking(session, user)\n    vk.send_message(\n        user.vk_id,\n        "\\n".join(text_lines),\n        keyboard=kb.passenger_menu(\n            can_switch_role(user),\n            _passenger_labels(session),\n            has_booking=has_booking,\n        ),\n    )\n\n\ndef _direct_driver_candidates(session: Session) -> list[User]:\n    """Only genuinely free drivers may appear in the direct-selection menu."""\n    return [\n        driver for driver in queue_service.free_drivers(session)\n        if driver.is_on_line\n        and driver.driver_status == "online"\n        and lines.has_complete_car(driver)\n    ]\n\n\ndef show_direct_driver_choices(session: Session, user: User, page=1) -> None:\n    if active_order_for(session, user):\n        return _menu_lock_notice(session, user)\n    _close_direct_driver_choice_menu(session, user)\n    excluded = blacklist_service.excluded_driver_ids(session, user.id)\n    drivers = [driver for driver in _direct_driver_candidates(session) if driver.id not in excluded]\n    visible = drivers[:DIRECT_DRIVER_PAGE_SIZE]\n    if visible:\n        text_lines = ["👤 Выбор водителя:", ""]\n        for driver in visible:\n            name = driver.full_name or ("id" + str(driver.vk_id))\n            line_name = (driver.current_line or "Линия не указана").strip()\n            text_lines.append(f"• {name} — линия: {line_name}")\n        if len(drivers) > DIRECT_DRIVER_PAGE_SIZE:\n            text_lines.extend(("", "Показаны первые 30 свободных водителей."))\n        text_lines.extend(("", "Нажмите кнопку с именем нужного водителя под сообщением."))\n        text = "\\n".join(text_lines)\n    else:\n        text = "Сейчас нет водителей со статусом «Свободен». Обновите список немного позже."\n    set_state(session, user.vk_id, States.P_DRIVER_SELECT, {}, merge=False)\n    if visible:\n        menu_outbox_id = vk.send_tracked_message(\n            user.vk_id,\n            text,\n            keyboard=kb.free_driver_choices_keyboard(visible),\n        )\n        set_state(\n            session,\n            user.vk_id,\n            States.P_DRIVER_SELECT,\n            {"selection_menu_outbox_id": menu_outbox_id},\n            merge=False,\n        )\n    else:\n        vk.send_message(user.vk_id, text)\n    vk.send_message(\n        user.vk_id,\n        "Управление списком:",\n        keyboard=kb.direct_driver_controls_keyboard(),\n    )\n\n\ndef _close_direct_driver_choice_menu(session: Session, user: User) -> None:\n    """Remove buttons from the last inline driver list without changing text."""\n    outbox_id = get_data(session, user.vk_id).get("selection_menu_outbox_id")\n    if not outbox_id:\n        return\n    from . import outbox_service\n\n    outbox_service.finalize_tracked_message(session, outbox_id, "")\n\n\ndef _release_direct_selection(session: Session, selection: DriverSelection) -> None:\n    """Release exactly this pre-order hold without touching a later real offer."""\n    timers.cancel("direct_selection", selection.id)\n    entry = (\n        session.query(DriverQueue)\n        .filter(DriverQueue.driver_id == selection.driver_id)\n        .with_for_update()\n        .one_or_none()\n    )\n    live_offer = session.query(Order.id).filter(\n        Order.offered_driver_id == selection.driver_id,\n        Order.status == "searching",\n    ).first()\n    if entry and entry.status == "offered" and not live_offer:\n        entry.status = "waiting"\n    session.delete(selection)\n\n\ndef cancel_direct_driver_selection(\n    session: Session,\n    user: User,\n    *,\n    notify_passenger: bool = True,\n    notify_driver: bool = True,\n) -> bool:\n    selection = (\n        session.query(DriverSelection)\n        .filter(DriverSelection.passenger_id == user.id)\n        .with_for_update()\n        .one_or_none()\n    )\n    if not selection:\n        return False\n    driver = session.get(User, selection.driver_id)\n    _release_direct_selection(session, selection)\n    reset(session, user.vk_id, States.MAIN_MENU)\n    if notify_passenger:\n        vk.send_message(\n            user.vk_id,\n            "Выбор водителя отменён.",\n            keyboard=kb.passenger_menu(can_switch_role(user), _passenger_labels(session)),\n        )\n    if notify_driver and driver:\n        vk.send_message(driver.vk_id, "Пассажир отменил выбор до отправки заявки.")\n    passenger_queue.try_promote(session)\n    return True\n\n\ndef cancel_direct_selection_for_driver(session: Session, driver: User) -> bool:\n    """Cancel the pre-text hold if the selected driver leaves or changes role."""\n    selection = (\n        session.query(DriverSelection)\n        .filter(DriverSelection.driver_id == driver.id)\n        .with_for_update()\n        .one_or_none()\n    )\n    if not selection:\n        return False\n    passenger = session.get(User, selection.passenger_id)\n    selection_id = selection.id\n    _release_direct_selection(session, selection)\n    if passenger:\n        data = get_data(session, passenger.vk_id)\n        if data.get("selection_id") == selection_id:\n            reset(session, passenger.vk_id, States.MAIN_MENU)\n        vk.send_message(\n            passenger.vk_id,\n            "Выбранный водитель больше не свободен. Выберите другого водителя.",\n            keyboard=kb.direct_driver_unavailable_keyboard(),\n        )\n    passenger_queue.try_promote(session)\n    return True\n\n\ndef select_direct_driver(session: Session, user: User, driver_id) -> None:\n    if active_order_for(session, user):\n        return _menu_lock_notice(session, user)\n    ban_msg = _order_ban_message(user)\n    if ban_msg:\n        return vk.send_message(\n            user.vk_id, ban_msg,\n            keyboard=kb.passenger_menu(can_switch_role(user), _passenger_labels(session)),\n        )\n    if _passenger_order_limit_reached(session, user):\n        return vk.send_message(\n            user.vk_id,\n            "За 15 минут можно создать не более 5 заявок. Попробуйте позже.",\n            keyboard=kb.passenger_menu(can_switch_role(user), _passenger_labels(session)),\n        )\n    try:\n        driver_id = int(driver_id)\n    except (TypeError, ValueError):\n        return show_direct_driver_choices(session, user, 1)\n\n    old = (\n        session.query(DriverSelection)\n        .filter(DriverSelection.passenger_id == user.id)\n        .with_for_update()\n        .one_or_none()\n    )\n    if old:\n        _release_direct_selection(session, old)\n        session.flush()\n\n    entry = (\n        session.query(DriverQueue)\n        .filter(DriverQueue.driver_id == driver_id)\n        .with_for_update()\n        .one_or_none()\n    )\n    driver = session.get(User, driver_id)\n    available = bool(\n        entry and entry.status == "waiting"\n        and driver and driver.has_role(ROLE_DRIVER)\n        and not blacklist_service.blocks(session, driver.id, user.id)\n        and driver.is_on_line and driver.driver_status == "online"\n        and not driver.is_blocked and lines.has_complete_car(driver)\n        and not active_order_for(session, driver, as_driver=True)\n        and not offered_order_for(session, driver)\n    )\n    if not available:\n        vk.send_message(user.vk_id, "Этот водитель уже не свободен. Список обновлён.")\n        return show_direct_driver_choices(session, user, 1)\n\n    _close_direct_driver_choice_menu(session, user)\n    entry.status = "offered"\n    selection = DriverSelection(\n        passenger_id=user.id,\n        driver_id=driver.id,\n        expires_at=time_utils.now() + dt.timedelta(seconds=DIRECT_DRIVER_TEXT_TIMEOUT),\n    )\n    session.add(selection)\n    session.flush()\n    set_state(\n        session,\n        user.vk_id,\n        States.P_DIRECT_TEXT,\n        {"selection_id": selection.id, "driver_id": driver.id},\n        merge=False,\n    )\n    timers.schedule(\n        "direct_selection",\n        selection.id,\n        DIRECT_DRIVER_TEXT_TIMEOUT,\n        lambda: direct_driver_selection_timeout(selection.id),\n    )\n    name = driver.full_name or ("id" + str(driver.vk_id))\n    vk.send_message(\n        user.vk_id,\n        f"Вы выбрали водителя: {name}.\\n\\n"\n        "Напишите текст заявки одним сообщением. На отправку даётся 90 секунд.",\n        keyboard=kb.direct_driver_text_keyboard(),\n    )\n    passenger_name = user.full_name or ("id" + str(user.vk_id))\n    vk.send_message(\n        driver.vk_id,\n        f"Вас выбрал пассажир {passenger_name}, заполняет заявку, ожидайте.",\n    )\n\n\ndef direct_driver_selection_timeout(selection_id: int) -> None:\n    from common.database import session_scope\n\n    with session_scope() as session:\n        selection = (\n            session.query(DriverSelection)\n            .filter(DriverSelection.id == selection_id)\n            .with_for_update()\n            .one_or_none()\n        )\n        if not selection:\n            return\n        passenger = session.get(User, selection.passenger_id)\n        driver = session.get(User, selection.driver_id)\n        _release_direct_selection(session, selection)\n        if passenger:\n            data = get_data(session, passenger.vk_id)\n            if data.get("selection_id") == selection_id:\n                reset(session, passenger.vk_id, States.MAIN_MENU)\n            vk.send_message(\n                passenger.vk_id,\n                "90 секунд истекли. Выбранный водитель снова доступен.",\n                keyboard=kb.direct_driver_unavailable_keyboard(),\n            )\n        if driver:\n            vk.send_message(driver.vk_id, "Пассажир не отправил заявку за 90 секунд. Вы снова свободны.")\n        passenger_queue.try_promote(session)\n\n\ndef direct_driver_submit_text(session: Session, user: User, text: str) -> None:\n    """Turn the 90-second hold into a normal order offered only to its driver."""\n    raw = " ".join((text or "").split())\n    if _is_not_order_text(session, raw):\n        return vk.send_message(\n            user.vk_id,\n            "Напишите полный текст заявки: откуда и куда нужно ехать.",\n            keyboard=kb.direct_driver_text_keyboard(),\n        )\n    data = get_data(session, user.vk_id)\n    selection_id = data.get("selection_id")\n    selection = (\n        session.query(DriverSelection)\n        .filter(\n            DriverSelection.id == selection_id,\n            DriverSelection.passenger_id == user.id,\n        )\n        .with_for_update()\n        .one_or_none()\n        if selection_id else None\n    )\n    if not selection or selection.expires_at <= time_utils.now():\n        requested_driver_id = data.get("driver_id")\n        try:\n            requested_driver_id = int(requested_driver_id)\n        except (TypeError, ValueError):\n            requested_driver_id = None\n        if _notice_existing_direct_order(session, user, requested_driver_id):\n            if selection:\n                _release_direct_selection(session, selection)\n            return\n        if selection:\n            _release_direct_selection(session, selection)\n        reset(session, user.vk_id, States.P_DRIVER_SELECT)\n        vk.send_message(\n            user.vk_id,\n            "Время выбора истекло или водитель уже недоступен.",\n            keyboard=kb.direct_driver_unavailable_keyboard(),\n        )\n        return\n    entry = (\n        session.query(DriverQueue)\n        .filter(DriverQueue.driver_id == selection.driver_id)\n        .with_for_update()\n        .one_or_none()\n    )\n    driver = session.get(User, selection.driver_id)\n    if (\n        not entry or entry.status not in ("offered", "waiting") or not driver\n        or not driver.is_on_line or driver.driver_status != "online"\n        or active_order_for(session, driver, as_driver=True)\n        or offered_order_for(session, driver)\n    ):\n        _release_direct_selection(session, selection)\n        reset(session, user.vk_id, States.P_DRIVER_SELECT)\n        vk.send_message(\n            user.vk_id,\n            "Выбранный водитель уже недоступен. Выберите другого.",\n            keyboard=kb.direct_driver_unavailable_keyboard(),\n        )\n        return\n    # A valid exclusive selection is authoritative even if legacy queue\n    # repair left its row marked waiting. Re-reserve under the row lock.\n    entry.status = "offered"\n    session.flush()\n    if re.search(r"(?<![а-яё])грузоперевозки(?![а-яё])", raw, re.IGNORECASE):\n        cancel_direct_driver_selection(\n            session, user, notify_passenger=False, notify_driver=True\n        )\n        return vk.send_message(\n            user.vk_id,\n            msg(session, "msg_freight_contact_dispatcher"),\n            keyboard=kb.passenger_menu(can_switch_role(user), _passenger_labels(session)),\n        )\n    draft = {\n        "order_type": "regular",\n        "requested_driver_id": driver.id,\n        "driver_selection_id": selection.id,\n    }\n    set_state(session, user.vk_id, States.P_ADDR, {"draft": draft}, merge=False)\n    return order_set_addresses(session, user, raw)\n\ndef show_all_drivers(session: Session, user: User) -> None:\n    """Dispatcher driver list is identical to the numbered driver queue."""\n    return show_queue(session, user, dispatcher_view=True)\n\n\n# --------------------------------------------------------------------------- #\n#  Passenger flow                                                              #\n# --------------------------------------------------------------------------- #\ndef handle_passenger(session, user, state, text, payload, attachments):\n    cmd = payload.get("cmd")\n\n    # Requirement 4: lock menu navigation while a passenger order is active.\n    if cmd in _PASSENGER_MENU_CMDS and _has_active_order(session, user):\n        return _menu_lock_notice(session, user)\n\n    if cmd == "cancel_flow":\n        if state == States.P_DIRECT_TEXT:\n            return cancel_direct_driver_selection(session, user)\n        reset(session, user.vk_id, States.MAIN_MENU)\n        return show_main_menu(session, user)\n    if cmd == "direct_driver_cancel":\n        if cancel_direct_driver_selection(session, user):\n            return\n        return show_main_menu(session, user)\n    if cmd == "driver_select_list":\n        if state not in (States.MAIN_MENU, States.P_DRIVER_SELECT):\n            return show_main_menu(session, user)\n        return show_direct_driver_choices(session, user, payload.get("page", 1))\n    if cmd == "driver_select":\n        if state != States.P_DRIVER_SELECT:\n            return show_main_menu(session, user)\n        return select_direct_driver(session, user, payload.get("driver_id"))\n    if cmd == "rules":\n        # Reuse the exact onboarding rules and keep both the current FSM state\n        # and the main passenger keyboard unchanged.\n        rules = get_cached(\n            session,\n            "community_rules",\n            "Правила сообщества пока не заполнены.",\n        ) or ""\n        has_booking = booking_service.has_active_passenger_booking(session, user)\n        return vk.send_message(\n            user.vk_id,\n            rules,\n            keyboard=kb.passenger_menu(\n                can_switch_role(user),\n                _passenger_labels(session),\n                has_booking=has_booking,\n            ),\n        )\n    if cmd == "booking_start":\n        return passenger_booking_start(session, user)\n    if cmd == "booking_fill":\n        return passenger_booking_fill(session, user)\n    if cmd == "booking_back":\n        reset(session, user.vk_id, States.MAIN_MENU)\n        return show_main_menu(session, user)\n    if cmd == "booking_type":\n        return passenger_booking_type(session, user, payload.get("type"))\n    if cmd == "booking_date_quick":\n        return passenger_booking_date_quick(session, user, payload.get("days"))\n    if cmd == "booking_date_custom":\n        return passenger_booking_date_custom(session, user)\n    if cmd == "booking_comment_skip":\n        return passenger_booking_comment(session, user, "")\n    if cmd == "booking_confirm":\n        return passenger_booking_confirm(session, user)\n    if cmd == "my_booking":\n        return passenger_show_booking(session, user)\n    if cmd == "booking_cancel":\n        return passenger_cancel_booking(session, user, payload.get("booking_id"))\n    if cmd == "departure_wait":\n        return passenger_departure_response(\n            session, user, cancel=False, order_id=payload.get("order_id")\n        )\n    if cmd == "departure_cancel":\n        return passenger_departure_response(\n            session, user, cancel=True, order_id=payload.get("order_id")\n        )\n    if cmd == "chat_order_actual_yes":\n        return passenger_chat_order_actual(session, user, payload.get("order_id"), True)\n    if cmd == "chat_order_actual_no":\n        return passenger_chat_order_actual(session, user, payload.get("order_id"), False)\n    if cmd == "chat_add":\n        return enter_chat(session, user, driver=False)\n    if cmd == "chat_stop":\n        return exit_chat(session, user, driver=False)\n    if cmd == "review_comment_add":\n        return passenger_review_comment_prompt(session, user)\n    if cmd == "review_comment_skip":\n        return save_review_text(session, user, "")\n    if cmd == "review_rating_change" and state == States.P_REVIEW_TEXT:\n        return passenger_review_rating_change(session, user, payload.get("review_id"))\n    if cmd == "review_rating_set" and state == States.P_REVIEW_TEXT:\n        return passenger_review_rating_set(\n            session, user, payload.get("review_id"), payload.get("stars")\n        )\n    if cmd == "going_out":\n        return passenger_arrived_reply(\n            session, user, "going_out", payload.get("order_id")\n        )\n    if cmd == "wait_more":\n        return passenger_arrived_reply(\n            session, user, "wait_more", payload.get("order_id")\n        )\n    if cmd == "new_order":\n        return start_new_order(session, user)\n    if cmd == "drivers":\n        return show_free_drivers(session, user)\n    if cmd == "history":\n        return show_passenger_history(session, user)\n    if cmd == "price":\n        return show_price(session, user)\n    if cmd == "price_section":\n        return show_price_section(session, user, payload.get("key"))\n    if cmd == "price_calculate":\n        return retired_price_calculator(session, user)\n    if cmd == "price_back":\n        return show_main_menu(session, user)\n    if cmd == "support":\n        return show_support(session, user)\n    if cmd == "my_reviews":\n        return show_passenger_reviews(session, user)\n    if cmd == "wait_join_yes":\n        return passenger_queue.wait_choice(session, user, True)\n    if cmd == "wait_join_no":\n        return passenger_queue.wait_choice(session, user, False)\n    if cmd == "queue_yes":\n        return passenger_queue.confirm(session, user, payload.get("order_id"), True)\n    if cmd == "queue_no":\n        return passenger_queue.confirm(session, user, payload.get("order_id"), False)\n    if cmd == "order_status":\n        return passenger_order_status(session, user, payload.get("order_id"))\n    if cmd == "driver_wait_remaining":\n        return passenger_driver_wait_remaining(session, user, payload.get("order_id"))\n    if cmd == "cancel_confirm_yes":\n        return passenger_cancel(session, user, payload.get("order_id"))\n    if cmd == "cancel_confirm_no":\n        order = passenger_order_for(session, user, payload.get("order_id"))\n        return vk.send_message(\n            user.vk_id,\n            "Поездка продолжается.",\n            keyboard=(\n                kb.passenger_in_ride_keyboard(order.id)\n                if order and order.status == "in_progress"\n                else kb.passenger_ride_keyboard(order.id) if order else None\n            ),\n        ) if order else show_main_menu(session, user)\n    if cmd == "pick_city":\n        return set_order_city(session, user, payload["city_id"])\n    if cmd == "repeat":\n        return repeat_order(session, user, payload["order_id"])\n    if cmd == "set_order_type":\n        return choose_order_type(session, user, payload.get("type", "regular"))\n    if cmd == "edit_order":\n        return start_edit_order(session, user)\n    if cmd == "toggle_service" and state == States.P_BOOKING_EXTRAS:\n        return passenger_booking_toggle_extra(session, user, payload.get("service"))\n    if cmd == "extras_done" and state == States.P_BOOKING_EXTRAS:\n        return passenger_booking_extras_done(session, user)\n    if cmd == "toggle_service":\n        return toggle_extra_service(session, user, payload.get("service"))\n    if cmd == "extras_done":\n        return finish_extras(session, user)\n    if cmd == "confirm_order":\n        draft = get_data(session, user.vk_id).get("draft", {})\n        return create_passenger_order(session, user, draft.get("order_type", "regular"))\n    if cmd == "delivery_agree":\n        return delivery_service.passenger_response(session, user, payload.get("order_id"), True)\n    if cmd == "delivery_decline":\n        return delivery_service.passenger_response(session, user, payload.get("order_id"), False)\n    if cmd == "customer_price_agree":\n        return customer_price_service.passenger_response(\n            session, user, payload.get("order_id"), True\n        )\n    if cmd == "customer_price_decline":\n        return customer_price_service.passenger_response(\n            session, user, payload.get("order_id"), False\n        )\n    if cmd == "customer_price_edit":\n        return customer_price_service.start_passenger_price_edit(\n            session, user, payload.get("order_id")\n        )\n    if cmd == "customer_price_wait":\n        return customer_price_service.wait_for_first_driver(\n            session, user, payload.get("order_id")\n        )\n    if cmd == "fake_pay":\n        return fake_calls_service.passenger_ready_to_pay(session, user)\n    if cmd in ("cancel_order", "cancel_ride"):\n        return passenger_cancel_request(session, user, payload.get("order_id"))\n    if cmd == "chat":\n        return enter_chat(\n            session, user, driver=False, order_id=payload.get("order_id")\n        )\n    if cmd == "exit_chat":\n        return exit_chat(session, user, driver=False)\n    if cmd == "rate":\n        return save_rating(session, user, payload["order_id"], payload["stars"])\n    if cmd == "skip_rate":\n        return passenger_skip_rating(session, user, payload.get("order_id"))\n    if cmd == "skip" and state == States.P_COMMENT:\n        return order_set_comment(session, user, "")\n    if cmd == "skip_comment":\n        return delivery_set_comment(session, user, "-")\n\n    # State-driven text input\n    if state == States.P_DIRECT_TEXT:\n        return direct_driver_submit_text(session, user, text)\n    if state == States.P_CUSTOM_PRICE_EDIT and not cmd:\n        return customer_price_service.submit_passenger_price_edit(\n            session, user, text\n        )\n    if state == States.P_ADDR:\n        voice_attachment = vk.voice_attachment_reference(attachments)\n        if voice_attachment:\n            return order_set_voice(session, user, voice_attachment)\n        return order_set_addresses(session, user, text)\n    if state == States.P_FROM:\n        return order_set_from(session, user, text)\n    if state == States.P_TO:\n        return order_set_to(session, user, text)\n    if state == States.P_COMMENT:\n        return order_set_comment(session, user, text)\n    if state == States.P_DELIVERY_FROM:\n        return delivery_set_from(session, user, text)\n    if state == States.P_DELIVERY_TO:\n        return delivery_set_to(session, user, text)\n    if state == States.P_DELIVERY_WHAT:\n        return delivery_set_what(session, user, text)\n    if state == States.P_DELIVERY_COMMENT:\n        return delivery_set_comment(session, user, text)\n    if state == States.P_ARRIVED:\n        return chat_forward(session, user, text, attachments, driver=False)\n    if state == States.P_NEW_ADDRESS:\n        return passenger_update_address(session, user, text)\n    if state == States.P_CHAT:\n        return chat_forward(session, user, text, attachments, driver=False)\n    if state == States.P_REVIEW_TEXT:\n        return save_review_text(session, user, text)\n    if state == States.P_BOOKING_TIME:\n        return passenger_booking_time(session, user, text)\n    if state == States.P_BOOKING_DATE:\n        return passenger_booking_date_input(session, user, text)\n    if state == States.P_BOOKING_ADDRESS:\n        return passenger_booking_address(session, user, text)\n    if state == States.P_BOOKING_COMMENT:\n        return passenger_booking_comment(session, user, text)\n    if state == "passenger_price_calc_route":\n        return retired_price_calculator(session, user)\n\n    active = active_order_for(session, user)\n    if active and (active.driver_id or active.parallel_driver_id) and (text or attachments):\n        # If an active ride already has a driver, free text is always treated\n        # as an in-bot chat message. This also recovers gracefully if the chat\n        # FSM state was overwritten by another informational message.\n        return chat_forward(session, user, text, attachments, driver=False)\n    if active:\n        vk.send_message(user.vk_id, "Во время активной заявки используйте кнопки. Текстовое сообщение не изменило состояние заявки.", keyboard=kb.passenger_waiting_keyboard())\n        return\n    if not cmd and (text or "").strip():\n        return passenger_text_order(session, user, text)\n    return show_main_menu(session, user)\n\n\nTEXT_ORDER_MIN_LENGTH = 5\n\nTWO_CAR_REQUEST_RE = re.compile(\n    r"(?<![а-яё0-9])(?:2|две|два)\\s+"\n    r"(?:машин(?:а|ы|ки)?|автомобил(?:я|ей)|авто)(?![а-яё])",\n    re.IGNORECASE,\n)\n\n\ndef requested_car_count(text: str | None) -> int:\n    """Return two only for an explicit request for two cars."""\n    return 2 if TWO_CAR_REQUEST_RE.search(text or "") else 1\n\n# Short courtesy replies must open the menu, not create a request.\nTEXT_ORDER_STOP_WORDS = frozenset({\n    "ок", "окей", "ok", "okay", "хорошо", "да", "нет", "ага", "угу",\n    "спс", "спасибо", "пасиб", "благодарю", "привет", "здравствуйте",\n    "здравствуй", "добрый день", "доброе утро", "добрый вечер",\n    "доброй ночи", "пока", "до свидания", "алло", "ало", "тут", "здесь",\n    "жду", "ждем", "ждём", "понял", "поняла", "ясно", "хм", "где",\n    "когда", "сколько", "а", "эй", "test", "тест", "проверка",\n    # реакция на цену\n    "дорого", "дорога", "дороговато", "это дорого", "очень дорого",\n    "дорого так", "что так дорого", "почему так дорого",\n    "дёшевле можно", "дешевле можно",\n    # вопросы про наличие машин\n    "есть машинки", "есть машинка", "есть машины", "есть машина",\n    "машинки есть", "машинка есть", "машины есть", "машина есть",\n    "есть свободные", "есть свободный", "есть свободная",\n    "есть свободные машины", "есть свободные машинки",\n    "есть свободные водители", "свободные есть",\n    "есть водители", "водители есть", "есть кто", "есть кто нибудь",\n    "есть кто-нибудь", "кто свободен", "кто нибудь есть",\n    "кто-нибудь есть", "машинки", "машина", "свободные",\n    # вопросы про цену без адреса\n    "сколько стоит", "сколько будет", "почем", "почём", "цена",\n    "какая цена", "цены", "тариф", "тарифы",\n})\n\n\ndef _is_not_order_text(session: Session, raw: str) -> bool:\n    """True when a plain message is chatter rather than a ride request."""\n    normalized = (raw or "").strip().strip("!?.,;:").casefold()\n    if not normalized:\n        return True\n    if normalized in TEXT_ORDER_STOP_WORDS:\n        return True\n    if normalized in _menu_text_commands(session):\n        return True\n    if not any(char.isalnum() for char in normalized):\n        return True\n    return len(normalized) < TEXT_ORDER_MIN_LENGTH\n\n\ndef _menu_text_commands(session: Session) -> set:\n    """Texts that must open the menu instead of creating an order."""\n    values = set(_passenger_labels(session).values())\n    values.update({\n        "начать", "старт", "start", "/start", "menu", "меню",\n        "главное меню", "назад", "стоп", "stop", "отмена",\n    })\n    return {str(v).strip().casefold() for v in values if v}\n\n\ndef passenger_text_order(session: Session, user: User, text: str) -> None:\n    """Create an order from a plain passenger text message.\n\n    A passenger does not have to press «Заказать авто» first: any free-form\n    message outside of an active order/flow is treated as the order text.\n    """\n    raw = " ".join((text or "").split())\n    if _is_not_order_text(session, raw):\n        return show_main_menu(session, user)\n    labels = _passenger_labels(session)\n    ban_msg = _order_ban_message(user)\n    if ban_msg:\n        vk.send_message(user.vk_id, ban_msg, keyboard=kb.passenger_menu(can_switch_role(user), labels))\n        return\n    if _passenger_order_limit_reached(session, user):\n        vk.send_message(\n            user.vk_id,\n            "За 15 минут можно создать не более 5 заявок. Попробуйте позже.",\n            keyboard=kb.passenger_menu(can_switch_role(user), labels),\n        )\n        return\n    if active_order_for(session, user):\n        vk.send_message(\n            user.vk_id,\n            "У вас уже есть активная заявка.",\n            keyboard=kb.passenger_waiting_keyboard(),\n        )\n        return\n    set_state(session, user.vk_id, States.P_ADDR, {"draft": {"order_type": "regular"}}, merge=False)\n    return order_set_addresses(session, user, raw)\n\n\ndef _recent_passenger_order_count(session: Session, user: User) -> int:\n    cutoff = time_utils.now() - dt.timedelta(minutes=15)\n    return int(\n        session.query(func.count(Order.id))\n        .filter(\n            Order.passenger_id == user.id,\n            Order.dispatcher_id.is_(None),\n            Order.created_at >= cutoff,\n        )\n        .scalar()\n        or 0\n    )\n\n\ndef _passenger_order_limit_reached(session: Session, user: User) -> bool:\n    """The sixth passenger-created request within 15 minutes is rejected."""\n    return _recent_passenger_order_count(session, user) >= 5\n\n\ndef start_new_order(session: Session, user: User) -> None:\n    labels = _passenger_labels(session)\n    ban_msg = _order_ban_message(user)\n    if ban_msg:\n        vk.send_message(user.vk_id, ban_msg, keyboard=kb.passenger_menu(can_switch_role(user), labels))\n        return\n    if _passenger_order_limit_reached(session, user):\n        vk.send_message(\n            user.vk_id,\n            "За 15 минут можно создать не более 5 заявок. Попробуйте позже.",\n            keyboard=kb.passenger_menu(can_switch_role(user), labels),\n        )\n        return\n    if active_order_for(session, user):\n        vk.send_message(\n            user.vk_id,\n            "У вас уже есть активная заявка.",\n            keyboard=kb.passenger_waiting_keyboard(),\n        )\n        return\n    draft = {"order_type": "regular"}\n    set_state(session, user.vk_id, States.P_ADDR, {"draft": draft}, merge=False)\n    vk.send_message(user.vk_id, msg(session, "msg_order_text_prompt"), keyboard=kb.passenger_order_entry_keyboard())\n\n\ndef choose_order_type(session: Session, user: User, order_type: str) -> None:\n    """Requirement 3/6: no line picker for the passenger anymore.\n\n    * regular order -> ask for BOTH addresses in one message (line is detected\n      automatically from the address text, or falls back to the default line).\n    * delivery      -> keep the delivery flow; line is auto-assigned.\n    """\n    data = get_data(session, user.vk_id)\n    draft = data.get("draft", {})\n    draft["order_type"] = "delivery" if order_type == "delivery" else "regular"\n\n    if draft["order_type"] == "delivery":\n        cid, line_name = lines.resolve_order_line(session)\n        draft["city_id"] = cid\n        draft["line"] = line_name\n        set_state(session, user.vk_id, States.P_DELIVERY_FROM, {"draft": draft}, merge=False)\n        return start_delivery_flow(session, user)\n\n    # Requirement 6: regular orders ask for both addresses at once.\n    set_state(session, user.vk_id, States.P_ADDR, {"draft": draft}, merge=False)\n    vk.send_message(user.vk_id, msg(session, "msg_order_text_prompt"), keyboard=kb.passenger_order_entry_keyboard())\n\n\ndef order_set_addresses(session: Session, user: User, text: str) -> None:\n    """Accept one free-form application and submit it immediately.\n\n    The legacy schema requires both ``address_from`` and ``address_to``.  Since\n    the new no-separator protocol intentionally does not split two street\n    addresses, ``address_from`` stores the recognized pickup city (or the full\n    route when no city is recognized) and ``address_to`` stores the unparsed\n    remainder required by the protocol.\n    """\n    raw = " ".join((text or "").split())\n    if not raw:\n        return vk.send_message(user.vk_id, msg(session, "msg_addresses_parse_error"))\n    # Freight transportation is handled by the dispatcher and must never be\n    # persisted or offered to drivers as a taxi/delivery order.\n    if re.search(r"(?<![а-яё])грузоперевозки(?![а-яё])", raw, re.IGNORECASE):\n        reset(session, user.vk_id, States.MAIN_MENU)\n        return vk.send_message(\n            user.vk_id,\n            msg(session, "msg_freight_contact_dispatcher"),\n            keyboard=kb.passenger_menu(can_switch_role(user), _passenger_labels(session)),\n        )\n    route_text, customer_price = customer_price_service.extract_customer_price(raw)\n    pickup_city, destination = lines.parse_pickup_city_for_session(session, route_text)\n    # A request is free-form; city parsing improves dispatch but never rejects\n    # a non-empty text. Preserve the full message if no destination was parsed.\n    # Legacy equivalent before stripping a client price:\n    # route_origin, route_destination = lines.split_route_segments(raw)\n    route_origin, route_destination = lines.split_route_segments(route_text)\n    # destination = route_destination or destination or raw\n    destination = route_destination or destination or route_text\n\n    data = get_data(session, user.vk_id)\n    draft = data.get("draft", {})\n    draft["route_text"] = route_text\n    draft["customer_price"] = customer_price\n    draft["requested_car_count"] = requested_car_count(raw)\n    draft["pickup_city"] = pickup_city\n    # Legacy assertion/documentation before fare extraction:\n    # draft["address_from"] = route_origin or pickup_city or raw\n    draft["address_from"] = route_origin or pickup_city or route_text\n    draft["address_to"] = destination\n    # No default line: NULL is meaningful and triggers global FIFO fallback.\n    draft["city_id"] = lines.city_id_by_name(session, pickup_city)\n    draft["line"] = pickup_city\n    # «Красный бархат»/«Галактика» + «доставка» → доставка от партнёров.\n    # «Кайф» всегда остаётся обычной заявкой, даже со словом «доставка».\n    # Название партнёра без слова «доставка» остаётся обычной поездкой.\n    # Always reset this field first: the same passenger can start a new taxi\n    # order immediately after a previous delivery flow, and reusing the draft\n    # must not leak order_type="delivery" into the new request.\n    draft["order_type"] = "regular"\n    if delivery_service.is_partner_delivery_text(raw):\n        draft["order_type"] = delivery_service.PARTNER_DELIVERY_TYPE\n    elif delivery_service.is_delivery_text(raw):\n        draft["order_type"] = "delivery"\n    # One message is enough for both passengers and dispatchers. There are no\n    # extra-service or confirmation screens; status becomes available only\n    # after the order row has actually been created.\n    if user.role == ROLE_DISPATCHER:\n        set_state(session, user.vk_id, States.P_CONFIRM,\n                  {"draft": draft, "extras": []}, merge=False)\n        return disp_create_order_from_draft(session, user)\n    set_state(session, user.vk_id, States.P_CONFIRM,\n              {"draft": draft, "extras": []}, merge=False)\n    return create_passenger_order(session, user, draft.get("order_type", "regular"))\n\n\ndef order_set_voice(session: Session, user: User, voice_attachment: str) -> None:\n    """Create a regular voice-only request on the Gornozavodsk line."""\n    data = get_data(session, user.vk_id)\n    draft = data.get("draft", {})\n    draft.update({\n        "order_type": "regular",\n        "route_text": "🎤 Голосовая заявка",\n        "voice_attachment": voice_attachment,\n        "pickup_city": "Горнозаводск",\n        "address_from": "Горнозаводск",\n        "address_to": "Голосовая заявка",\n        "city_id": lines.city_id_by_name(session, "Горнозаводск"),\n        "line": "Горнозаводск",\n    })\n    # Voice requests use the same FIFO offer flow and buttons as ordinary\n    # requests, but never receive Pashiya/Kusya route priority.\n    set_state(\n        session,\n        user.vk_id,\n        States.P_CONFIRM,\n        {"draft": draft, "extras": []},\n        merge=False,\n    )\n    if user.role == ROLE_DISPATCHER:\n        return disp_create_order_from_draft(session, user)\n    return create_passenger_order(session, user, "regular")\n\n\ndef start_edit_order(session: Session, user: User) -> None:\n    """Requirement 6: «Отредактировать заявку» from the confirmation screen —\n    re-enter the addresses (and then services) before creating the order.\n    """\n    data = get_data(session, user.vk_id)\n    draft = data.get("draft", {})\n    set_state(session, user.vk_id, States.P_ADDR, {"draft": draft}, merge=False)\n    vk.send_message(user.vk_id, msg(session, "msg_order_text_prompt"), keyboard=kb.passenger_order_entry_keyboard())\n\n\ndef _continue_after_line(session: Session, user: User, draft: dict) -> None:\n    """Req 4: allow ordering only where drivers are on the line; then branch."""\n    city_id = draft.get("city_id")\n    if not lines.line_has_any_driver(session, city_id):\n        vk.send_message(\n            user.vk_id,\n            msg(session, "msg_no_drivers_on_line"),\n            keyboard=kb.passenger_menu(can_switch_role(user), _passenger_labels(session)),\n        )\n        reset(session, user.vk_id, States.MAIN_MENU)\n        return\n    draft["line"] = lines.line_name(session, city_id)\n    if draft.get("order_type") == "delivery":\n        set_state(session, user.vk_id, States.P_DELIVERY_FROM, {"draft": draft})\n        return start_delivery_flow(session, user)\n    set_state(session, user.vk_id, States.P_FROM, {"draft": draft})\n    send_bot_message(session, user.vk_id, "ask_from")\n\n\ndef set_order_city(session: Session, user: User, city_id: int) -> None:\n    data = get_data(session, user.vk_id)\n    draft = data.get("draft", {})\n    draft["city_id"] = city_id\n    set_state(session, user.vk_id, States.P_CITY, {"draft": draft})\n    _continue_after_line(session, user, draft)\n\n\ndef order_set_from(session: Session, user: User, text: str) -> None:\n    if not text:\n        return send_bot_message(session, user.vk_id, "ask_from")\n    data = get_data(session, user.vk_id)\n    draft = data.get("draft", {})\n    draft["address_from"] = text\n    set_state(session, user.vk_id, States.P_TO, {"draft": draft})\n    send_bot_message(session, user.vk_id, "ask_to")\n\n\ndef order_set_to(session: Session, user: User, text: str) -> None:\n    if not text:\n        return send_bot_message(session, user.vk_id, "ask_to")\n    data = get_data(session, user.vk_id)\n    draft = data.get("draft", {})\n    draft["address_to"] = text\n    # Bug #6: taxi orders no longer ask for a comment -> straight to extras.\n    set_state(session, user.vk_id, States.P_EXTRAS, {"draft": draft})\n    return start_extras(session, user)\n\n\ndef order_set_comment(session: Session, user: User, text: str) -> None:\n    data = get_data(session, user.vk_id)\n    draft = data.get("draft", {})\n    draft["comment"] = text or None\n    set_state(session, user.vk_id, States.P_TYPE, {"draft": draft})\n    send_bot_message(session, user.vk_id, "ask_order_type", keyboard=kb.order_type_keyboard())\n\n\ndef start_extras(session: Session, user: User) -> None:\n    """Requirement 1: after addresses, offer the extra services (taxi only)."""\n    data = get_data(session, user.vk_id)\n    draft = data.get("draft", {})\n    set_state(session, user.vk_id, States.P_EXTRAS, {"draft": draft, "extras": []}, merge=False)\n    vk.send_message(user.vk_id, msg(session, "msg_extras_prompt"), keyboard=kb.extras_keyboard([]))\n\n\ndef toggle_extra_service(session: Session, user: User, key) -> None:\n    data = get_data(session, user.vk_id)\n    selection = extra_services.toggle(data.get("extras", []), key or "")\n    set_state(session, user.vk_id, States.P_EXTRAS, {"extras": selection})\n    vk.send_message(user.vk_id, msg(session, "msg_extras_prompt"), keyboard=kb.extras_keyboard(selection))\n\n\ndef finish_extras(session: Session, user: User) -> None:\n    """Requirement 1/3: show the order summary + night tariff, ask to confirm."""\n    data = get_data(session, user.vk_id)\n    selection = data.get("extras", [])\n    draft = data.get("draft", {})\n    set_state(session, user.vk_id, States.P_CONFIRM, {"draft": draft, "extras": selection})\n    request_text = (draft.get("route_text") or " ".join(x for x in (draft.get("address_from"), draft.get("address_to")) if x)).strip()\n    confirmation = msg(session, "msg_order_confirm", request=request_text)\n    vk.send_message(\n        user.vk_id,\n        confirmation,\n        keyboard=kb.order_confirm_keyboard(button_label(session, "btn_edit_order", "✏️ Отредактировать заявку")),\n    )\n\n\ndef create_passenger_order(session: Session, user: User, order_type: str) -> None:\n    data = get_data(session, user.vk_id)\n    draft = data.get("draft", {})\n    requested_driver_id = draft.get("requested_driver_id")\n    try:\n        requested_driver_id = int(requested_driver_id) if requested_driver_id is not None else None\n    except (TypeError, ValueError):\n        requested_driver_id = None\n    # Idempotency guard for duplicate VK events.  In particular, do not turn a\n    # successfully sent personal request into the false message «водитель уже\n    # недоступен» merely because its one-shot selection row was consumed.\n    existing_order = active_order_for(session, user)\n    if existing_order:\n        if _notice_existing_direct_order(session, user, requested_driver_id):\n            return\n        return _menu_lock_notice(session, user)\n    car_count = (\n        2\n        if not draft.get("requested_driver_id")\n        and int(draft.get("requested_car_count") or 1) == 2\n        and order_type not in ("delivery", delivery_service.PARTNER_DELIVERY_TYPE)\n        else 1\n    )\n    if _recent_passenger_order_count(session, user) + car_count > 5:\n        cancel_direct_driver_selection(\n            session, user, notify_passenger=False, notify_driver=True\n        )\n        reset(session, user.vk_id, States.MAIN_MENU)\n        return vk.send_message(\n            user.vk_id,\n            "За 15 минут можно создать не более 5 заявок. Попробуйте позже.",\n            keyboard=kb.passenger_menu(can_switch_role(user), _passenger_labels(session)),\n        )\n    if not draft.get("address_from") or not draft.get("address_to"):\n        return start_new_order(session, user)\n    selection_id = draft.get("driver_selection_id")\n    direct_selection = None\n    selected_driver = None\n    if requested_driver_id or selection_id:\n        try:\n            requested_driver_id = int(requested_driver_id)\n            selection_id = int(selection_id)\n        except (TypeError, ValueError):\n            requested_driver_id = selection_id = None\n        direct_selection = (\n            session.query(DriverSelection)\n            .filter(\n                DriverSelection.id == selection_id,\n                DriverSelection.passenger_id == user.id,\n                DriverSelection.driver_id == requested_driver_id,\n            )\n            .with_for_update()\n            .one_or_none()\n            if selection_id and requested_driver_id else None\n        )\n        selected_driver = session.get(User, requested_driver_id) if direct_selection else None\n        entry = (\n            session.query(DriverQueue)\n            .filter(DriverQueue.driver_id == requested_driver_id)\n            .with_for_update()\n            .one_or_none()\n            if selected_driver else None\n        )\n        valid_selection = bool(\n            direct_selection and direct_selection.expires_at > time_utils.now()\n            and entry and entry.status in ("offered", "waiting")\n            and selected_driver.is_on_line\n            and selected_driver.driver_status == "online"\n            and not active_order_for(session, selected_driver, as_driver=True)\n            and not offered_order_for(session, selected_driver)\n        )\n        if not valid_selection:\n            # We may have waited on the one-shot DriverSelection lock while a\n            # concurrent copy of the same VK event created the real order.\n            # Recheck after that wait before declaring the driver unavailable.\n            if _notice_existing_direct_order(session, user, requested_driver_id):\n                if direct_selection:\n                    _release_direct_selection(session, direct_selection)\n                return\n            if direct_selection:\n                _release_direct_selection(session, direct_selection)\n            reset(session, user.vk_id, States.P_DRIVER_SELECT)\n            return vk.send_message(\n                user.vk_id,\n                "Выбранный водитель уже недоступен. Выберите другого.",\n                keyboard=kb.direct_driver_unavailable_keyboard(),\n            )\n    normalized_type = (\n        order_type\n        if order_type in ("delivery", delivery_service.PARTNER_DELIVERY_TYPE)\n        else "regular"\n    )\n    extras_selection = data.get("extras", []) if normalized_type == "regular" else []\n    orders = []\n    for car_index in range(car_count):\n        order = Order(\n            passenger_id=user.id,\n            requested_driver_id=requested_driver_id if selected_driver else None,\n            city_id=draft.get("city_id"),\n            address_from=draft["address_from"],\n            address_to=draft["address_to"],\n            route_text=draft.get("route_text") or " ".join(x for x in (draft.get("address_from"), draft.get("address_to")) if x),\n            voice_attachment=draft.get("voice_attachment"),\n            comment=draft.get("comment"),\n            order_type=normalized_type,\n            status="created",\n            line=draft.get("line"),\n            pickup_city=draft.get("pickup_city"),\n            extra_services=extra_services.to_json(extras_selection),\n            night_surcharge=(normalized_type == "regular" and night_tariff.is_night(session)),\n            customer_price=draft.get("customer_price"),\n        )\n        session.add(order)\n        session.flush()\n        orders.append(order)\n        audit.record(\n            session,\n            "order_created",\n            f"order={order.id} type={order.order_type} extras={extras_selection} "\n            f"car={car_index + 1}/{car_count}",\n        )\n    order = orders[0]\n    if len(orders) == 2:\n        for item in orders:\n            item.multi_car_group_id = order.id\n    # Keep the exclusive hold until the real Order offer has been flushed.\n    # Queue repair must never see a gap between selection and order ownership.\n    # Reset the creator\'s draft/declined tracking before searching.\n    set_state(\n        session,\n        user.vk_id,\n        States.P_WAITING,\n        {"declined": [], "current_offer": None, "order_ids": [item.id for item in orders]},\n        merge=False,\n    )\n    if selected_driver:\n        pass  # Confirm only after the driver\'s tracked offer was accepted.\n    elif any(item.customer_price is not None for item in orders):\n        # Confirmation is sent after the tracked chat cards are created.\n        pass\n    elif car_count == 2:\n        for car_index, item in enumerate(orders, start=1):\n            vk.send_message(\n                user.vk_id,\n                f"✅ Машина {car_index}: заявка #{item.number} создана. "\n                "Ищем водителя по очереди.",\n                keyboard=kb.passenger_waiting_keyboard(item.id),\n            )\n    else:\n        # dispatch_new_order sends the precise result after checking current\n        # availability: hand-off to a free driver or a parallel search.\n        pass\n    if selected_driver:\n        offered = order_service.offer_to_selected_driver(session, order, selected_driver)\n        if direct_selection:\n            timers.cancel("direct_selection", direct_selection.id)\n            session.delete(direct_selection)\n            session.flush()\n        if offered:\n            vk.send_message(\n                user.vk_id,\n                f"✅ Заявка #{order.number} создана и отправлена водителю.",\n                keyboard=kb.passenger_waiting_keyboard(order.id),\n            )\n            return\n        dispatch_failed = order.status == "searching" and not order.offer_outbox_id\n        order.status = "cancelled"\n        order.cancelled_at = time_utils.now()\n        order.cancelled_by = "system"\n        session.flush()\n        if not queue_service._driver_has_active_work(session, selected_driver.id):\n            queue_service.release_offer(session, selected_driver)\n        reset(session, user.vk_id, States.MAIN_MENU)\n        vk.send_message(\n            user.vk_id,\n            (\n                "Не удалось отправить заявку выбранному водителю. Попробуйте ещё раз."\n                if dispatch_failed else\n                "Выбранный водитель уже недоступен. Заявка не передавалась в общую очередь."\n            ),\n            keyboard=kb.direct_driver_unavailable_keyboard(),\n        )\n        passenger_queue.try_promote(session)\n        return\n    # Passenger-priced orders now use the same first-free-driver flow as\n    # ordinary orders. If that driver ignores the 30-second offer, the timer\n    # moves the request to the shared driver chat.\n    if not selected_driver:\n        direct_chat_orders = [item for item in orders if item.customer_price is not None]\n        if direct_chat_orders:\n            for item in direct_chat_orders:\n                passenger_queue.dispatch_new_order(session, item)\n            vk.send_message(\n                user.vk_id,\n                f"Заявка #{order.number} создана. Ждем когда первый водитель "\n                "согласится на цену. Вы можете изменить цену.",\n                keyboard=kb.customer_price_waiting_keyboard(order.id),\n            )\n            return\n\n    # Isolate dispatch in a savepoint. If a production-specific SQL/query\n    # problem occurs, keep the created order and passenger response instead of\n    # rolling back the entire event and making the bot appear silent.\n    # Dispatch sequentially. The first call reserves the first FIFO driver;\n    # therefore the second identical order necessarily goes to the next one.\n    for item in orders:\n        try:\n            with session.begin_nested():\n                passenger_queue.dispatch_new_order(session, item)\n        except Exception as exc:  # noqa: BLE001\n            log.exception("Initial dispatch failed for passenger order=%s: %s", item.id, exc)\n            passenger_queue.enqueue(session, item)\n            vk.send_message(\n                user.vk_id,\n                f"Заявка #{item.number} поставлена в очередь. Продолжаем искать водителя.",\n                keyboard=kb.passenger_waiting_keyboard(item.id),\n            )\n\n\ndef repeat_order(session: Session, user: User, order_id: int) -> None:\n    prev = session.get(Order, order_id)\n    if not prev or prev.passenger_id != user.id:\n        return show_main_menu(session, user)\n    if active_order_for(session, user):\n        vk.send_message(user.vk_id, "У вас уже есть активная заявка.", keyboard=kb.passenger_waiting_keyboard())\n        return\n    if _passenger_order_limit_reached(session, user):\n        return vk.send_message(\n            user.vk_id,\n            "За 15 минут можно создать не более 5 заявок. Попробуйте позже.",\n            keyboard=kb.passenger_menu(can_switch_role(user), _passenger_labels(session)),\n        )\n    order = Order(\n        passenger_id=user.id,\n        city_id=prev.city_id,\n        address_from=prev.address_from,\n        address_to=prev.address_to,\n        route_text=prev.route_text,\n        voice_attachment=prev.voice_attachment,\n        comment=prev.comment,\n        order_type=prev.order_type,\n        status="created",\n        line=prev.line,\n        pickup_city=prev.pickup_city,\n        customer_price=prev.customer_price,\n    )\n    session.add(order)\n    session.flush()\n    set_state(session, user.vk_id, States.P_WAITING, {"declined": [], "current_offer": None}, merge=False)\n    send_bot_message(session, user.vk_id, "order_created", keyboard=kb.passenger_waiting_keyboard(), order_id=order.number)\n    passenger_queue.dispatch_new_order(session, order)\n\n\ndef show_passenger_history(session: Session, user: User) -> None:\n    orders = (\n        session.query(Order)\n        .filter(Order.passenger_id == user.id, Order.status == "completed")\n        .order_by(Order.completed_at.desc())\n        .limit(10)\n        .all()\n    )\n    if not orders:\n        vk.send_message(user.vk_id, "У вас пока нет завершённых поездок.", keyboard=kb.passenger_menu(can_switch_role(user)))\n        return\n    lines = ["🕒 Ваши последние поездки:\\n"]\n    for o in orders:\n        when = time_utils.format_local(o.completed_at, "%d.%m.%Y") if o.completed_at else ""\n        price = f"{float(o.price):.0f} ₽" if o.price is not None else "—"\n        route = o.route_text or f"{o.address_from} → {o.address_to}"\n        lines.append(f"#{o.number} • {when} • {route} • {price}")\n    vk.send_message(user.vk_id, "\\n".join(lines), keyboard=kb.passenger_menu(can_switch_role(user)))\n\n\ndef _passenger_within_grace(session: Session, order: Order) -> bool:\n    departed = order.driver_departed_at\n    if not departed:\n        return True\n    if departed.tzinfo is None:\n        departed = departed.replace(tzinfo=dt.timezone.utc)\n    grace = get_int(session, "passenger_cancel_grace_seconds", 120)\n    return (time_utils.now() - departed).total_seconds() <= grace\n\n\ndef _parallel_cancellation_is_chargeable(order: Order) -> bool:\n    """A parallel reservation is free only before promotion and within 120s."""\n    taken = getattr(order, "parallel_accepted_at", None)\n    if taken is None:\n        # Old reservations did not store their take time: never invent debt.\n        return False\n    if order.status != "parallel_assigned":\n        return True\n    if taken.tzinfo is None:\n        taken = taken.replace(tzinfo=dt.timezone.utc)\n    return (time_utils.now() - taken).total_seconds() > 120\n\n\ndef passenger_cancel_request(session: Session, user: User, order_id=None) -> None:\n    """Warn before a cancellation that will create a false-call debt."""\n    order = passenger_order_for(session, user, order_id)\n    if not order:\n        return show_main_menu(session, user)\n    if order.status == "in_progress":\n        return vk.send_message(\n            user.vk_id,\n            "После посадки отменить заявку нельзя.",\n            keyboard=kb.passenger_in_ride_keyboard(order.id),\n        )\n    if not _is_dispatcher_order(order) and _parallel_cancellation_is_chargeable(order):\n        return vk.send_message(\n            user.vk_id,\n            "⚠️ При отмене параллельной заявки будет создан ложный вызов. Подтвердить отмену?",\n            keyboard=kb.passenger_cancel_confirm_keyboard(order.id),\n        )\n    if (order.driver_id and not order.parallel_driver_id\n            and not _is_dispatcher_order(order)\n            and order.driver_departed_at\n            and not _passenger_within_grace(session, order)):\n        return vk.send_message(\n            user.vk_id,\n            "⚠️ Водитель уже выехал, и прошло больше 2 минут. При отмене будет создан ложный вызов. Подтвердить отмену?",\n            keyboard=kb.passenger_cancel_confirm_keyboard(order.id),\n        )\n    return passenger_cancel(session, user, order.id)\n\n\ndef passenger_order_status(session: Session, user: User, order_id=None) -> None:\n    order = passenger_order_for(session, user, order_id)\n    if not order:\n        return show_main_menu(session, user)\n    labels = {\n        "created": "заявка создана",\n        "queued": "ожидаем свободного водителя",\n        "searching": "водитель рассматривает заявку",\n        "chat_search": "ищем водителя через чат заявок",\n        "parallel_assigned": "водитель завершает предыдущую поездку",\n        "assigned": "водитель назначен и едет к вам",\n        "arrived": "водитель подъехал",\n        "in_progress": "поездка выполняется",\n    }\n    text = f"📍 Заявка #{order.number}: {labels.get(order.status, order.status)}."\n    if order.status == "queued":\n        position = passenger_queue.position(session, order.id)\n        if position:\n            text += f" Ваша позиция в очереди: {position}."\n    if order.parallel_eta:\n        text += f" Водитель завершает текущую поездку и будет у вас ориентировочно через {order.parallel_eta} мин."\n    if not order.driver_id and not order.parallel_driver_id:\n        keyboard = kb.passenger_waiting_keyboard(order.id)\n    elif order.status == "arrived":\n        keyboard = kb.passenger_arrived_keyboard(order.id)\n    elif order.status == "in_progress":\n        keyboard = kb.passenger_in_ride_keyboard(order.id)\n    elif order.arrival_eta or order.parallel_eta:\n        keyboard = kb.passenger_ride_keyboard(order.id)\n    else:\n        keyboard = kb.passenger_assigned_keyboard(order.id)\n    vk.send_message(user.vk_id, text, keyboard=keyboard)\n\n\ndef _remaining_driver_eta_minutes(order: Order, now: dt.datetime | None = None) -> int | None:\n    """Live minutes left from the driver\'s ETA, including later extensions."""\n    eta = order.arrival_eta\n    started_at = order.driver_departed_at\n    if not eta and order.parallel_eta:\n        eta = order.parallel_eta\n        started_at = order.parallel_eta_set_at\n    if not eta or not started_at:\n        return None\n    if started_at.tzinfo is None:\n        started_at = started_at.replace(tzinfo=dt.timezone.utc)\n    current = now or time_utils.now()\n    if current.tzinfo is None:\n        current = current.replace(tzinfo=dt.timezone.utc)\n    deadline = started_at + dt.timedelta(minutes=int(eta))\n    return max(0, int(math.ceil((deadline - current).total_seconds() / 60.0)))\n\n\ndef passenger_driver_wait_remaining(session: Session, user: User, order_id=None) -> None:\n    order = passenger_order_for(session, user, order_id)\n    if not order:\n        return show_main_menu(session, user)\n    if order.status == "arrived":\n        return vk.send_message(\n            user.vk_id,\n            "🚘 Водитель уже прибыл и ожидает вас.",\n            keyboard=kb.passenger_arrived_keyboard(order.id),\n        )\n    if order.status == "in_progress":\n        return vk.send_message(user.vk_id, "🚗 Поездка уже началась.")\n    remaining = _remaining_driver_eta_minutes(order)\n    if remaining is None:\n        if not order.driver_id:\n            return vk.send_message(user.vk_id, "Водитель ещё не назначен. Продолжаем поиск.")\n        return vk.send_message(user.vk_id, "Водитель ещё не указал время прибытия.")\n    if remaining == 0:\n        return vk.send_message(user.vk_id, "⏱ Указанное время прибытия истекло. Водитель должен быть рядом.")\n    vk.send_message(user.vk_id, f"⏱ Водитель будет примерно через {remaining} мин.")\n\n\ndef passenger_cancel(session: Session, user: User, order_id=None) -> None:\n    active = passenger_order_for(session, user, order_id)\n    if not active:\n        return show_main_menu(session, user)\n    session.flush()\n    order = (session.query(Order).filter(Order.id == active.id)\n             .with_for_update().populate_existing().one())\n    # Re-check after the lock: the passenger\'s order may have completed while\n    # waiting for a concurrent promotion or cancellation.\n    if order.status not in ("created", "queued", "searching", "chat_search", "price_negotiation", "parallel_assigned", "assigned", "arrived", "in_progress"):\n        return show_main_menu(session, user)\n    if order.status == "in_progress":\n        return vk.send_message(\n            user.vk_id,\n            "После посадки отменить заявку нельзя.",\n            keyboard=kb.passenger_in_ride_keyboard(order.id),\n        )\n    parallel_charge = bool(\n        not _is_dispatcher_order(order) and _parallel_cancellation_is_chargeable(order)\n    )\n    if getattr(order, "enroute_notice_outbox_id", None):\n        order_service.clear_enroute_notice(session, order)\n    from . import outbox_service\n    for prompt_field in ("departure_prompt_outbox_id", "chat_actuality_prompt_outbox_id"):\n        prompt_id = getattr(order, prompt_field, None)\n        if prompt_id:\n            outbox_service.cancel_or_delete(session, prompt_id)\n            setattr(order, prompt_field, None)\n    chat_reason = order_service.driver_chat_reason_label(session, order) if order.status == "chat_search" else None\n    order.status = "cancelled"\n    order.cancelled_at = time_utils.now()\n    # Cancellations themselves are not limited. Abuse is bounded by the five\n    # passenger-created requests per 15 minutes, regardless of how those\n    # requests finish.\n    order.cancelled_by = "passenger"\n    # A departed booking is represented by both Booking and Order. Closing\n    # only the order left the booking shown as «Водитель выехал» forever.\n    booking_service.cancel_for_order(\n        session, order.id, canceled_by="passenger"\n    )\n    from . import parallel_orders\n    parallel_orders.release_route_offers_for_trip(session, order)\n    passenger_queue.remove(session, order.id)\n    timers.cancel_all_for_order(order.id)\n    if order.offered_driver_id and not order.driver_id:\n        offered_driver = session.get(User, order.offered_driver_id)\n        if offered_driver:\n            queue_service.release_offer(session, offered_driver)\n            reset(session, offered_driver.vk_id, States.D_MENU)\n            vk.send_message(offered_driver.vk_id, f"Заявка #{order.number} отменена клиентом.")\n            from . import push_service\n            push_service.send(session, offered_driver.id, "cancelled", order)\n        order.offered_driver_id = None\n    if chat_reason:\n        order_service.send_fallback_chat_notice(\n            session,\n            f"❌ Заявка №{order.number} ({chat_reason}) отменена пассажиром.",\n        )\n    fake_call_created = False\n    # A reserved parallel request belongs through parallel_driver_id only.  It\n    # is not the driver\'s current ride and cancelling it must return the driver\n    # to that ride instead of changing their queue position.\n    if order.parallel_driver_id:\n        driver = session.get(User, order.parallel_driver_id)\n        if getattr(order, "offer_outbox_id", None):\n            order_service.finalize_offer_message(session, order, "❌ Пассажир отменил заявку.")\n        order.parallel_driver_id = None\n        order.driver_id = None  # repair rows created by older releases\n        if driver:\n            from . import push_service\n            push_service.send(session, driver.id, "cancelled", order)\n            if parallel_charge:\n                fake_calls_service.create(session, order, driver)\n                fake_call_created = True\n            vk.send_message(\n                driver.vk_id,\n                f"Пассажир отменил параллельную заявку #{order.number}. "\n                + ("Создан ложный вызов. " if parallel_charge else "")\n                + "Текущая поездка продолжается.",\n            )\n            current = (\n                session.query(Order)\n                .filter(Order.driver_id == driver.id, Order.status.in_(parallel_orders.ACTIVE))\n                .order_by(Order.created_at.asc())\n                .first()\n            )\n            if current:\n                set_state(session, driver.vk_id, States.D_IN_RIDE, {"order_id": current.id})\n                vk.send_message(\n                    driver.vk_id,\n                    f"Возвращаемся к текущей заявке #{current.number}.",\n                    keyboard=_driver_ride_kb(session, current),\n                )\n            else:\n                queue_service.restore_position(session, driver)\n                reset(session, driver.vk_id, States.D_MENU)\n                show_main_menu(session, driver)\n        if not fake_call_created:\n            _continue_after_passenger_order_closed(session, user, order.id, order.number)\n        passenger_queue.try_promote(session)\n        return\n    if order.driver_id:\n        driver = session.get(User, order.driver_id)\n        accepted = order.driver_accept_time is not None\n        past_grace = parallel_charge or (accepted and not _passenger_within_grace(session, order))\n        from . import parallel_orders\n        has_parallel = bool(driver and parallel_orders.has_pending(session, driver))\n        if driver:\n            from . import push_service\n            push_service.send(session, driver.id, "cancelled", order)\n            if past_grace and not _is_dispatcher_order(order):\n                name = user.full_name or ("id" + str(user.vk_id))\n                vk.send_message(driver.vk_id, f"Клиент отменил (ложный вызов). Свяжется с вами\\n[id{user.vk_id}|{name}]")\n            elif _is_dispatcher_order(order):\n                vk.send_message(driver.vk_id, f"Диспетчер отменил заявку #{order.number}. Ложный вызов не начисляется.")\n            else:\n                vk.send_message(driver.vk_id, "Клиент отменил во время бесплатной отмены")\n            if has_parallel:\n                parallel_orders.promote_after_current(session, driver)\n            else:\n                restored_to_front = queue_service.move_to_front(session, driver) is not None\n                reset(session, driver.vk_id, States.D_MENU)\n                if restored_to_front:\n                    vk.send_message(\n                        driver.vk_id,\n                        "Клиент отменил активную заявку. Вы автоматически возвращены на 1-е место в очереди.",\n                        keyboard=kb.driver_menu(on_line=True, show_role_switch=can_switch_role(driver)),\n                    )\n                else:\n                    show_main_menu(session, driver)\n        # Requirement 6: cancelling more than 2 min after acceptance is a false call.\n        if driver and past_grace and not _is_dispatcher_order(order):\n            order.passenger_cancel_after_accept = True\n            fake_calls_service.create(session, order, driver)\n            fake_call_created = True\n    if not fake_call_created:\n        _continue_after_passenger_order_closed(session, user, order.id, order.number)\n    passenger_queue.try_promote(session)\n\n\ndef _continue_after_passenger_order_closed(\n    session: Session,\n    user: User,\n    closed_order_id: int,\n    closed_order_number: int | None = None,\n) -> None:\n    """Keep the second car active when one order is cancelled."""\n    # SessionLocal disables autoflush. Persist all cancellation/cleanup state\n    # before checking for another active request, otherwise stale rows can make\n    # a single cancelled order look like a multi-car request.\n    session.flush()\n    remaining = (\n        session.query(Order)\n        .filter(\n            Order.passenger_id == user.id,\n            Order.id != closed_order_id,\n            Order.status.in_((\n                "created", "queued", "searching", "chat_search",\n                "parallel_assigned", "assigned", "arrived", "in_progress",\n            )),\n        )\n        .order_by(Order.created_at.asc())\n        .all()\n    )\n    visible_number = closed_order_number or closed_order_id\n    vk.send_message(user.vk_id, f"Ваша заявка #{visible_number} отменена")\n    if remaining:\n        set_state(\n            session,\n            user.vk_id,\n            States.P_WAITING,\n            {"order_ids": [order.id for order in remaining]},\n            merge=False,\n        )\n        vk.send_message(\n            user.vk_id,\n            "Остальные заявки продолжают выполняться.",\n            keyboard=kb.passenger_waiting_keyboard(remaining[0].id),\n        )\n        return\n    reset(session, user.vk_id, States.MAIN_MENU)\n    show_main_menu(session, user)\n\n\ndef _driver_card(driver: User) -> str:\n    """Keep ETA messages identical to the immediate acceptance card."""\n    return order_service.driver_card_text(driver)\n\n\ndef _edit_departure_prompt(session: Session, outbox_id: int | None, user: User, text: str) -> bool:\n    if not outbox_id:\n        return False\n    row = session.get(OutboxMessage, outbox_id)\n    if not row:\n        return False\n    keyboard = \'{"buttons":[],"inline":true}\'\n    row.text = text\n    row.keyboard = keyboard\n    if row.status != "sent":\n        return True\n    marker = row.last_error or ""\n    message_id = marker.split(":", 1)[1] if marker.startswith("vk_message_id:") else ""\n    return bool(message_id.isdigit() and vk.edit_message(user.vk_id, int(message_id), text, keyboard))\n\n\ndef passenger_departure_response(\n    session: Session,\n    user: User,\n    cancel: bool,\n    order_id=None,\n) -> None:\n    order = passenger_order_for(session, user, order_id)\n    if not order:\n        return show_main_menu(session, user)\n    # Serialize a passenger answer with the driver\'s arrival so a late\n    # confirmation cannot create an "on the way" notice after arrival.\n    session.flush()\n    session.refresh(order, with_for_update=True)\n    if order.status not in ("assigned", "arrived", "in_progress", "parallel_assigned"):\n        return show_main_menu(session, user)\n    if cancel and order.status == "in_progress":\n        return passenger_cancel(session, user, order.id)\n    parallel = order.status == "parallel_assigned" or bool(getattr(order, "parallel_accepted_at", None))\n    driver_id = order.parallel_driver_id if order.status == "parallel_assigned" else order.driver_id\n    driver = session.get(User, driver_id) if driver_id else None\n    prompt_id = order.departure_prompt_outbox_id\n    if not prompt_id:\n        return  # Duplicate/stale callback must not notify or cancel again.\n    if driver and not cancel:\n        vk.send_message(driver.vk_id, "Клиент по параллельной заявке, ожидает на месте" if parallel else "Клиент ожидает вас на месте")\n    if prompt_id:\n        from . import outbox_service\n        prompt = session.get(OutboxMessage, prompt_id)\n        final_text = (prompt.text or "").rstrip() if prompt else ""\n        # Keep car/driver/ETA in this same card. Edits use the durable outbox\n        # so a transient VK failure cannot leave live confirmation buttons.\n        final_text = re.sub(\n            r"\\s*(?:(?:Вы )?[Жж]д[её]те(?: машинку)?\\?)\\s*$", "", final_text\n        ).rstrip()\n        if cancel:\n            final_text = f"{final_text}\\n❌ Заявка отменена.".lstrip()\n        if final_text:\n            outbox_service.finalize_tracked_message(\n                session, prompt_id, final_text, replace_text=True, defer_edit=True,\n                replacement_keyboard=\'{"buttons":[],"inline":true}\',\n            )\n        else:\n            outbox_service.cancel_or_delete(session, prompt_id)\n    order.departure_prompt_outbox_id = None\n    if cancel:\n        return passenger_cancel(session, user, order.id)\n    if order.status in ("assigned", "parallel_assigned"):\n        # Persist the exact message id; arrival will delete this message only.\n        order.enroute_notice_outbox_id = vk.send_tracked_message(user.vk_id, "Машинка в пути")\n    order.actuality_confirmed = True\n    set_state(session, user.vk_id, States.P_IN_RIDE, {"order_id": order.id})\n\n\n# --------------------------------------------------------------------------- #\n#  Rating + reviews                                                            #\n# --------------------------------------------------------------------------- #\ndef _finish_rating_prompt(session: Session, order: Order, driver_side: bool, note: str) -> None:\n    """Remove stars/skip from the exact rating card after one answer."""\n    field = "driver_rating_prompt_outbox_id" if driver_side else "passenger_rating_prompt_outbox_id"\n    outbox_id = getattr(order, field, None)\n    if outbox_id:\n        from . import outbox_service\n        outbox_service.finalize_tracked_message(session, outbox_id, note)\n        setattr(order, field, None)\n    from . import rating_expiry_service\n    rating_expiry_service.cancel_expiry(order.id, driver_side=driver_side)\n\n\ndef passenger_skip_rating(session: Session, user: User, order_id: int | None) -> None:\n    query = session.query(Order).with_for_update()\n    order = query.filter(Order.id == int(order_id)).one_or_none() if order_id else (\n        query\n        .filter(Order.passenger_id == user.id, Order.passenger_rating_prompt_outbox_id.isnot(None))\n        .order_by(Order.completed_at.desc())\n        .first()\n    )\n    if (\n        not order\n        or order.passenger_id != user.id\n        or not order.passenger_rating_prompt_outbox_id\n    ):\n        return\n    _finish_rating_prompt(session, order, False, "Оценка пропущена.")\n    vk.send_message(user.vk_id, "Спасибо! Ждём вас снова.", keyboard=kb.passenger_menu(can_switch_role(user)))\n    reset(session, user.vk_id, States.MAIN_MENU)\n\n\ndef driver_skip_passenger_rating(session: Session, user: User, order_id: int | None) -> None:\n    query = session.query(Order).with_for_update()\n    order = query.filter(Order.id == int(order_id)).one_or_none() if order_id else (\n        query\n        .filter(Order.driver_id == user.id, Order.driver_rating_prompt_outbox_id.isnot(None))\n        .order_by(Order.completed_at.desc())\n        .first()\n    )\n    if (\n        not order\n        or order.driver_id != user.id\n        or not order.driver_rating_prompt_outbox_id\n    ):\n        return\n    _finish_rating_prompt(session, order, True, "Оценка пропущена.")\n    vk.send_message(user.vk_id, "Оценка пропущена.")\n\n\ndef save_rating(session: Session, user: User, order_id: int, stars: int) -> None:\n    order = (\n        session.query(Order)\n        .filter(Order.id == int(order_id))\n        .with_for_update()\n        .one_or_none()\n    )\n    if not order or order.passenger_id != user.id:\n        return show_main_menu(session, user)\n    if not order.passenger_rating_prompt_outbox_id:\n        return\n    existing = session.query(Review).filter(\n        Review.order_id == order.id,\n        Review.kind == "passenger_to_driver",\n    ).first()\n    if existing:\n        _finish_rating_prompt(session, order, False, "Оценка уже сохранена.")\n        return\n    stars = max(1, min(5, int(stars)))\n    _finish_rating_prompt(session, order, False, f"✅ Ваша оценка: {stars} из 5.")\n    order.rating = stars\n    review = Review(\n        order_id=order.id,\n        driver_id=order.driver_id,\n        passenger_id=user.id,\n        stars=stars,\n        text=None,\n        kind="passenger_to_driver",\n    )\n    session.add(review)\n    # Update the driver\'s aggregate rating.\n    if order.driver_id:\n        driver = session.get(User, order.driver_id)\n        if driver:\n            driver.rating_sum = (driver.rating_sum or 0) + stars\n            driver.rating_count = (driver.rating_count or 0) + 1\n    session.flush()\n    if stars < 5:\n        set_state(\n            session,\n            user.vk_id,\n            States.P_REVIEW_TEXT,\n            {"review_id": review.id, "order_id": order.id},\n            merge=False,\n        )\n        vk.send_message(\n            user.vk_id,\n            "Расскажите, пожалуйста, почему поставили меньше 5 звёзд. Комментарий можно пропустить.",\n            keyboard=kb.review_comment_keyboard(review.id),\n        )\n        return\n    vk.send_message(\n        user.vk_id,\n        "Спасибо за оценку! 🙏",\n        keyboard=kb.passenger_menu(can_switch_role(user), _passenger_labels(session)),\n    )\n    reset(session, user.vk_id, States.MAIN_MENU)\n\n\ndef passenger_review_comment_prompt(session: Session, user: User) -> None:\n    data = get_data(session, user.vk_id)\n    if not data.get("review_id"):\n        return show_main_menu(session, user)\n    vk.send_message(user.vk_id, "Напишите комментарий к оценке одним сообщением:")\n    set_state(session, user.vk_id, States.P_REVIEW_TEXT)\n\n\ndef _passenger_review_for_change(\n    session: Session,\n    user: User,\n    review_id,\n) -> Review | None:\n    """Return only the active passenger review from the current rating flow."""\n    try:\n        review_id = int(review_id)\n    except (TypeError, ValueError):\n        return None\n    data = get_data(session, user.vk_id)\n    try:\n        active_review_id = int(data.get("review_id") or 0)\n    except (TypeError, ValueError):\n        return None\n    if active_review_id != review_id:\n        return None\n    review = session.get(Review, review_id)\n    if (\n        review is None\n        or review.passenger_id != user.id\n        or review.kind != "passenger_to_driver"\n    ):\n        return None\n    return review\n\n\ndef passenger_review_rating_change(session: Session, user: User, review_id) -> None:\n    review = _passenger_review_for_change(session, user, review_id)\n    if review is None:\n        return show_main_menu(session, user)\n    vk.send_message(\n        user.vk_id,\n        "Выберите новую оценку от 1 до 5 звёзд:",\n        keyboard=kb.review_rating_keyboard(review.id),\n    )\n\n\ndef passenger_review_rating_set(\n    session: Session,\n    user: User,\n    review_id,\n    stars,\n) -> None:\n    review = _passenger_review_for_change(session, user, review_id)\n    if review is None:\n        return show_main_menu(session, user)\n    try:\n        stars = max(1, min(5, int(stars)))\n    except (TypeError, ValueError):\n        return passenger_review_rating_change(session, user, review.id)\n\n    old_stars = int(review.stars or 0)\n    review.stars = stars\n    order = session.get(Order, review.order_id) if review.order_id else None\n    if order and order.passenger_id == user.id:\n        order.rating = stars\n    driver = session.get(User, review.driver_id) if review.driver_id else None\n    if driver:\n        driver.rating_sum = max(0, int(driver.rating_sum or 0) + stars - old_stars)\n\n    if stars < 5:\n        set_state(\n            session,\n            user.vk_id,\n            States.P_REVIEW_TEXT,\n            {"review_id": review.id, "order_id": review.order_id},\n            merge=False,\n        )\n        vk.send_message(\n            user.vk_id,\n            f"✅ Оценка изменена: {stars} из 5. Хотите оставить комментарий?",\n            keyboard=kb.review_comment_keyboard(review.id),\n        )\n        return\n\n    vk.send_message(\n        user.vk_id,\n        "✅ Оценка изменена на 5 из 5. Спасибо за оценку! 🙏",\n        keyboard=kb.passenger_menu(can_switch_role(user), _passenger_labels(session)),\n    )\n    reset(session, user.vk_id, States.MAIN_MENU)\n\n\ndef save_review_text(session: Session, user: User, text: str) -> None:\n    data = get_data(session, user.vk_id)\n    review_id = data.get("review_id")\n    if review_id and text:\n        review = session.get(Review, review_id)\n        if review and review.passenger_id == user.id:\n            review.text = text\n    vk.send_message(user.vk_id, "Спасибо за отзыв! 🙏", keyboard=kb.passenger_menu(can_switch_role(user)))\n    reset(session, user.vk_id, States.MAIN_MENU)\n\n\ndef _ask_driver_rate_passenger(session: Session, user: User, order: Order) -> None:\n    """Offer an optional passenger rating without changing queue position."""\n    if delivery_service.is_partner_delivery(order):\n        # Legacy flow used: return lines.ask_post_ride_line(session, user)\n        # V131 keeps the already assigned tail position unchanged.\n        return\n    if not _is_dispatcher_order(order) and order.passenger_id:\n        passenger = session.get(User, order.passenger_id)\n        pname = (passenger.full_name if passenger else None) or "пассажира"\n        order.driver_rating_prompt_outbox_id = vk.send_tracked_message(\n            user.vk_id,\n            f"⭐ При желании оцените {pname} по поездке #{order.number}. Оценка не обязательна:",\n            keyboard=kb.passenger_rating_keyboard(order.id),\n        )\n        if order.driver_rating_prompt_outbox_id:\n            from . import rating_expiry_service\n            rating_expiry_service.schedule_expiry(order.id, driver_side=True)\n    # Rating never blocks the driver and never changes the queue position.\n\n\ndef driver_rate_passenger(session: Session, user: User, order_id: int, stars: int) -> None:\n    """Requirement 3: store a driver_to_passenger review and update the\n    passenger aggregate rating, then ask for an optional comment."""\n    order = (\n        session.query(Order)\n        .filter(Order.id == int(order_id))\n        .with_for_update()\n        .one_or_none()\n    )\n    if not order or order.driver_id != user.id:\n        return\n    if not order.driver_rating_prompt_outbox_id:\n        return\n    existing = session.query(Review).filter(\n        Review.order_id == order.id,\n        Review.kind == "driver_to_passenger",\n    ).first()\n    if existing:\n        _finish_rating_prompt(session, order, True, "Оценка уже сохранена.")\n        return\n    stars = max(1, min(5, int(stars)))\n    _finish_rating_prompt(session, order, True, f"✅ Ваша оценка: {stars} из 5.")\n    review = Review(\n        order_id=order.id,\n        driver_id=user.id,\n        passenger_id=order.passenger_id,\n        stars=stars,\n        text=None,\n        kind="driver_to_passenger",\n    )\n    session.add(review)\n    passenger = session.get(User, order.passenger_id) if order.passenger_id else None\n    if passenger:\n        passenger.passenger_rating_sum = (passenger.passenger_rating_sum or 0) + stars\n        passenger.passenger_rating_count = (passenger.passenger_rating_count or 0) + 1\n    session.flush()\n    vk.send_message(user.vk_id, "Спасибо за оценку! 🙏")\n\n\ndef save_driver_review_text(session: Session, user: User, text: str) -> None:\n    """Requirement 3: attach the optional driver comment, then continue."""\n    data = get_data(session, user.vk_id)\n    review_id = data.get("review_id")\n    if review_id and text:\n        review = session.get(Review, review_id)\n        if review and review.driver_id == user.id:\n            review.text = text\n    lines.ask_post_ride_line(session, user)\n\n\n# --------------------------------------------------------------------------- #\n#  Chat relay (passenger <-> driver)                                           #\n# --------------------------------------------------------------------------- #\ndef _vk_label(u: User) -> str:\n    return "[id%s|%s]" % (u.vk_id, u.full_name or ("id" + str(u.vk_id)))\n\n\ndef _order_requester_line(session: Session, order: Order) -> str:\n    """Return the requester shown to a driver after accepting an order."""\n    if _is_dispatcher_order(order):\n        return "🎧 Заявка от диспетчера"\n    passenger = session.get(User, order.passenger_id) if order.passenger_id else None\n    return f"Пассажир: {_vk_label(passenger)}" if passenger else "Пассажир: неизвестен"\n\n\ndef _vk_link(u: User) -> str:\n    return "https://vk.com/id%s" % u.vk_id\n\n\ndef share_contacts(session: Session, user: User, driver: bool) -> None:\n    """New requirement: instead of a relay chat, hand each side a direct VK link\n    to the other participant so they can message each other directly."""\n    order = active_order_for(session, user, as_driver=driver)\n    if not order:\n        return show_main_menu(session, user)\n    drv = session.get(User, order.driver_id) if order.driver_id else None\n    psg = session.get(User, order.passenger_id) if order.passenger_id else None\n    if driver:\n        if psg and not _is_dispatcher_order(order):\n            vk.send_message(user.vk_id, "\\U0001F464 Пассажир: %s\\n\\U0001F517 %s" % (_vk_label(psg), _vk_link(psg)))\n            vk.send_message(psg.vk_id, "\\U0001F697 Водитель: %s\\n\\U0001F517 %s" % (_vk_label(user), _vk_link(user)))\n        else:\n            vk.send_message(user.vk_id, "По этой заявке прямой контакт недоступен.")\n    else:\n        if drv:\n            vk.send_message(user.vk_id, "\\U0001F697 Водитель: %s\\n\\U0001F517 %s" % (_vk_label(drv), _vk_link(drv)))\n            vk.send_message(drv.vk_id, "\\U0001F464 Пассажир: %s\\n\\U0001F517 %s" % (_vk_label(user), _vk_link(user)))\n        else:\n            vk.send_message(user.vk_id, "Водитель ещё не назначен.")\n\n\ndef passenger_arrived_reply(\n    session: Session,\n    user: User,\n    action: str,\n    order_id=None,\n) -> None:\n    """Passenger reacts to the arrived menu (Выхожу / Подождать)."""\n    order = passenger_order_for(session, user, order_id)\n    if not order:\n        return show_main_menu(session, user)\n    driver = session.get(User, order.driver_id) if order.driver_id else None\n    if action == "going_out":\n        if driver:\n            vk.send_message(driver.vk_id, "\\U0001F6B6 Пассажир выходит.")\n        vk.send_message(\n            user.vk_id,\n            "Хорошо, водитель предупреждён.",\n            keyboard=kb.passenger_in_ride_keyboard(order.id),\n        )\n    else:\n        if driver:\n            vk.send_message(driver.vk_id, "\\u23F3 Пассажир просит подождать.")\n        vk.send_message(\n            user.vk_id,\n            "Водитель уведомлён: вы попросили его подождать.",\n            keyboard=kb.passenger_in_ride_keyboard(order.id),\n        )\n    # After either answer, keep only «Связь с водителем». Re-sending the\n    # arrived keyboard used to bring «Отменить заявку» back to the passenger.\n    set_state(session, user.vk_id, States.P_ARRIVED, {"order_id": order.id})\n\n\ndef driver_chat_order_for(session: Session, user: User, order_id=None) -> Order | None:\n    """An explicit chat binding wins over the driver\'s other (current) ride."""\n    if order_id is None:\n        return active_order_for(session, user, as_driver=True)\n    try:\n        order_id = int(order_id)\n    except (TypeError, ValueError):\n        return None\n    return (\n        session.query(Order)\n        .filter(\n            Order.id == order_id,\n            Order.status.in_(("assigned", "arrived", "in_progress", "parallel_assigned")),\n            (Order.driver_id == user.id) | (Order.parallel_driver_id == user.id),\n        )\n        .one_or_none()\n    )\n\n\ndef enter_chat(\n    session: Session,\n    user: User,\n    driver: bool,\n    order_id=None,\n) -> None:\n    order = (\n        driver_chat_order_for(session, user, order_id)\n        if driver else passenger_order_for(session, user, order_id)\n    )\n    if not order:\n        return show_main_menu(session, user)\n    vk.send_message(user.vk_id, "✉️ Напишите сообщение — бот отправит его собеседнику.")\n    set_state(\n        session,\n        user.vk_id,\n        States.D_CHAT if driver else States.P_CHAT,\n        {"order_id": order.id},\n    )\n\n\ndef exit_chat(session: Session, user: User, driver: bool) -> None:\n    saved_order_id = get_data(session, user.vk_id).get("order_id")\n    order = (\n        driver_chat_order_for(session, user, saved_order_id)\n        if driver else passenger_order_for(session, user, saved_order_id)\n    )\n    vk.send_message(user.vk_id, "Чат завершён.")\n    if order:\n        if driver and order.status == "parallel_assigned":\n            order = active_order_for(session, user, as_driver=True)\n        if order:\n            set_state(session, user.vk_id, States.D_IN_RIDE if driver else States.P_IN_RIDE, {"order_id": order.id})\n        else:\n            reset(session, user.vk_id, States.D_MENU if driver else States.MAIN_MENU)\n    else:\n        reset(session, user.vk_id, States.D_MENU if driver else States.MAIN_MENU)\n\n\ndef chat_forward(session: Session, user: User, text: str, attachments, driver: bool) -> None:\n    saved_order_id = get_data(session, user.vk_id).get("order_id")\n    order = (\n        driver_chat_order_for(session, user, saved_order_id)\n        if driver else passenger_order_for(session, user, saved_order_id)\n    )\n    if not order:\n        return show_main_menu(session, user)\n    # Do not replace the bottom keyboard after a client/driver chat message.\n    # «Добавить сообщение» and «Не писать» were removed from this flow.\n    if not relay(session, order, user, text, attachments, keyboard=None):\n        vk.send_message(user.vk_id, "Собеседник пока недоступен.")\n        return\n    vk.send_message(user.vk_id, "Сообщение отправлено.")\n\n\ndef dispatcher_reply_start(session: Session, user: User, order_id) -> None:\n    order = (\n        session.query(Order)\n        .filter(Order.id == int(order_id or 0), Order.dispatcher_id == user.id)\n        .one_or_none()\n    )\n    if not order or not (order.driver_id or order.parallel_driver_id) or order.status in ("cancelled", "completed"):\n        return vk.send_message(user.vk_id, "Эта заявка уже недоступна для ответа.")\n    set_state(\n        session,\n        user.vk_id,\n        States.DISP_CHAT_REPLY,\n        {"order_id": order.id},\n        merge=False,\n    )\n    vk.send_message(user.vk_id, f"Напишите ответ водителю по заявке #{order.number}.")\n\n\ndef dispatcher_reply_send(session: Session, user: User, text: str, attachments) -> None:\n    order_id = get_data(session, user.vk_id).get("order_id")\n    order = (\n        session.query(Order)\n        .filter(Order.id == int(order_id or 0), Order.dispatcher_id == user.id)\n        .one_or_none()\n    )\n    if not order or not (order.driver_id or order.parallel_driver_id) or order.status in ("cancelled", "completed"):\n        reset(session, user.vk_id, States.DISP_MENU)\n        return vk.send_message(user.vk_id, "Эта заявка уже недоступна для ответа.")\n    if not relay(session, order, user, text, attachments, keyboard=None):\n        return vk.send_message(user.vk_id, "Водитель пока недоступен.")\n    reset(session, user.vk_id, States.DISP_MENU)\n    vk.send_message(\n        user.vk_id,\n        f"Ответ по заявке #{order.number} отправлен водителю.",\n        keyboard=kb.dispatcher_menu(can_switch_role(user)),\n    )\n\n\n# --------------------------------------------------------------------------- #\n#  Driver flow                                                                 #\n# --------------------------------------------------------------------------- #\ndef handle_driver(session, user, state, text, payload, attachments):\n    cmd = payload.get("cmd")\n\n    pending_offer = offered_order_for(session, user)\n    current_order = active_order_for(session, user, as_driver=True)\n    if pending_offer and current_order:\n        if _release_stale_offer_for_active_ride(\n            session, user, pending_offer, current_order\n        ):\n            pending_offer = None\n\n    # Plain text while the fare prompt is active completes the ride. Buttons\n    # remain usable: a driver may open the price list, inspect parallel orders\n    # or cancel the trip before finally entering the amount.\n    if state == States.D_FINISH_PRICE and not cmd:\n        return driver_complete_ride(session, user, text)\n    # A typed counter-offer is a driver-owned input and must be handled before\n    # the ordinary offer lock. Otherwise the live offer interprets the amount\n    # as an unrelated menu action and the driver sees no result.\n    if state == States.D_CUSTOM_PRICE and not cmd:\n        return customer_price_service.submit(session, user, text)\n    if state == States.D_OFFER_ETA and not cmd:\n        return accept_offer_eta(session, user, get_data(session, user.vk_id).get("order_id"), text)\n    if state == States.D_BLACKLIST_ADD and (cmd == "start" or text.casefold().strip() in ("меню", "начать", "/start", "start")):\n        reset(session, user.vk_id, States.D_MENU)\n        return show_main_menu(session, user)\n\n    # Do not let an expired, already-idle «Суточник» rejoin the line during\n    # the worker\'s short polling interval. Active/offered rides are deferred.\n    if temporary_driver_service.expire_driver_if_due(session, user):\n        return\n\n    if pending_offer and cmd not in _DRIVER_OFFER_ALLOWED_CMDS:\n        return _driver_offer_lock_notice(session, user, pending_offer)\n\n    if cmd == "cancel_flow" and state in (\n        States.D_PAYMENT_TYPE,\n        States.D_PAYMENT_PHONE,\n        States.D_PAYMENT_CARD,\n        States.D_PAYMENT_BANK,\n        States.D_PAYMENT_RECIPIENT,\n    ):\n        return driver_payment_cancel(session, user)\n\n    # Requirement 4: lock menu navigation while the driver has an active order.\n    if cmd in _DRIVER_MENU_CMDS and active_order_for(session, user, as_driver=True):\n        return _menu_lock_notice(session, user)\n\n    if cmd == "driver_online":\n        return driver_go_online(session, user)\n    if cmd == "bookings_taken":\n        return driver_show_taken_bookings(session, user)\n    if cmd == "booking_take":\n        return driver_take_booking(session, user, payload.get("booking_id"))\n    if cmd == "booking_driver_cancel":\n        return driver_cancel_booking(session, user, payload.get("booking_id"))\n    if cmd == "booking_depart":\n        return driver_depart_booking(session, user, payload.get("booking_id"))\n    if cmd == "booking_driver_back":\n        return show_main_menu(session, user)\n    if cmd == "driver_offline":\n        return driver_go_offline(session, user)\n    if cmd == "who_online":\n        return show_who_on_line(session, user)\n    if cmd == "decline":\n        return driver_decline_prompt(session, user, payload["order_id"])\n    if cmd == "decline_reason":\n        return driver_decline(session, user, payload["order_id"], payload.get("cat"))\n    if cmd == "decline_back":\n        return driver_decline_back(session, user, payload.get("order_id"))\n    if cmd == "choose_line":\n        return lines.show_line_menu(session, user)\n    if cmd == "set_line":\n        return lines.set_driver_line(session, user, payload.get("city_id"))\n    if cmd == "leave_line":\n        # Release a passenger\'s 90-second personal hold both before and after\n        # the canonical queue deletion.  The second pass closes the tiny race\n        # where a passenger clicked the driver at the same moment they left.\n        cancel_direct_selection_for_driver(session, user)\n        lines.leave_line(session, user)\n        cancel_direct_selection_for_driver(session, user)\n        return\n    if cmd == "stay_line":\n        return lines.stay_line(session, user)\n    if cmd == "change_line":\n        return lines.show_line_menu(session, user)\n    if cmd == "contact_dispatcher":\n        return driver_contact_dispatcher(session, user)\n    if cmd == "blacklist":\n        return show_blacklist(session, user)\n    if cmd == "blacklist_add":\n        set_state(session, user.vk_id, States.D_BLACKLIST_ADD, {}, merge=False)\n        return vk.send_message(user.vk_id, "Пришлите ссылку на страницу клиента в VK (https://vk.ru/id123 или короткое имя).",\n                               keyboard=kb.blacklist_menu())\n    if cmd == "blacklist_remove_menu":\n        return show_blacklist_remove(session, user, payload.get("page", 1))\n    if cmd == "blacklist_remove":\n        return remove_blacklist(session, user, payload.get("vk_id"), payload.get("page", 1))\n    if cmd == "blacklist_close":\n        close_blacklist_remove(session, user)\n        return show_blacklist(session, user)\n    if cmd == "blacklist_rating":\n        return blacklist_from_rating(session, user, payload.get("order_id"))\n    if cmd == "offer_eta":\n        return accept_offer_eta(session, user, payload.get("order_id"), payload.get("minutes"))\n    if cmd == "offer_eta_custom":\n        return offer_eta_custom(session, user, payload.get("order_id"))\n    if state == States.D_BLACKLIST_ADD and not cmd:\n        return add_blacklist_link(session, user, text)\n\n\n    if cmd == "rate_passenger":\n        return driver_rate_passenger(session, user, payload["order_id"], payload["stars"])\n    if cmd == "skip_rate_passenger":\n        return driver_skip_passenger_rating(session, user, payload.get("order_id"))\n    if cmd == "skip" and state == States.D_RATE_PASSENGER_TEXT:\n        return lines.ask_post_ride_line(session, user)\n    if cmd == "driver_away":\n        return driver_go_away(session, user)\n    if cmd == "driver_settings":\n        return driver_show_settings(session, user)\n    if cmd == "driver_gender":\n        return driver_gender_prompt(session, user, return_to="settings")\n    if cmd == "set_driver_gender":\n        return driver_set_gender(session, user, payload.get("gender"))\n    if cmd == "driver_settings_back":\n        return show_main_menu(session, user)\n    if cmd == "payment_details":\n        return driver_payment_start(session, user)\n    if cmd == "payment_method":\n        return driver_payment_method(session, user, payload.get("type"))\n    if cmd == "payment_recipient_skip":\n        return driver_payment_recipient(session, user, "")\n    if cmd == "payment_toggle":\n        return driver_payment_toggle(session, user)\n    if cmd == "shortage_notice_toggle":\n        return driver_shortage_notice_toggle(session, user)\n    if cmd == "driver_car":\n        return driver_edit_car(session, user)\n    if cmd == "queue":\n        return show_queue(session, user)\n    if cmd == "driver_info":\n        return show_driver_info(session, user)\n    if cmd == "pending_orders":\n        return show_pending_orders(session, user, payload.get("page", 1))\n    if cmd == "pending_take":\n        return driver_take_pending(session, user, payload.get("order_id"))\n    if cmd == "earnings":\n        return show_earnings(session, user)\n    if cmd == "reviews":\n        return show_my_reviews(session, user)\n    if cmd == "connect_driver_app":\n        return show_driver_app_pair_code(session, user)\n    if cmd == "price":\n        return show_price(session, user)\n    if cmd == "price_section":\n        return show_price_section(session, user, payload.get("key"))\n    if cmd == "price_calculate":\n        return retired_price_calculator(session, user)\n    if cmd == "price_back":\n        return return_from_price(session, user)\n    if cmd == "propose_price":\n        return customer_price_service.start_from_private_offer(\n            session, user, payload.get("order_id")\n        )\n    if cmd == "accept":\n        return offer_eta_custom_or_menu(session, user, payload.get("order_id"))\n    if cmd == "set_eta":\n        return driver_show_eta_menu(session, user)\n    if cmd == "eta_pick":\n        return driver_pick_eta(session, user, payload.get("minutes"))\n    if cmd == "eta_custom":\n        return driver_eta_custom(session, user)\n    if cmd == "eta_add_menu":\n        return driver_eta_add_menu(session, user)\n    if cmd == "eta_add":\n        return driver_add_eta(session, user, payload.get("minutes"))\n    if cmd == "eta_add_custom":\n        return driver_eta_add_custom(session, user)\n    if cmd == "car_edit":\n        return _start_car_input(session, user)\n    if cmd == "car_back":\n        return driver_show_settings(session, user)\n    if cmd == "arrived":\n        return driver_arrived(session, user)\n    if cmd == "seated":\n        return driver_seated(session, user)\n    if cmd == "bought":\n        return driver_bought(session, user)\n    if cmd == "finish":\n        return driver_finish_prompt(session, user)\n    if cmd == "driver_cancel_active":\n        return vk.send_message(user.vk_id, "Выберите причину отмены:", keyboard=kb.driver_active_cancel_keyboard())\n    if cmd == "driver_cancel_back":\n        return driver_cancel_back(session, user)\n    if cmd == "driver_cancel_no_show":\n        return driver_cancel_active(session, user, "no_show")\n    if cmd == "driver_cancel_customer":\n        return driver_cancel_active(session, user, "customer_cancel")\n    if cmd == "driver_cancel_no_false_call":\n        return driver_cancel_active(session, user, "no_false_call")\n    if cmd == "driver_cancel_car":\n        return driver_cancel_active(session, user, "car")\n    if cmd == "chat_take":\n        return driver_take_from_chat(session, user, payload.get("order_id"))\n    if cmd == "chat_depart":\n        return driver_depart_from_chat_order(session, user, payload.get("order_id"))\n    if cmd == "chat_add":\n        return enter_chat(session, user, driver=True, order_id=payload.get("order_id"))\n    if cmd == "chat_stop":\n        return exit_chat(session, user, driver=True)\n    if cmd == "chat":\n        return enter_chat(session, user, driver=True, order_id=payload.get("order_id"))\n    if cmd == "exit_chat":\n        return exit_chat(session, user, driver=True)\n    if cmd == "fake_calls":\n        return fake_calls_service.show_driver_list(session, user)\n    if cmd == "driver_statistics":\n        return show_driver_statistics(session, user)\n    if cmd == "fake_paid":\n        return fake_calls_service.mark_paid(session, user, payload.get("fc_id"))\n    if cmd == "waiting_start":\n        return driver_waiting_start(session, user)\n    if cmd == "send_payment_details":\n        return driver_send_payment_details(session, user)\n    if cmd == "waiting_stop":\n        return driver_waiting_stop(session, user)\n    if cmd == "parallel_orders":\n        from . import parallel_orders\n        current = active_order_for(session, user, as_driver=True)\n        return parallel_orders.show(session, user, current, payload.get("page", 1)) if current else show_main_menu(session, user)\n    if cmd == "parallel_back":\n        return driver_return_to_active(session, user)\n    if cmd == "parallel_take":\n        from . import parallel_orders\n        return parallel_orders.take(session, user, payload.get("order_id"))\n    if cmd == "route_parallel_take":\n        from . import parallel_orders\n        return parallel_orders.take_route_offer(session, user, payload.get("order_id"))\n    if cmd == "parallel_route_decline":\n        from . import parallel_orders\n        return parallel_orders.decline_route_offer(session, user, payload.get("order_id"))\n    if cmd == "parallel_eta":\n        from . import parallel_orders\n        return parallel_orders.save_eta(session, user, payload.get("order_id"), payload.get("minutes"))\n    if cmd == "parallel_eta_custom":\n        set_state(session, user.vk_id, States.D_PARALLEL_ETA,\n                  {"parallel_order_id": payload.get("order_id")})\n        return vk.send_message(user.vk_id, "Введите время в минутах:")\n    if cmd == "parallel_eta_add":\n        set_state(session, user.vk_id, States.D_PARALLEL_ETA_ADD,\n                  {"parallel_order_id": payload.get("order_id")})\n        return vk.send_message(\n            user.vk_id,\n            "Введите, сколько минут добавить к времени подачи автомобиля:",\n        )\n    if cmd == "parallel_decline":\n        from . import parallel_orders\n        return parallel_orders.decline(session, user, payload.get("order_id"))\n\n    # State-driven text input\n    if state == States.D_DELIVERY_PRICE:\n        return delivery_service.submit_price(session, user, text)\n    if state == States.D_CAR_MODEL:\n        return driver_set_car_model(session, user, text)\n    if state == States.D_CAR_COLOR:\n        return driver_set_car_color(session, user, text)\n    if state == States.D_CAR_NUMBER:\n        return driver_set_car_number(session, user, text)\n    if state == States.D_PAYMENT_PHONE:\n        return driver_payment_phone(session, user, text)\n    if state == States.D_PAYMENT_CARD:\n        return driver_payment_card(session, user, text)\n    if state == States.D_PAYMENT_BANK:\n        return driver_payment_bank(session, user, text)\n    if state == States.D_PAYMENT_RECIPIENT:\n        return driver_payment_recipient(session, user, text)\n    if state == States.D_ETA:\n        return driver_set_eta(session, user, text)\n    if state == States.D_ETA_ADD:\n        return driver_add_eta(session, user, text)\n    if state == States.D_RATE_PASSENGER_TEXT:\n        return save_driver_review_text(session, user, text)\n    if state == States.D_CHAT:\n        return chat_forward(session, user, text, attachments, driver=True)\n    if state == States.D_PARALLEL_ETA:\n        from . import parallel_orders\n        try:\n            minutes = int((text or "").strip())\n        except ValueError:\n            return vk.send_message(user.vk_id, "Введите целое количество минут:")\n        return parallel_orders.save_eta(\n            session, user, get_data(session, user.vk_id).get("parallel_order_id"), minutes\n        )\n    if state == "passenger_price_calc_route":\n        return retired_price_calculator(session, user)\n    if state == States.D_PARALLEL_ETA_ADD:\n        from . import parallel_orders\n        try:\n            minutes = int((text or "").strip())\n        except ValueError:\n            return vk.send_message(user.vk_id, "Введите целое количество минут:")\n        return parallel_orders.add_eta(\n            session,\n            user,\n            get_data(session, user.vk_id).get("parallel_order_id"),\n            minutes,\n        )\n\n    active = active_order_for(session, user, as_driver=True)\n    if active:\n        if text or attachments:\n            # Commands are handled above. Any remaining text during an active\n            # ride is a chat message, even if the explicit D_CHAT state was\n            # lost.\n            return chat_forward(session, user, text, attachments, driver=True)\n        # A stale or unknown button must never fall through to the ordinary\n        # driver menu and replace the persistent active-order controls.\n        return driver_return_to_active(session, user)\n\n    return show_main_menu(session, user)\n\n\ndef show_who_on_line(session: Session, user: User) -> None:\n    """Show «Кто на линии?» in the canonical driver-queue format."""\n    return show_queue(session, user)\n\n\ndef driver_go_online(session: Session, user: User) -> None:\n    # Req 1.1: going online requires a chosen line.\n    if not user.current_line:\n        return lines.show_line_menu(session, user)\n    # New requirement: car details must be filled before going on line.\n    if not lines.has_complete_car(user):\n        vk.send_message(\n            user.vk_id,\n            "🚗 Сначала полностью заполните «Моя машина»: марка, цвет и госномер.",\n            keyboard=kb.driver_menu(on_line=False, show_role_switch=can_switch_role(user)),\n        )\n        return\n    if user.driver_status == "away":\n        queue_service.return_from_away(session, user)\n    else:\n        queue_service.join_queue(session, user, lines.city_id_by_name(session, user.current_line))\n    user.is_on_line = True\n    session.flush()\n    rank = queue_service.driver_line_rank(session, user) or queue_service.driver_queue_rank(session, user)\n    vk.send_message(\n        user.vk_id,\n        f"✅ Вы на линии! Ваше место в очереди: {rank or 1}.",\n        keyboard=kb.driver_menu(on_line=True, show_role_switch=can_switch_role(user)),\n    )\n    set_state(session, user.vk_id, States.D_MENU)\n    # A driver just became free — maybe a waiting passenger can be served now.\n    passenger_queue.try_promote(session)\n\n\ndef _cancel_direct_offer_for_unavailable_driver(\n    session: Session, order: Order, driver: User\n) -> None:\n    """Close a personal offer when its chosen driver leaves; never requeue it."""\n    timers.cancel("accept", order.id)\n    order_service.add_decline(session, order, driver.id, "away")\n    order_service.clear_current_offer(session, order)\n    order.status = "cancelled"\n    order.cancelled_at = time_utils.now()\n    order.cancelled_by = "driver"\n    passenger = session.get(User, order.passenger_id)\n    if passenger:\n        reset(session, passenger.vk_id, States.MAIN_MENU)\n        vk.send_message(\n            passenger.vk_id,\n            "Выбранный водитель больше не может рассмотреть заявку. "\n            "Она не передавалась другим водителям.",\n            keyboard=kb.direct_driver_unavailable_keyboard(),\n        )\n\n\ndef driver_go_offline(session: Session, user: User) -> None:\n    cancel_direct_selection_for_driver(session, user)\n    # Immediately pass on an unanswered offer instead of leaving it stuck until\n    # the admin-configured timeout.\n    data = get_data(session, user.vk_id)\n    pending = (\n        session.query(Order)\n        .filter(Order.id == data.get("order_id"))\n        .with_for_update()\n        .one_or_none()\n        if data.get("order_id") else None\n    )\n    reassign = bool(pending and pending.status == "searching"\n                    and order_service._current_offer(session, pending) == user.id)\n    direct_cancelled = bool(reassign and pending.requested_driver_id)\n    if direct_cancelled:\n        _cancel_direct_offer_for_unavailable_driver(session, pending, user)\n    elif reassign:\n        timers.cancel("accept", pending.id)\n        order_service.add_decline(session, pending, user.id, "away")\n    queue_service.leave_queue(session, user)\n    # A concurrent passenger selection that committed while departure waited\n    # on the queue row must not survive the offline transition.\n    cancel_direct_selection_for_driver(session, user)\n    user.is_on_line = False\n    if reassign and not direct_cancelled:\n        order_service.clear_current_offer(session, pending)\n        pending.status = "searching"\n        session.flush()\n        order_service.offer_to_next_driver(session, pending)\n    vk.send_message(\n        user.vk_id,\n        "🛡 Вы ушли с линии.",\n        keyboard=kb.driver_menu(on_line=False, show_role_switch=can_switch_role(user)),\n    )\n    set_state(session, user.vk_id, States.D_MENU)\n\n\ndef driver_go_away(session: Session, user: User) -> None:\n    cancel_direct_selection_for_driver(session, user)\n    # If an order is currently being offered to this driver, pass it on to the\n    # next driver in the queue before stepping away.\n    data = get_data(session, user.vk_id)\n    oid = data.get("order_id")\n    pending = (\n        session.query(Order)\n        .filter(Order.id == oid)\n        .with_for_update()\n        .one_or_none()\n        if oid else None\n    )\n    reassign = bool(\n        pending\n        and pending.status in ("searching", "created")\n        and order_service._current_offer(session, pending) == user.id\n    )\n    queue_service.set_away(session, user)\n    vk.send_message(\n        user.vk_id,\n        "\\u2615 Вы отлучились. Заявки не поступают, пока не вернётесь.",\n        keyboard=kb.driver_away_menu(show_role_switch=can_switch_role(user)),\n    )\n    set_state(session, user.vk_id, States.D_MENU)\n    if reassign and pending.requested_driver_id:\n        _cancel_direct_offer_for_unavailable_driver(session, pending, user)\n    elif reassign:\n        timers.cancel("accept", pending.id)\n        order_service.add_decline(session, pending, user.id, "away")\n        pending.driver_id = None\n        order_service.clear_current_offer(session, pending)\n        pending.status = "searching"\n        session.flush()\n        order_service.offer_to_next_driver(session, pending)\n\n\ndef driver_gender_prompt(session: Session, user: User, return_to: str = "menu") -> None:\n    """Ask once and remember the driver\'s grammatical gender."""\n    vk.send_message(\n        user.vk_id,\n        "VK не указал пол в профиле. Выберите вариант вручную — бот запомнит его для кнопки прибытия:",\n        keyboard=kb.driver_gender_keyboard(),\n    )\n    set_state(session, user.vk_id, States.D_GENDER, {"return_to": return_to}, merge=False)\n\n\ndef driver_set_gender(session: Session, user: User, gender: str | None) -> None:\n    if gender not in ("male", "female"):\n        return driver_gender_prompt(session, user)\n    return_to = get_data(session, user.vk_id).get("return_to")\n    user.driver_gender = gender\n    label = "мужской" if gender == "male" else "женский"\n    vk.send_message(user.vk_id, f"Пол сохранён: {label}.")\n    if return_to == "settings":\n        return driver_show_settings(session, user)\n    return show_main_menu(session, user)\n\n\ndef driver_show_settings(session: Session, user: User) -> None:\n    status = "включён" if user.show_payment_details else "выключен"\n    vk.send_message(user.vk_id, f"⚙ Настройки водителя. Показ реквизитов: {status}.", keyboard=kb.driver_settings_keyboard(bool(user.show_payment_details), user.driver_gender, bool(getattr(user, "shortage_notice_enabled", False))))\n    set_state(session, user.vk_id, States.D_SETTINGS)\n\n\n\ndef driver_shortage_notice_toggle(session: Session, user: User) -> None:\n    # Lock against the reconciliation worker, including an overlapping toggle.\n    session.flush()\n    session.refresh(user, with_for_update=True)\n    user.shortage_notice_enabled = not bool(user.shortage_notice_enabled)\n    if not user.shortage_notice_enabled and user.shortage_notice_outbox_id:\n        from . import outbox_service\n        outbox_service.cancel_or_delete(session, user.shortage_notice_outbox_id)\n        user.shortage_notice_outbox_id = None\n    driver_show_settings(session, user)\n\n\ndef driver_payment_start(session: Session, user: User) -> None:\n    vk.send_message(user.vk_id, "Переводить будете по номеру карты или по номеру телефона?", keyboard=kb.payment_method_keyboard())\n    # Keep edits in the FSM draft. Existing working requisites are not touched\n    # until the final «Пропустить»/ФИО step is completed.\n    set_state(\n        session,\n        user.vk_id,\n        States.D_PAYMENT_TYPE,\n        {"payment_draft": {}},\n        merge=False,\n    )\n\n\ndef driver_payment_method(session: Session, user: User, payment_type: str | None) -> None:\n    if payment_type not in ("phone", "card"):\n        return driver_payment_start(session, user)\n    draft = {"type": payment_type}\n    if payment_type == "phone":\n        vk.send_message(user.vk_id, "Введите номер телефона для перевода:", keyboard=kb.cancel_keyboard())\n        set_state(\n            session,\n            user.vk_id,\n            States.D_PAYMENT_PHONE,\n            {"payment_draft": draft},\n            merge=False,\n        )\n    else:\n        vk.send_message(user.vk_id, "Введите номер карты:", keyboard=kb.cancel_keyboard())\n        set_state(\n            session,\n            user.vk_id,\n            States.D_PAYMENT_CARD,\n            {"payment_draft": draft},\n            merge=False,\n        )\n\n\ndef driver_payment_phone(session: Session, user: User, text: str) -> None:\n    value = (text or "").strip()\n    if not value:\n        return vk.send_message(user.vk_id, "Введите номер телефона:")\n    draft = dict(get_data(session, user.vk_id).get("payment_draft") or {})\n    draft.update({"type": "phone", "phone": value})\n    vk.send_message(user.vk_id, "Введите название банка:", keyboard=kb.cancel_keyboard())\n    set_state(\n        session,\n        user.vk_id,\n        States.D_PAYMENT_BANK,\n        {"payment_draft": draft},\n        merge=False,\n    )\n\n\ndef driver_payment_card(session: Session, user: User, text: str) -> None:\n    value = "".join(ch for ch in (text or "") if ch.isdigit())\n    if len(value) < 12 or len(value) > 19:\n        return vk.send_message(user.vk_id, "Введите корректный номер карты (12–19 цифр):")\n    draft = dict(get_data(session, user.vk_id).get("payment_draft") or {})\n    draft.update({"type": "card", "card": value})\n    vk.send_message(user.vk_id, "Введите ФИО получателя (можно пропустить):", keyboard=kb.payment_recipient_keyboard())\n    set_state(\n        session,\n        user.vk_id,\n        States.D_PAYMENT_RECIPIENT,\n        {"payment_draft": draft},\n        merge=False,\n    )\n\n\ndef driver_payment_bank(session: Session, user: User, text: str) -> None:\n    if not (text or "").strip():\n        return vk.send_message(user.vk_id, "Введите название банка:")\n    draft = dict(get_data(session, user.vk_id).get("payment_draft") or {})\n    bank = " ".join((text or "").split())\n    # The output already adds the word «банк»; avoid «банк Банк Сбербанк».\n    bank = re.sub(r"^(?:банк\\s*[:—–-]?\\s*)+", "", bank, flags=re.IGNORECASE).strip() or bank\n    draft.update({"type": "phone", "bank": bank})\n    vk.send_message(user.vk_id, "Введите ФИО получателя (можно пропустить):", keyboard=kb.payment_recipient_keyboard())\n    set_state(\n        session,\n        user.vk_id,\n        States.D_PAYMENT_RECIPIENT,\n        {"payment_draft": draft},\n        merge=False,\n    )\n\n\ndef driver_payment_recipient(session: Session, user: User, text: str) -> None:\n    draft = dict(get_data(session, user.vk_id).get("payment_draft") or {})\n    payment_type = draft.get("type")\n    if payment_type == "phone":\n        phone = (draft.get("phone") or "").strip()\n        bank = (draft.get("bank") or "").strip()\n        if not phone or not bank:\n            return driver_payment_start(session, user)\n        user.payment_type = "phone"\n        user.payment_phone = phone\n        user.payment_bank = bank\n        user.payment_card = None\n    elif payment_type == "card":\n        card = (draft.get("card") or "").strip()\n        if not card:\n            return driver_payment_start(session, user)\n        user.payment_type = "card"\n        user.payment_card = card\n        user.payment_phone = None\n        user.payment_bank = None\n    else:\n        return driver_payment_start(session, user)\n    user.payment_recipient = (text or "").strip() or None\n    user.show_payment_details = False\n    vk.send_message(user.vk_id, "Реквизиты сохранены. Показ реквизитов пока выключен.", keyboard=kb.driver_settings_keyboard(False, user.driver_gender, bool(getattr(user, "shortage_notice_enabled", False))))\n    set_state(session, user.vk_id, States.D_SETTINGS, {}, merge=False)\n\n\ndef driver_payment_cancel(session: Session, user: User) -> None:\n    """Discard the draft without changing previously saved requisites."""\n    vk.send_message(\n        user.vk_id,\n        "Ввод реквизитов отменён. Сохранённые реквизиты не изменены.",\n        keyboard=kb.driver_settings_keyboard(bool(user.show_payment_details), user.driver_gender, bool(getattr(user, "shortage_notice_enabled", False))),\n    )\n    set_state(session, user.vk_id, States.D_SETTINGS, {}, merge=False)\n\n\ndef _payment_details_ready(user: User) -> bool:\n    if user.payment_type == "card":\n        return bool(user.payment_card)\n    return bool(user.payment_phone and user.payment_bank)\n\n\ndef driver_payment_toggle(session: Session, user: User) -> None:\n    if not _payment_details_ready(user):\n        vk.send_message(user.vk_id, "Сначала заполните реквизиты.", keyboard=kb.driver_settings_keyboard(False, user.driver_gender, bool(getattr(user, "shortage_notice_enabled", False))))\n        return\n    user.show_payment_details = not bool(user.show_payment_details)\n    state = "включён" if user.show_payment_details else "выключен"\n    vk.send_message(user.vk_id, f"Показ реквизитов {state}.", keyboard=kb.driver_settings_keyboard(bool(user.show_payment_details), user.driver_gender, bool(getattr(user, "shortage_notice_enabled", False))))\n    set_state(session, user.vk_id, States.D_SETTINGS)\n\n\ndef driver_edit_car(session: Session, user: User) -> None:\n    """Requirement 5: if a car is already saved, confirm before re-entering it."""\n    if user.car_full and user.car_full != "—":\n        set_state(session, user.vk_id, States.D_CAR_CONFIRM)\n        vk.send_message(\n            user.vk_id,\n            msg(session, "msg_car_edit_confirm", car=user.car_full),\n            keyboard=kb.car_edit_keyboard(\n                button_label(session, "btn_car_edit", "✏️ Отредактировать авто"),\n                button_label(session, "btn_car_back", "◀️ Вернуться в главное меню"),\n            ),\n        )\n        return\n    _start_car_input(session, user)\n\n\ndef _start_car_input(session: Session, user: User) -> None:\n    vk.send_message(user.vk_id, msg(session, "msg_car_ask_model"))\n    set_state(session, user.vk_id, States.D_CAR_MODEL)\n\n\ndef driver_set_car_model(session: Session, user: User, text: str) -> None:\n    if not text:\n        return vk.send_message(user.vk_id, msg(session, "msg_car_ask_model"))\n    user.car_model = text\n    vk.send_message(user.vk_id, msg(session, "msg_car_ask_color"))\n    set_state(session, user.vk_id, States.D_CAR_COLOR)\n\n\ndef driver_set_car_color(session: Session, user: User, text: str) -> None:\n    if not text:\n        return vk.send_message(user.vk_id, msg(session, "msg_car_ask_color"))\n    user.car_color = text\n    vk.send_message(user.vk_id, msg(session, "msg_car_ask_number"))\n    set_state(session, user.vk_id, States.D_CAR_NUMBER)\n\n\ndef driver_set_car_number(session: Session, user: User, text: str) -> None:\n    if not text:\n        return vk.send_message(user.vk_id, "Введите госномер автомобиля:")\n    user.car_number = text\n    vk.send_message(\n        user.vk_id,\n        f"✅ Автомобиль сохранён:\\n🚗 {user.car_full}",\n        keyboard=kb.driver_menu(on_line=user.driver_status != "offline", show_role_switch=can_switch_role(user)),\n    )\n    set_state(session, user.vk_id, States.D_MENU)\n\n\ndef show_queue(session: Session, user: User, dispatcher_view: bool = False) -> None:\n    """Show the canonical driver queue to a driver or dispatcher."""\n    queue_service._notify_fronts(session)\n    entries = queue_service.queue_entries(session)\n    rank = queue_service.driver_line_rank(session, user, entries=entries)\n    city_names = {city.id: city.name for city in session.query(City).all()}\n    own_entry = next((item for item in entries if item["driver"].id == user.id), None)\n    own_line = city_names.get(own_entry["city_id"]) if own_entry else None\n    live_statuses = {item["driver"].id: item["live_status"] for item in entries}\n    lines = []\n    current_live_status = live_statuses.get(user.id)\n    if not dispatcher_view:\n        if current_live_status == "considering":\n            lines.append("🟠 Вы сейчас рассматриваете заявку. Другие заявки вам не назначаются.\\n")\n        elif rank:\n            lines.append(f"📍 Ваше место на линии «{own_line or user.current_line or \'Линия не указана\'}»: {rank}\\n")\n        else:\n            lines.append("Вы сейчас не в числе свободных (на заявке или отлучились).\\n")\n    if not entries:\n        lines.append("Сейчас нет водителей на линии.")\n    else:\n        driver_ids = [item["driver"].id for item in entries]\n        active_orders = _active_orders_by_driver(session, driver_ids)\n        passenger_details = (\n            _dispatcher_passenger_details(session, active_orders)\n            if dispatcher_view else {}\n        )\n        status_items = []\n        for i, item in enumerate(entries, start=1):\n            d = item["driver"]\n            queue_status = item["status"]\n            live_status = live_statuses.get(d.id, "offline")\n            if live_status == "busy" or queue_status == "assigned":\n                display_status = "busy"\n            elif live_status == "considering" or queue_status == "offered":\n                display_status = "considering"\n            elif live_status == "away" or queue_status == "away":\n                display_status = "away"\n            elif live_status == "offline":\n                continue\n            else:\n                display_status = "online"\n            passenger_label, order_id = passenger_details.get(d.id, (None, None))\n            status_items.append({\n                "driver": d,\n                "status": display_status,\n                "order": active_orders.get(d.id),\n                "position": i,\n                "line_name": city_names.get(item["city_id"], "Линия не указана"),\n                "passenger_label": passenger_label,\n                "order_id": order_id,\n            })\n        if not status_items:\n            lines.append("Сейчас нет водителей на линии.")\n        lines.extend(_render_driver_statuses(\n            status_items,\n            current_driver_id=None if dispatcher_view else user.id,\n            numbered=True,\n            show_rating=True,\n            show_passenger_details=dispatcher_view,\n            group_free_by_line=True,\n        ))\n    if dispatcher_view:\n        keyboard = kb.dispatcher_menu(can_switch_role(user))\n    else:\n        on_line = user.driver_status in ("online", "busy")\n        keyboard = kb.driver_away_menu(can_switch_role(user)) if user.driver_status == "away" \\\n            else kb.driver_menu(on_line, can_switch_role(user))\n    vk.send_message(user.vk_id, "\\n".join(lines), keyboard=keyboard)\n\n\ndef show_driver_info(session: Session, user: User) -> None:\n    close_blacklist_remove(session, user)\n    reset(session, user.vk_id, States.D_MENU)\n    """Show the saved car, payment details and review summary."""\n    car = user.car_full if user.car_full and user.car_full != "—" else "не указано"\n    payment = _payment_details_text(user) if _payment_details_ready(user) else "не указаны"\n    review_count = int(user.rating_count or 0)\n    average_rating = (\n        round(float(user.rating_sum or 0) / review_count, 2)\n        if review_count else 0.0\n    )\n    vk.send_message(\n        user.vk_id,\n        "📋 Мои сведения:\\n\\n"\n        f"🚗 Авто: {car}\\n"\n        f"💳 Реквизиты: {payment}\\n"\n        f"⭐ Отзывы: средняя оценка {average_rating:.2f}, количество — {review_count}",\n        keyboard=kb.driver_info_menu(),\n    )\n\n\ndef show_driver_app_pair_code(session: Session, user: User) -> None:\n    """Issue a one-time six-digit app pairing code valid for ten minutes."""\n    now = time_utils.now()\n    session.query(DriverAppPairCode).filter(\n        DriverAppPairCode.driver_id == user.id,\n        DriverAppPairCode.used_at.is_(None),\n    ).delete(synchronize_session=False)\n    for _ in range(20):\n        code = f"{secrets.randbelow(1_000_000):06d}"\n        digest = hashlib.sha256(code.encode("ascii")).hexdigest()\n        if not session.query(DriverAppPairCode.id).filter_by(code_hash=digest).first():\n            break\n    else:\n        return vk.send_message(user.vk_id, "Не удалось создать код. Попробуйте ещё раз.", keyboard=kb.driver_info_menu())\n    session.add(DriverAppPairCode(\n        driver_id=user.id,\n        code_hash=digest,\n        expires_at=now + dt.timedelta(minutes=10),\n    ))\n    vk.send_message(\n        user.vk_id,\n        f"📱 Подключение приложения\\n\\nВаш код: {code}\\n\\n"\n        "Введите его в приложении водителя. Код действует 10 минут и используется один раз. "\n        "Никому не сообщайте этот код.",\n        keyboard=kb.driver_info_menu(),\n    )\n\n\nPENDING_ORDER_STATUSES = ("created", "queued", "no_drivers", "searching", "chat_search")\nPENDING_ORDERS_PER_PAGE = 7\n\n\ndef _pending_orders_query(session: Session):\n    """Requests which are neither assigned nor currently offered to a driver."""\n    return session.query(Order).filter(\n        Order.status.in_(PENDING_ORDER_STATUSES),\n        Order.driver_id.is_(None),\n        Order.parallel_driver_id.is_(None),\n        Order.offered_driver_id.is_(None),\n    )\n\n\ndef show_pending_orders(session: Session, user: User, page=1) -> None:\n    """Show every unclaimed request available for a direct driver claim."""\n    if active_order_for(session, user, as_driver=True):\n        return _menu_lock_notice(session, user)\n    try:\n        page = max(1, int(page or 1))\n    except (TypeError, ValueError):\n        page = 1\n    query = _pending_orders_query(session)\n    visible = [order for order in query.order_by(Order.created_at.asc(), Order.id.asc()).all()\n               if parallel_orders.local_line_allows(order, user)\n               and not blacklist_service.blocks(session, user.id, order.passenger_id)]\n    total = len(visible)\n    total_pages = max(1, (total + PENDING_ORDERS_PER_PAGE - 1) // PENDING_ORDERS_PER_PAGE)\n    page = min(page, total_pages)\n    orders = visible[(page - 1) * PENDING_ORDERS_PER_PAGE:page * PENDING_ORDERS_PER_PAGE]\n    if not orders:\n        text = "⏳ Сейчас нет ожидающих заявок."\n    else:\n        parts = [f"⏳ Ожидающие заявки — страница {page}/{total_pages}:"]\n        for order in orders:\n            parts.append(\n                f"\\n№{order.number} • {order_service.order_type_label(order)}\\n"\n                f"{order_service.order_text(order) or \'Маршрут не указан\'}"\n            )\n        text = "\\n".join(parts)\n    vk.send_message(\n        user.vk_id,\n        text,\n        keyboard=kb.pending_orders_keyboard(orders, page, total_pages),\n    )\n\n\ndef _order_is_older_than_two_minutes(order: Order) -> bool:\n    created = order.created_at or time_utils.now()\n    if created.tzinfo is None:\n        created = created.replace(tzinfo=dt.timezone.utc)\n    return (time_utils.now() - created).total_seconds() > 120\n\n\ndef request_claim_actuality(\n    session: Session, driver: User, order: Order, *, parallel: bool = False\n) -> bool:\n    """Reserve an old manual claim and ask its passenger before ETA."""\n    if (order.dispatcher_id or order.actuality_confirmed\n            or delivery_service.is_partner_delivery(order)\n            or not claim_needs_actuality(order)):\n        return False\n    passenger = session.get(User, order.passenger_id)\n    if not passenger:\n        return False\n    text = (\n        "У нас есть водитель, который сейчас довозит клиентов и затем выезжает к вам. "\n        "При отмене после перехода водителя к заявке или спустя 2 минуты после её принятия будет ложный вызов. "\n        "Вы ждёте машинку?"\n        if parallel else\n        "Появился водитель, который может взять вашу заявку. Она ещё актуальна?"\n    )\n    order.chat_actuality_prompt_outbox_id = vk.send_tracked_message(\n        passenger.vk_id,\n        f"{text}\\n{order_service.order_text(order)}",\n        keyboard=(kb.parallel_actuality_keyboard(order.id)\n                  if parallel else kb.chat_order_actual_keyboard(order.id)),\n    )\n    timers.schedule("chat_actual", order.id, 60, lambda: chat_actuality_timeout(order.id))\n    set_state(session, passenger.vk_id, States.P_CHAT_ORDER_CONFIRM,\n              {"order_id": order.id}, merge=False)\n    set_state(session, driver.vk_id, States.D_CHAT_ORDER_WAIT,\n              {"order_id": order.id}, merge=False)\n    vk.send_message(\n        driver.vk_id,\n        "Заявка подана более двух минут назад. Мы спросим актуальность у клиента; "\n        "если клиент подтвердит, заявка будет ваша.",\n    )\n    return True\n\n\ndef driver_take_pending(session: Session, user: User, order_id) -> None:\n    """Atomically claim an unoffered request and enter the normal ride flow."""\n    if active_order_for(session, user, as_driver=True):\n        return _menu_lock_notice(session, user)\n    if driver_block_service.is_blocked(user):\n        return vk.send_message(\n            user.vk_id,\n            msg(session, "msg_driver_blocked", until=driver_block_service.blocked_until_text(user)),\n        )\n    if not lines.require_complete_car(session, user):\n        return\n    if not user.current_line:\n        vk.send_message(user.vk_id, msg(session, "msg_need_line"))\n        return lines.show_line_menu(session, user)\n    try:\n        order_id = int(order_id)\n    except (TypeError, ValueError):\n        return show_pending_orders(session, user)\n    order = (_pending_orders_query(session)\n             .filter(Order.id == order_id)\n             .with_for_update()\n             .one_or_none())\n    if not order:\n        vk.send_message(user.vk_id, "Заявку уже взял или рассматривает другой водитель.")\n        return show_pending_orders(session, user)\n\n    if not parallel_orders.local_line_allows(order, user):\n        return vk.send_message(user.vk_id, "Эта заявка доступна только водителям соответствующей линии.")\n    # Offline/away drivers become active on their saved line before assignment.\n    city_id = lines.city_id_by_name(session, user.current_line)\n    if not city_id:\n        vk.send_message(user.vk_id, "Сохранённая линия больше недоступна. Выберите линию заново.")\n        return lines.show_line_menu(session, user)\n    if user.driver_status in ("offline", "away") or not user.is_on_line:\n        queue_service.join_queue(session, user, city_id)\n        user.is_on_line = True\n        user.driver_status = "online"\n\n    reserve_eta_offer(session, user, order)\n\n\ndef claim_needs_actuality(order: Order) -> bool:\n    """Age at acceptance, not age when a delayed passenger answer arrives."""\n    created = getattr(order, "created_at", None)\n    accepted = getattr(order, "driver_accept_time", None) or time_utils.now()\n    if not created:\n        return False\n    if created.tzinfo is None:\n        created = created.replace(tzinfo=dt.timezone.utc)\n    if accepted.tzinfo is None:\n        accepted = accepted.replace(tzinfo=dt.timezone.utc)\n    return (accepted - created).total_seconds() > 120\n\n\ndef offer_deadline_passed(session: Session, order: Order) -> bool:\n    deadline = getattr(order, "eta_offer_expires_at", None)\n    if deadline is not None:\n        if deadline.tzinfo is None:\n            deadline = deadline.replace(tzinfo=dt.timezone.utc)\n        return time_utils.now() >= deadline\n    job = session.query(ScheduledJob).filter(\n        ScheduledJob.job_key == f"accept:{order.id}",\n        ScheduledJob.status == "pending",\n    ).one_or_none()\n    # Missing timer is not permission to accept an unbounded/stale offer.\n    if job is None:\n        log.warning("Refused offer without durable deadline order=%s", order.id)\n        return True\n    deadline = job.run_at\n    if deadline.tzinfo is None:\n        deadline = deadline.replace(tzinfo=dt.timezone.utc)\n    return time_utils.now() >= deadline\n\n\ndef _live_eta_offer(session: Session, user: User, order_id) -> Order | None:\n    try:\n        order_id = int(order_id)\n    except (TypeError, ValueError):\n        return None\n    order = session.query(Order).filter(Order.id == order_id).with_for_update().one_or_none()\n    if (not order or order.status != "searching" or order.offered_driver_id != user.id\n            or order.driver_id is not None or order.parallel_driver_id is not None\n            or offer_deadline_passed(session, order)):\n        return None\n    if blacklist_service.blocks(session, user.id, order.passenger_id):\n        return None\n    return order\n\n\ndef offer_eta_custom_or_menu(session: Session, user: User, order_id) -> None:\n    order = _live_eta_offer(session, user, order_id)\n    if not order:\n        return vk.send_message(user.vk_id, "Заявка уже недоступна или время ответа истекло.")\n    return vk.send_message(user.vk_id, "Через сколько минут будете у клиента?",\n                           keyboard=kb.order_offer_keyboard(order.id, order.customer_price is not None))\n\n\ndef offer_eta_custom(session: Session, user: User, order_id) -> None:\n    order = _live_eta_offer(session, user, order_id)\n    if not order:\n        return vk.send_message(user.vk_id, "Заявка уже недоступна или время ответа истекло.")\n    # Do not cancel or extend the original 60-second deadline while typing.\n    set_state(session, user.vk_id, States.D_OFFER_ETA, {"order_id": order.id}, merge=False)\n    vk.send_message(user.vk_id, "Введите целое число минут до прибытия (от 1 до 1440). Время на ответ — 60 секунд с получения заявки.")\n\n\ndef accept_offer_eta(session: Session, user: User, order_id, value) -> None:\n    order = _live_eta_offer(session, user, order_id)\n    if not order:\n        return vk.send_message(user.vk_id, "Заявка уже недоступна или время ответа истекло.")\n    raw = str(value or "").strip()\n    if not re.fullmatch(r"[0-9]{1,4}(?:\\s*мин\\.?)?", raw, flags=re.IGNORECASE):\n        return vk.send_message(user.vk_id, "Введите целое число минут от 1 до 1440.")\n    eta = int(re.match(r"[0-9]+", raw).group())\n    if not 1 <= eta <= 1440:\n        return vk.send_message(user.vk_id, "Введите целое число минут от 1 до 1440.")\n    return driver_accept(session, user, order.id, notify_passenger=False, selected_eta=eta)\n\n\ndef reserve_eta_offer(session: Session, user: User, order: Order, *, source: str = "pending") -> None:\n    """Chat/pending tap is a reservation only; the original FIFO timer owns expiry."""\n    if order.offered_driver_id == user.id and order.status == "searching":\n        return offer_eta_custom_or_menu(session, user, order.id)\n    if (order.offered_driver_id or order.driver_id or order.parallel_driver_id\n            or order.status not in PENDING_ORDER_STATUSES):\n        return vk.send_message(user.vk_id, "Заявку уже рассматривает другой водитель.")\n    if blacklist_service.blocks(session, user.id, order.passenger_id):\n        return vk.send_message(user.vk_id, "Заявка недоступна.")\n    previous = offered_order_for(session, user)\n    if previous and previous.id != order.id:\n        timers.cancel("accept", previous.id)\n        order_service.finalize_offer_message(session, previous, "Заявка передана следующему водителю.")\n        order_service.clear_current_offer(session, previous)\n        queue_service.release_offer(session, user)\n        session.flush()\n    was_offline = not bool(user.is_on_line)\n    if was_offline or user.driver_status == "away":\n        queue_service.join_queue(session, user, lines.city_id_by_name(session, user.current_line))\n        user.is_on_line = True\n        session.flush()\n    if not queue_service.mark_offered(session, user):\n        return vk.send_message(user.vk_id, "Сейчас заявка недоступна. Обновите меню.")\n    timers.cancel("driver_chat", order.id)\n    timers.cancel("dispatcher_unclaimed", order.id)\n    passenger_queue.remove(session, order.id)\n    order.status = "searching"\n    order.offered_driver_id = user.id\n    order.eta_offer_source = source\n    order.chat_driver_was_offline = was_offline\n    order.eta_offer_expires_at = time_utils.now() + dt.timedelta(seconds=60)\n    set_state(session, user.vk_id, States.D_OFFER, {"order_id": order.id}, merge=False)\n    text = f"📌 {order_service.order_text(order)}\\n"\n    passenger = session.get(User, order.passenger_id) if order.passenger_id else None\n    if passenger and not order.dispatcher_id:\n        text += f"\\nОт кого: {_vk_label(passenger)} {order_service.passenger_rating_text(passenger)}"\n    if order.customer_price is not None:\n        text += f"\\n💰 Цена клиента: {float(order.customer_price):.0f} ₽"\n    if order.comment:\n        text += f"\\n💬 Комментарий: {order.comment}"\n    text += order_service._extras_summary(session, order)\n    order.offer_outbox_id = vk.send_tracked_message(\n        user.vk_id, text, keyboard=kb.order_offer_keyboard(order.id, order.customer_price is not None),\n        attachment=vk.prepare_voice_attachment(user.vk_id, order.voice_attachment))\n    if not order.offer_outbox_id:\n        raise RuntimeError("Could not enqueue driver ETA offer")\n    order_id, driver_id = order.id, user.id\n    timers.schedule("accept", order_id, 60, lambda: order_service._accept_timeout(order_id, driver_id))\n    if previous and previous.id != order.id:\n        order_service.offer_to_next_driver(session, previous, {user.id})\n\n\ndef close_blacklist_remove(session: Session, user: User) -> None:\n    data = get_data(session, user.vk_id)\n    pointer = data.get("blacklist_remove_outbox_id")\n    if pointer:\n        from . import outbox_service\n        outbox_service.finalize_tracked_message(session, pointer, "")\n        data.pop("blacklist_remove_outbox_id", None)\n        set_state(session, user.vk_id, States.D_MENU, data, merge=False)\n\n\ndef _blacklist_clients(session: Session, user: User):\n    return session.query(DriverBlacklist.passenger_vk_id, User.full_name).outerjoin(\n        User, User.vk_id == DriverBlacklist.passenger_vk_id).filter(\n        DriverBlacklist.driver_id == user.id).order_by(DriverBlacklist.id.asc()).all()\n\n\ndef show_blacklist(session: Session, user: User) -> None:\n    close_blacklist_remove(session, user)\n    reset(session, user.vk_id, States.D_MENU)\n    clients = _blacklist_clients(session, user)\n    text = "🚫 Ваш чёрный список:\\n\\n"\n    if not clients:\n        text += "Список пуст."\n    for vk_id, name in clients:\n        line = f"• [id{vk_id}|{name or (\'id\' + str(vk_id))}]\\n"\n        if len(text) + len(line) > 3000:\n            vk.send_message(user.vk_id, text, keyboard=kb.blacklist_menu())\n            text = "🚫 Чёрный список (продолжение):\\n\\n"\n        text += line\n    vk.send_message(user.vk_id, text, keyboard=kb.blacklist_menu())\n\n\ndef show_blacklist_remove(session: Session, user: User, page=1) -> None:\n    close_blacklist_remove(session, user)\n    clients = _blacklist_clients(session, user)\n    if not clients:\n        return show_blacklist(session, user)\n    pages = max(1, (len(clients) + 6) // 7)\n    try:\n        page = min(pages, max(1, int(page)))\n    except (TypeError, ValueError):\n        page = 1\n    pointer = vk.send_tracked_message(\n        user.vk_id, "Нажмите на клиента, чтобы убрать его из вашего чёрного списка:",\n        keyboard=kb.blacklist_remove_keyboard(clients[(page - 1) * 7:page * 7], page, pages))\n    set_state(session, user.vk_id, States.D_MENU,\n              {"blacklist_remove_outbox_id": pointer}, merge=False)\n\n\ndef remove_blacklist(session: Session, user: User, vk_id, page=1) -> None:\n    try:\n        vk_id = int(vk_id)\n    except (TypeError, ValueError):\n        return show_blacklist_remove(session, user, page)\n    session.query(DriverBlacklist).filter_by(driver_id=user.id, passenger_vk_id=vk_id).delete()\n    session.flush()\n    vk.send_message(user.vk_id, "✅ Клиент убран из вашего чёрного списка.", keyboard=kb.blacklist_menu())\n    show_blacklist_remove(session, user, page)\n\n\ndef add_blacklist_link(session: Session, user: User, text: str) -> None:\n    if not re.fullmatch(r"(?:https?://)?(?:(?:www|m)\\.)?vk\\.(?:ru|com)/[A-Za-z0-9_.]+/?(?:\\?[^\\s]*)?", text.strip(), re.IGNORECASE):\n        return vk.send_message(user.vk_id, "Нужна ссылка на личную страницу VK, например https://vk.ru/id123.",\n                               keyboard=kb.blacklist_menu())\n    vk_id = vk.resolve_user_id(text)\n    if not vk_id or vk_id <= 0 or vk_id == user.vk_id:\n        return vk.send_message(user.vk_id, "Не удалось найти клиента по этой ссылке. Проверьте ссылку и повторите.",\n                               keyboard=kb.blacklist_menu())\n    blacklist_service.add(session, user, vk_id)\n    vk.send_message(user.vk_id, "✅ Клиент добавлен в ваш чёрный список.")\n    show_blacklist(session, user)\n\n\ndef blacklist_from_rating(session: Session, user: User, order_id) -> None:\n    try:\n        order_id = int(order_id)\n    except (TypeError, ValueError):\n        return\n    order = session.query(Order).filter(Order.id == order_id).with_for_update().one_or_none()\n    if (not order or order.driver_id != user.id or order.status != "completed"\n            or not order.driver_rating_prompt_outbox_id or order.dispatcher_id):\n        return\n    passenger = session.get(User, order.passenger_id) if order.passenger_id else None\n    if not passenger:\n        return\n    blacklist_service.add(session, user, passenger.vk_id)\n    _finish_rating_prompt(session, order, True, "🚫 Клиент добавлен в ваш чёрный список. Оценка не выставлена.")\n    # Rating is optional and non-blocking: preserve queue, current trip and FSM.\n    vk.send_message(user.vk_id, "✅ Клиент добавлен в ваш чёрный список. Оценка не выставлена.")\n\n\ndef _commission_for_order(session: Session, order_id: int) -> float:\n    row = (\n        session.query(DispatcherCommission)\n        .filter(DispatcherCommission.order_id == order_id)\n        .one_or_none()\n    )\n    return float(row.amount) if row else 0.0\n\n\ndef show_driver_statistics(session: Session, user: User) -> None:\n    """Show workspace-wide order counts without replacing the driver menu."""\n    now = time_utils.now()\n    today_start = now.replace(hour=0, minute=0, second=0, microsecond=0)\n    yesterday_start = today_start - dt.timedelta(days=1)\n\n    base = session.query(Order).filter(\n        Order.status == "completed",\n        Order.completed_at.isnot(None),\n    )\n    total_completed = base.count()\n    today_count = base.filter(Order.completed_at >= today_start).count()\n    yesterday_count = base.filter(\n        Order.completed_at >= yesterday_start,\n        Order.completed_at < today_start,\n    ).count()\n    unclaimed_count = session.query(Order).filter(\n        Order.driver_id.is_(None),\n        Order.status.in_(("created", "queued", "searching", "chat_search")),\n    ).count()\n\n    # Intentionally no keyboard argument: the existing offline driver main\n    # menu remains displayed and unchanged after this informational message.\n    vk.send_message(\n        user.vk_id,\n        "📊 Статистика всех заявок:\\n\\n"\n        f"Всего завершено: {total_completed}\\n"\n        f"За сегодня: {today_count}\\n"\n        f"За вчера: {yesterday_count}\\n"\n        f"Ещё не взяли водители: {unclaimed_count}",\n    )\n\n\ndef show_earnings(session: Session, user: User) -> None:\n    """Show yesterday/today/all-time net income and three latest rides."""\n    now = time_utils.now()\n    today_start = now.replace(hour=0, minute=0, second=0, microsecond=0)\n    yesterday_start = today_start - dt.timedelta(days=1)\n    completed = (\n        session.query(Order)\n        .filter(Order.driver_id == user.id, Order.status == "completed")\n        .order_by(Order.completed_at.desc())\n        .all()\n    )\n\n    # Since release 0097 ``price`` is the final amount entered by the driver.\n    # Waiting/night hints are never added a second time.  Only dispatcher\n    # commission is deducted from the driver\'s income.\n    def net(order: Order) -> float:\n        return (float(order.price) if order.price is not None else 0.0) \\\n            - _commission_for_order(session, order.id)\n\n    total = sum(net(order) for order in completed)\n    today = sum(\n        net(order) for order in completed\n        if order.completed_at and order.completed_at >= today_start\n    )\n    yesterday = sum(\n        net(order) for order in completed\n        if order.completed_at\n        and yesterday_start <= order.completed_at < today_start\n    )\n\n    lines = [\n        "💰 Мои доходы:",\n        f"Сегодня: {today:.2f} ₽",\n        f"Вчера: {yesterday:.2f} ₽",\n        f"За всё время: {total:.2f} ₽",\n        "",\n        "Последние 3 удачные поездки:",\n    ]\n    latest = completed[:3]\n    if not latest:\n        lines.append("Пока нет завершённых поездок.")\n    else:\n        for o in latest:\n            when = time_utils.format_local(o.completed_at) if o.completed_at else ""\n            commission = _commission_for_order(session, o.id)\n            earned = net(o)\n            route = o.route_text or f"{o.address_from} → {o.address_to}"\n            detail = f"#{o.number} • {when}\\n{route}\\nЗаработано: {earned:.2f} ₽"\n            if commission:\n                detail += f" (после комиссии −{commission:.2f} ₽)"\n            lines.append(detail)\n    on_line = user.driver_status in ("online", "busy")\n    keyboard = kb.driver_away_menu(can_switch_role(user)) if user.driver_status == "away" \\\n        else kb.driver_menu(on_line, can_switch_role(user))\n    vk.send_message(user.vk_id, "\\n".join(lines), keyboard=keyboard)\n\n\ndef show_my_reviews(session: Session, user: User) -> None:\n    """Requirement 7: list reviews left by passengers, newest first."""\n    reviews = (\n        session.query(Review)\n        .filter(Review.driver_id == user.id, Review.kind == "passenger_to_driver")\n        .order_by(Review.created_at.desc())\n        .limit(15)\n        .all()\n    )\n    lines = [f"{format_rating(user)}\\n"]\n    if not reviews:\n        lines.append("Отзывов пока нет.")\n    else:\n        lines.append("⭐ Ваши отзывы:\\n")\n        for r in reviews:\n            passenger = session.get(User, r.passenger_id)\n            name = (passenger.full_name if passenger else None) or "Пассажир"\n            when = time_utils.format_local(r.created_at, "%d.%m.%Y") if r.created_at else ""\n            line = f"{\'⭐\' * r.stars} — {name} ({when})"\n            if r.text:\n                line += f"\\n   «{r.text}»"\n            lines.append(line)\n    on_line = user.driver_status in ("online", "busy")\n    keyboard = kb.driver_away_menu(can_switch_role(user)) if user.driver_status == "away" \\\n        else kb.driver_menu(on_line, can_switch_role(user))\n    vk.send_message(user.vk_id, "\\n".join(lines), keyboard=keyboard)\n\n\ndef driver_accept(\n    session: Session,\n    user: User,\n    order_id: int,\n    *,\n    notify_passenger: bool = True,\n    reserved_price_offer: bool = False,\n    selected_eta: int | None = None,\n) -> None:\n    order = session.query(Order).filter(Order.id == order_id).with_for_update().one_or_none()\n    if (not order or order.status not in ("searching", "created")\n            or order_service._current_offer(session, order) != user.id):\n        if _restore_active_menu_after_stale_offer(session, user, order):\n            return\n        vk.send_message(user.vk_id, "Заявка уже недоступна.")\n        return show_main_menu(session, user)\n    if not parallel_orders.local_line_allows(order, user):\n        return vk.send_message(user.vk_id, "Эта заявка доступна только водителям соответствующей линии.")\n    if blacklist_service.blocks(session, user.id, order.passenger_id):\n        return vk.send_message(user.vk_id, "Заявка недоступна.")\n    if selected_eta is not None and offer_deadline_passed(session, order):\n        return vk.send_message(user.vk_id, "Время ответа истекло. Заявка передаётся следующему водителю.")\n\n\n    from_chat = getattr(order, "eta_offer_source", None) == "chat"\n    # Preserve the existing chat-claim exceptions; ordinary FIFO checks stay intact.\n    if not from_chat and driver_block_service.is_blocked(user):\n        vk.send_message(user.vk_id, msg(session, "msg_driver_blocked", until=driver_block_service.blocked_until_text(user)))\n        return show_main_menu(session, user)\n    # A historical/stale queue row must never let an incomplete car accept an offer.\n    if not from_chat and not reserved_price_offer and not lines.has_complete_car(user):\n        timers.cancel("accept", order.id)\n        order_service.add_decline(session, order, user.id, "car_missing")\n        order_service.finalize_offer_message(\n            session, order, "🚫 Заявка отменена: данные автомобиля не заполнены."\n        )\n        order.offered_driver_id = None\n        queue_service.leave_queue(session, user)\n        user.is_on_line = False\n        if order.requested_driver_id:\n            order.status = "cancelled"\n            order.cancelled_at = time_utils.now()\n            order.cancelled_by = "system"\n            passenger = session.get(User, order.passenger_id)\n            if passenger:\n                reset(session, passenger.vk_id, States.MAIN_MENU)\n                vk.send_message(\n                    passenger.vk_id,\n                    "Выбранный водитель больше недоступен. Персональная заявка отменена.",\n                    keyboard=kb.direct_driver_unavailable_keyboard(),\n                )\n            vk.send_message(\n                user.vk_id,\n                "🚗 Персональная заявка отменена: сначала полностью заполните «Моя машина».",\n                keyboard=kb.driver_menu(on_line=False, show_role_switch=can_switch_role(user)),\n            )\n            passenger_queue.try_promote(session)\n            return\n        order.status = "searching"\n        vk.send_message(\n            user.vk_id,\n            "🚗 Заявка передана следующему водителю: сначала полностью заполните «Моя машина».",\n            keyboard=kb.driver_menu(on_line=False, show_role_switch=can_switch_role(user)),\n        )\n        return order_service.offer_to_next_driver(session, order)\n    # Req 1.1: a driver must be on a line to accept orders.\n    if not from_chat and not reserved_price_offer and (not user.is_on_line or not user.current_line):\n        vk.send_message(user.vk_id, msg(session, "msg_need_line"), keyboard=kb.driver_menu(on_line=False, show_role_switch=can_switch_role(user)))\n        return\n    timers.cancel("accept", order.id)\n    timers.cancel("dispatcher_unclaimed", order.id)\n    order.offered_driver_id = None\n    order.driver_id = user.id\n    order.status = "assigned"\n    order.driver_accept_time = time_utils.now()\n    if order.customer_price is not None and order.agreed_price is None:\n        order.agreed_price = order.customer_price\n    user.driver_missed_offers = 0\n    queue_service.mark_assigned(session, user)\n    if selected_eta is None:\n        order_service.finalize_offer_message(session, order, "✅ Вы приняли заявку.")\n    audit.record(session, "driver_accept", f"order={order.id} driver={user.id}")\n    if selected_eta is not None:\n        if order.chat_notice_outbox_id:\n            order_service.finalize_chat_order_notice(session, order, user)\n        # Store the driver\'s choice while an old request awaits its passenger.\n        order.arrival_eta = selected_eta\n        if claim_needs_actuality(order):\n            order_service.finalize_offer_message(session, order, f"⏰ Вы выбрали {selected_eta} мин.")\n        if request_claim_actuality(session, user, order):\n            return\n        if not delivery_service.is_delivery(order):\n            return _apply_eta(session, user, order, selected_eta)\n    # V76: the passenger hears about the driver right after the accept press.\n    if notify_passenger:\n        order_service.notify_driver_found(session, order)\n    # Requirement 4: for a delivery, ask the driver for their price first.\n    if delivery_service.is_delivery(order):\n        return delivery_service.request_price(session, user, order)\n\n    # Show the persistent active-order keyboard immediately on «Поехать».\n    # ETA options are inline and therefore cannot replace this keyboard.\n    set_state(session, user.vk_id, States.D_IN_RIDE, {"order_id": order.id})\n    vk.send_message(\n        user.vk_id,\n        f"✅ Вы взяли заявку #{order.number} ({order_service.order_type_label(order)})\\n"\n        f"{_order_requester_line(session, order)}\\n"\n        f"Ваша заявка: {order_service.order_text(order)}",\n        keyboard=_driver_ride_kb(session, order),\n    )\n    _show_eta_menu(session, user, order)\n\n    # Passenger details are deliberately sent only after the driver sets ETA.\n    # Sending them here used to duplicate the passenger\'s own request.\n\n\ndef driver_contact_dispatcher(session: Session, user: User) -> None:\n    """Requirement 4: drivers can no longer cancel orders themselves. They can\n    only reach the dispatcher, who cancels from the admin panel with a reason.\n    No penalties are applied to drivers anymore."""\n    order = active_order_for(session, user, as_driver=True)\n    if order:\n        kb_menu = _active_driver_order_keyboard(session, order)\n    else:\n        on_line = user.driver_status in ("online", "busy")\n        kb_menu = kb.driver_menu(on_line, can_switch_role(user))\n    link = get_cached(session, "dispatcher_contact_link", "https://vk.com/im") or "https://vk.com/im"\n    vk.send_message(user.vk_id, msg(session, "msg_contact_dispatcher", link=link), keyboard=kb_menu)\n\n\ndef _restore_active_menu_after_stale_offer(\n    session: Session,\n    user: User,\n    order: Order | None,\n) -> bool:\n    """Old «Поехать/Отказаться» buttons cannot reset an accepted ride."""\n    if (\n        order\n        and order.driver_id == user.id\n        and order.status in ("assigned", "arrived", "in_progress")\n    ):\n        set_state(session, user.vk_id, States.D_IN_RIDE, {"order_id": order.id})\n        vk.send_message(\n            user.vk_id,\n            f"Заявка #{order.number} уже принята. Активное меню восстановлено.",\n            keyboard=_driver_ride_kb(session, order),\n        )\n        return True\n    return False\n\n\ndef driver_decline_back(session: Session, user: User, order_id) -> None:\n    """«Назад» from the decline-reason screen → return to the offer."""\n    order = session.get(Order, order_id) if order_id else None\n    if (\n        not order\n        or order.status != "searching"\n        or order_service._current_offer(session, order) != user.id\n    ):\n        if _restore_active_menu_after_stale_offer(session, user, order):\n            return\n        return show_main_menu(session, user)\n    vk.send_message(\n        user.vk_id,\n        "Заявка #%s. Примите или отклоните её." % order.id,\n        keyboard=kb.order_offer_keyboard(order.id, customer_price_service.has_price(order)),\n    )\n    set_state(session, user.vk_id, States.D_OFFER, {"order_id": order.id})\n\n\ndef driver_decline_prompt(session: Session, user: User, order_id: int) -> None:\n    order = session.get(Order, int(order_id or 0))\n    if (\n        not order\n        or order.status != "searching"\n        or order_service._current_offer(session, order) != user.id\n    ):\n        if _restore_active_menu_after_stale_offer(session, user, order):\n            return\n        vk.send_message(user.vk_id, "Заявка уже недоступна.")\n        return show_main_menu(session, user)\n    vk.send_message(\n        user.vk_id,\n        "Почему отклоняете заявку?",\n        keyboard=kb.decline_reasons_keyboard(\n            order_id, customer_price_service.has_price(order),\n            allow_chat_handoff=not bool(order.requested_driver_id),\n        ),\n    )\n    set_state(session, user.vk_id, States.D_DECLINE_REASON, {"order_id": order_id})\n\n\ndef driver_decline(session: Session, user: User, order_id: int, cat: str) -> None:\n    """Requirement 5: driver decline sub-menu with a reason category.\n\n    * far / delivery — driver keeps their queue position, order goes on.\n    * away           — driver marked away, returns to tail on comeback.\n    * booking        — order is cancelled; timed rides use the booking flow.\n    * need_address   — passenger is asked for a clearer pickup address.\n    * spam           — passenger gets a temporary order ban; driver unaffected.\n    """\n    # Serialize the final reason with accept and timeout. Old VK buttons must\n    # never mutate an order that has already moved to another driver.\n    order = (\n        session.query(Order)\n        .filter(Order.id == int(order_id or 0))\n        .with_for_update()\n        .one_or_none()\n    )\n    if (\n        not order\n        or order.status != "searching"\n        or order_service._current_offer(session, order) != user.id\n    ):\n        if _restore_active_menu_after_stale_offer(session, user, order):\n            return\n        vk.send_message(user.vk_id, "Заявка уже недоступна.")\n        return show_main_menu(session, user)\n    timers.cancel("accept", order.id)\n    order_service.finalize_offer_message(session, order, "🚫 Вы отказались от заявки.")\n    queue_service.release_offer(session, user)\n    order_service.clear_current_offer(session, order)\n    # SessionLocal has autoflush disabled. Persist the released queue/order\n    # locks before the FIFO query selects the next eligible driver.\n    session.flush()\n    on_line_kb = kb.driver_menu(on_line=True, show_role_switch=can_switch_role(user))\n\n    # A passenger-selected request belongs only to the chosen driver. A\n    # refusal never leaks it into the ordinary FIFO queue.\n    if order.requested_driver_id:\n        passenger = session.get(User, order.passenger_id)\n        order.status = "cancelled"\n        order.cancelled_at = time_utils.now()\n        order.cancelled_by = "driver"\n        order.last_decline_reason = cat\n        timers.cancel_all_for_order(order.id)\n        if cat == "away":\n            queue_service.set_away(session, user)\n            driver_keyboard = kb.driver_away_menu(can_switch_role(user))\n            driver_text = "Вы отказались от персональной заявки и отлучились."\n        else:\n            driver_keyboard = on_line_kb\n            driver_text = "Вы отказались от персональной заявки. Ваше место в очереди сохранено."\n        set_state(session, user.vk_id, States.D_MENU)\n        vk.send_message(user.vk_id, driver_text, keyboard=driver_keyboard)\n        if passenger:\n            reset(session, passenger.vk_id, States.MAIN_MENU)\n            vk.send_message(\n                passenger.vk_id,\n                "Данный водитель не может взять заказ. Попробуйте выбрать другого водителя.",\n                keyboard=kb.direct_driver_unavailable_keyboard(),\n            )\n        audit.record(\n            session,\n            "direct_driver_decline",\n            f"order={order.id} driver={user.id} reason={cat}",\n        )\n        passenger_queue.try_promote(session)\n        return\n\n    from . import parallel_orders\n    if parallel_orders.local_village_line(order) and cat in ("to_driver_chat", "delivery", "far", "low_price"):\n        order_service.add_decline(session, order, user.id, cat)\n        order.status = "searching"\n        session.flush()\n        set_state(session, user.vk_id, States.D_MENU)\n        vk.send_message(user.vk_id, "Заявка передаётся водителям своей линии.", keyboard=on_line_kb)\n        order_service.offer_to_next_driver(session, order)\n        passenger_queue.try_promote(session)\n        return\n\n    # Explicit handoff is not an ordinary refusal/FIFO retry. Keep this\n    # driver first and exclude them from being re-offered this same request.\n    if cat == "to_driver_chat":\n        previous_decline = {\n            field: getattr(order, field)\n            for field in ("declined_driver_ids", "decline_count",\n                          "decline_reasons_json", "last_decline_reason")\n        }\n        order_service.add_decline(session, order, user.id, cat)\n        if not order_service.publish_special_decline_to_requests_chat(session, order):\n            # Fail closed: never promise a handoff when chat is unavailable.\n            # Restore the old offer so the driver can retry or pick a reason.\n            order.status = "searching"\n            for field, value in previous_decline.items():\n                setattr(order, field, value)\n            order_service._set_current_offer(session, order, user.id)\n            queue_service.mark_offered(session, user)\n            set_state(session, user.vk_id, States.D_OFFER, {"order_id": order.id})\n            order.offer_outbox_id = vk.send_tracked_message(\n                user.vk_id,\n                f"Заявка #{order.number}: {order_service.order_text(order)}\\n"\n                "Не удалось отправить заявку в водительскую. Повторите действие или выберите другую причину.",\n                keyboard=kb.order_offer_keyboard(order.id, customer_price_service.has_price(order)),\n                attachment=vk.prepare_voice_attachment(user.vk_id, order.voice_attachment),\n            )\n            timers.schedule(\n                "accept", order.id, get_int(session, "driver_accept_timeout", 60),\n                lambda: order_service._accept_timeout(order.id, user.id),\n            )\n            return\n        passenger_queue.remove(session, order.id)\n        queue_service.move_to_front(session, user)\n        set_state(session, user.vk_id, States.D_MENU, {"order_id": None}, merge=False)\n        vk.send_message(\n            user.vk_id,\n            "✅ Заявка отправлена в водительскую. Вы остаётесь первым в очереди.",\n            keyboard=on_line_kb,\n        )\n        audit.record(session, "driver_chat_handoff", f"order={order.id} driver={user.id}")\n        return\n\n    # --- «Бронь»: timed rides must be created through the booking flow ----- #\n    if cat == "booking":\n        passenger = session.get(User, order.passenger_id)\n        order.status = "cancelled"\n        order.cancelled_at = time_utils.now()\n        order.cancelled_by = "booking_required"\n        order.last_decline_reason = "booking"\n        order.offered_driver_id = None\n        passenger_queue.remove(session, order.id)\n        timers.cancel_all_for_order(order.id)\n        vk.send_message(\n            user.vk_id,\n            "Заявка отменена как бронь. Ваше место в очереди сохранено.",\n            keyboard=on_line_kb,\n        )\n        set_state(session, user.vk_id, States.D_MENU)\n        if passenger:\n            vk.send_message(\n                passenger.vk_id,\n                "📅 Заявка отменена. Поездка на определённое время оформляется через раздел «Забронировать поездку».",\n                keyboard=kb.passenger_menu(\n                    can_switch_role(passenger),\n                    _passenger_labels(session),\n                    has_booking=booking_service.has_active_passenger_booking(session, passenger),\n                ),\n            )\n            reset(session, passenger.vk_id, States.MAIN_MENU)\n        audit.record(session, "driver_decline_booking", f"order={order.id} driver={user.id}")\n        passenger_queue.try_promote(session)\n        return\n\n    # --- «Не хватает адреса: ask the passenger for a better address -------- #\n    if cat == "need_address":\n        order.status = "created"\n        vk.send_message(user.vk_id, "Понятно. Запросили у пассажира уточнение адреса.", keyboard=on_line_kb)\n        set_state(session, user.vk_id, States.D_MENU)\n        passenger = session.get(User, order.passenger_id)\n        if passenger:\n            vk.send_message(\n                passenger.vk_id,\n                "📍 Водителю не хватает информации в заявке. Напишите исправленный полный текст заявки целиком — откуда и куда. Новый текст полностью заменит старый.",\n                keyboard=kb.passenger_waiting_keyboard(),\n            )\n            set_state(session, passenger.vk_id, States.P_NEW_ADDRESS, {"order_id": order.id})\n        passenger_queue.try_promote(session)\n        return\n\n    # --- «Спам»: stop the order permanently and send it for admin review --- #\n    if cat == "spam":\n        passenger = session.get(User, order.passenger_id)\n        order.status = "cancelled"\n        order.cancelled_at = time_utils.now()\n        order.cancelled_by = "spam_report"\n        passenger_queue.remove(session, order.id)\n        timers.cancel_all_for_order(order.id)\n        vk.send_message(user.vk_id, "Жалоба на спам отправлена. Ваше место в очереди сохранено.", keyboard=on_line_kb)\n        set_state(session, user.vk_id, States.D_MENU)\n        if passenger:\n            vk.send_message(\n                passenger.vk_id,\n                "Заявка остановлена и отправлена администратору на проверку.",\n                keyboard=kb.passenger_menu(can_switch_role(passenger), _passenger_labels(session)),\n            )\n            reset(session, passenger.vk_id, States.MAIN_MENU)\n        route = order_service.order_text(order)\n        driver_name = user.full_name or ("id" + str(user.vk_id))\n        passenger_name = passenger.full_name if passenger and passenger.full_name else (\n            "id" + str(passenger.vk_id) if passenger else "неизвестно"\n        )\n        passenger_link = (\n            f"[id{passenger.vk_id}|{passenger_name}] (VK ID {passenger.vk_id})"\n            if passenger else f"внутренний ID {order.passenger_id}"\n        )\n        abuse_service.notify_admins(\n            session,\n            "🚨 Водитель отметил заявку как спам\\n"\n            f"Заявка: #{order.number}\\n"\n            f"Текст заявки: {route}\\n"\n            f"Пассажир: {passenger_link}\\n"\n            f"Водитель: [id{user.vk_id}|{driver_name}] (VK ID {user.vk_id})",\n            exclude_vk_id=user.vk_id,\n        )\n        passenger_queue.try_promote(session)\n        return\n\n    # --- «Отлучился»: driver steps out, order goes to the next one --------- #\n    if cat == "away":\n        queue_service.set_away(session, user)\n        vk.send_message(\n            user.vk_id,\n            "☕ Вы отлучились. Заявка передана следующему водителю.",\n            keyboard=kb.driver_away_menu(show_role_switch=can_switch_role(user)),\n        )\n        set_state(session, user.vk_id, States.D_MENU)\n        order_service.add_decline(session, order, user.id, None)\n        order.status = "searching"\n        session.flush()\n        order_service.offer_to_next_driver(session, order)\n        return\n\n    # --- Ordinary refusal reasons: keep position and pass to next driver --- #\n    if cat == "dislike":\n        vk.send_message(\n            user.vk_id,\n            "Заявка передана следующему водителю. Ваше место в очереди сохранено.",\n            keyboard=on_line_kb,\n        )\n        set_state(session, user.vk_id, States.D_MENU)\n        order_service.add_decline(session, order, user.id, cat)\n        order.status = "searching"\n        session.flush()\n        order_service.offer_to_next_driver(session, order)\n        passenger_queue.try_promote(session)\n        return\n\n    label = "доставки" if cat == "delivery" else "дальней поездки"\n    order_service.add_decline(session, order, user.id, cat)\n    order.status = "searching"\n    session.flush()\n    vk.send_message(\n        user.vk_id,\n        f"Отказ от {label} принят. Заявка сразу отправлена в чат водителей. "\n        "Ваше место в очереди сохранено.",\n        keyboard=on_line_kb,\n    )\n    set_state(session, user.vk_id, States.D_MENU)\n    # Delivery and long-distance refusals bypass the remaining FIFO queue.\n    if not order_service.publish_special_decline_to_requests_chat(session, order):\n        order.status = "no_drivers"\n        passenger = session.get(User, order.passenger_id)\n        if passenger:\n            vk.send_message(\n                passenger.vk_id,\n                "Не удалось передать заявку в чат водителей. Повторите заявку позже.",\n                keyboard=kb.passenger_menu(\n                    can_switch_role(passenger), _passenger_labels(session)\n                ),\n            )\n    passenger_queue.try_promote(session)\n\n\ndef _eta_options(session: Session) -> list[int]:\n    """The same mandatory ETA presets for every order source and type."""\n    return [1, 3, 5, 10, 15, 25]\n\n\n# A partner delivery asks when the driver reaches the SHOP, not the passenger.\nPARTNER_DELIVERY_ETA_PROMPT = "Через сколько минут вы подъедете за заказом?"\n\n\ndef _show_eta_menu(session: Session, user: User, order: Order, intro: str | None = None) -> None:\n    """Show the arrival-time menu, optionally together with the accepted order."""\n    set_state(session, user.vk_id, States.D_ETA_MENU, {"order_id": order.id}, merge=False)\n    if delivery_service.is_partner_delivery(order):\n        eta_text = PARTNER_DELIVERY_ETA_PROMPT\n    else:\n        eta_text = msg(session, "msg_eta_menu")\n    text = f"{intro}\\n\\n{eta_text}" if intro else eta_text\n    # Track the inline ETA prompt so choosing a preset/custom value can edit\n    # this exact message and remove its buttons.\n    if order.offer_outbox_id:\n        from . import outbox_service\n        outbox_service.cancel_or_delete(session, order.offer_outbox_id)\n        order.offer_outbox_id = None\n    # A voice request must remain playable after the driver accepts it. The\n    # accepted-order/ETA card is a new tracked message, so attach the prepared\n    # community-owned voice again instead of relying only on the old card.\n    voice_attachment = vk.prepare_voice_attachment(user.vk_id, order.voice_attachment)\n    order.offer_outbox_id = vk.send_tracked_message(\n        user.vk_id,\n        text,\n        keyboard=kb.eta_keyboard(\n            _eta_options(session),\n            button_label(session, "btn_eta_custom", "🕐 Индивидуальное время"),\n        ),\n        attachment=voice_attachment,\n    )\n\n\ndef driver_show_eta_menu(session: Session, user: User) -> None:\n    order = active_order_for(session, user, as_driver=True)\n    if not order:\n        return show_main_menu(session, user)\n    _show_eta_menu(session, user, order)\n\n\ndef driver_pick_eta(session: Session, user: User, minutes) -> None:\n    order = active_order_for(session, user, as_driver=True)\n    if not order:\n        return show_main_menu(session, user)\n    try:\n        eta = int(minutes)\n    except (TypeError, ValueError):\n        return _show_eta_menu(session, user, order)\n    _apply_eta(session, user, order, eta)\n\n\ndef driver_eta_custom(session: Session, user: User) -> None:\n    order = active_order_for(session, user, as_driver=True)\n    if not order:\n        return show_main_menu(session, user)\n    if delivery_service.is_delivery(order):\n        vk.send_message(user.vk_id, "Введите цифрами, за сколько минут выполните доставку:")\n    elif delivery_service.is_partner_delivery(order):\n        vk.send_message(user.vk_id, "Введите цифрами, через сколько минут подъедете за заказом:")\n    else:\n        vk.send_message(user.vk_id, msg(session, "msg_eta_custom_prompt"))\n    set_state(session, user.vk_id, States.D_ETA, {"order_id": order.id})\n\n\ndef driver_eta_add_menu(session: Session, user: User) -> None:\n    order = active_order_for(session, user, as_driver=True)\n    if not order:\n        return show_main_menu(session, user)\n    if not order.arrival_eta:\n        return _show_eta_menu(session, user, order)\n    vk.send_message(\n        user.vk_id,\n        "Сколько времени добавить к ожиданию клиентом водителя?",\n        keyboard=kb.eta_add_keyboard(),\n    )\n\n\ndef driver_eta_add_custom(session: Session, user: User) -> None:\n    order = active_order_for(session, user, as_driver=True)\n    if not order:\n        return show_main_menu(session, user)\n    vk.send_message(\n        user.vk_id,\n        "Введите, сколько добавить к времени ожидания клиентом водителя в минутах:",\n    )\n    set_state(session, user.vk_id, States.D_ETA_ADD, {"order_id": order.id})\n\n\ndef driver_add_eta(session: Session, user: User, value) -> None:\n    order = active_order_for(session, user, as_driver=True)\n    if not order:\n        return show_main_menu(session, user)\n    digits = "".join(ch for ch in str(value or "") if ch.isdigit())\n    if not digits:\n        return vk.send_message(\n            user.vk_id,\n            "Введите количество добавляемых минут числом:",\n        )\n    added = int(digits)\n    if added < 1 or added > 600:\n        return vk.send_message(user.vk_id, "Укажите от 1 до 600 минут.")\n    order.arrival_eta = int(order.arrival_eta or 0) + added\n    order_service.schedule_prearrival_notice(session, order)\n\n    if _is_dispatcher_order(order):\n        target = session.get(User, order.dispatcher_id)\n        if target:\n            vk.send_message(\n                target.vk_id,\n                f"⏳ Водитель задержится по заявке #{order.number} ещё на {added} мин.\\n"\n                f"{order_service.dispatcher_driver_details(user)}",\n            )\n    else:\n        passenger = session.get(User, order.passenger_id)\n        if passenger:\n            vk.send_message(\n                passenger.vk_id,\n                f"⏳ Водитель задержится ещё на {added} мин. Пожалуйста, подождите.",\n            )\n    set_state(session, user.vk_id, States.D_IN_RIDE, {"order_id": order.id})\n    vk.send_message(\n        user.vk_id,\n        f"✅ Добавлено {added} мин. Общее время прибытия: {order.arrival_eta} мин.",\n        keyboard=_driver_ride_kb(session, order),\n    )\n\n\ndef _apply_eta(session: Session, user: User, order: Order, eta: int) -> None:\n    # ETA is accepted only from the driver actually assigned to this order.\n    # This guard prevents a stale cross-role state/button from treating a\n    # dispatcher as the driver and sending driver-only confirmations to the\n    # dispatcher\'s conversation.\n    assigned_driver = session.get(User, order.driver_id) if order.driver_id else None\n    if assigned_driver is None or assigned_driver.id != user.id:\n        log.warning(\n            "Ignored ETA from non-assigned user: order=%s assigned=%s sender=%s",\n            order.id,\n            order.driver_id,\n            user.id,\n        )\n        return show_main_menu(session, user)\n\n    # Remove the time-choice buttons from the original message immediately.\n    order_service.finalize_offer_message(\n        session, order, f"⏰ Вы выбрали {eta} мин."\n    )\n    order.arrival_eta = eta\n    if order.driver_departed_at is None:\n        order.driver_departed_at = time_utils.now()\n    is_delivery = delivery_service.is_delivery(order)\n    is_partner_delivery = delivery_service.is_partner_delivery(order)\n    target = session.get(User, order.dispatcher_id) if _is_dispatcher_order(order) else session.get(User, order.passenger_id)\n    car_label = order_service.multi_car_label(session, order)\n    car_prefix = f"🚕 {car_label}\\n" if car_label else ""\n    if target:\n        if _is_dispatcher_order(order):\n            vk.send_message(\n                target.vk_id,\n                f"🚕 По заявке #{order.number} к клиенту выехал водитель.\\n"\n                f"{order_service.dispatcher_driver_details(assigned_driver)}\\n"\n                f"Прибудет примерно через: {eta} мин.",\n            )\n        elif is_delivery:\n            vk.send_message(\n                target.vk_id,\n                car_prefix + order_service.departure_driver_card_text(assigned_driver)\n                + "\\n⏱ Водитель выполнит доставку примерно за %d мин." % eta,\n                keyboard=kb.passenger_ride_keyboard(order.id),\n            )\n            set_state(session, target.vk_id, States.P_IN_RIDE, {"order_id": order.id})\n        else:\n            if order.departure_prompt_outbox_id:\n                from . import outbox_service\n                outbox_service.cancel_or_delete(session, order.departure_prompt_outbox_id)\n            if is_partner_delivery:\n                header = "\\U0001F4E6 Вашу доставку взял водитель.\\n"\n                eta_line = f"\\nВодитель заберёт заказ примерно через {eta} мин."\n                question = ""\n                # Актуальность по доставкам от партнёров не спрашиваем:\n                # сообщение уйдёт без вопроса и без таймера подтверждения.\n                order.actuality_confirmed = True\n            else:\n                header = ""\n                eta_line = f"\\n⏰ Будет через {eta} мин."\n                question = "Ждёте машинку?"\n            card = (\n                _driver_card(user) if is_partner_delivery\n                else order_service.departure_driver_card_text(assigned_driver)\n            )\n            if not claim_needs_actuality(order):\n                order.actuality_confirmed = True\n            if order.actuality_confirmed:\n                order.departure_prompt_outbox_id = None\n                vk.send_message(\n                    target.vk_id,\n                    car_prefix + header + card + eta_line,\n                    keyboard=kb.passenger_ride_keyboard(order.id),\n                )\n            else:\n                # One tracked card contains the driver, car, ETA and question.\n                # Replying edits this exact card and removes its Yes/No keys.\n                order.departure_prompt_outbox_id = vk.send_tracked_message(\n                    target.vk_id,\n                    car_prefix + header + card + eta_line + "\\n" + question,\n                    keyboard=kb.passenger_departure_keyboard(order.id),\n                )\n            set_state(session, target.vk_id, States.P_IN_RIDE, {"order_id": order.id})\n            order_service.schedule_prearrival_notice(session, order)\n    if is_delivery:\n        vk.send_message(assigned_driver.vk_id, "✅ Время сохранено. Когда купите товар — нажмите «🛒 Купил в магазине».", keyboard=kb.driver_delivery_keyboard("shopping"))\n    else:\n        vk.send_message(\n            assigned_driver.vk_id,\n            "Время подачи отправлено." if is_partner_delivery else "Время прибытия отправлено.",\n            keyboard=_driver_ride_kb(session, order),\n        )\n    set_state(session, assigned_driver.vk_id, States.D_IN_RIDE, {"order_id": order.id})\n\ndef driver_set_eta(session: Session, user: User, text: str) -> None:\n    """Requirement 1: custom arrival time entered as free text (minutes)."""\n    order = active_order_for(session, user, as_driver=True)\n    if not order:\n        return show_main_menu(session, user)\n    digits = "".join(ch for ch in (text or "") if ch.isdigit())\n    if not digits:\n        if delivery_service.is_delivery(order):\n            vk.send_message(user.vk_id, "Введите время доставки целым числом минут:")\n        elif delivery_service.is_partner_delivery(order):\n            vk.send_message(user.vk_id, "Введите целым числом минут, через сколько подъедете за заказом:")\n        else:\n            vk.send_message(user.vk_id, msg(session, "msg_eta_custom_prompt"))\n        return\n    _apply_eta(session, user, order, int(digits))\n\n\n\ndef driver_arrived(session: Session, user: User) -> None:\n    order = active_order_for(session, user, as_driver=True)\n    if not order:\n        return show_main_menu(session, user)\n    # Preserve any promotion repairs made by active_order_for before locking.\n    session.flush()\n    session.refresh(order, with_for_update=True)\n    if order.driver_id != user.id or order.status != "assigned":\n        return show_main_menu(session, user)\n    order_service.start_free_waiting(session, order)\n    from . import parallel_orders\n    parallel_orders.notify_after_arrival(session, user)\n    if not _is_dispatcher_order(order):\n        passenger = session.get(User, order.passenger_id)\n        label = order_service.multi_car_label(session, order)\n        if passenger and label:\n            vk.send_message(\n                passenger.vk_id,\n                f"🚘 {label} подъехала.\\n{_driver_card(user)}",\n                keyboard=kb.passenger_arrived_keyboard(order.id),\n            )\n    vk.send_message(user.vk_id, "Отмечено: вы на месте.", keyboard=_driver_ride_kb(session, order))\n    set_state(session, user.vk_id, States.D_IN_RIDE)\n\n\ndef driver_seated(session: Session, user: User) -> None:\n    order = active_order_for(session, user, as_driver=True)\n    if not order:\n        return show_main_menu(session, user)\n    # Freeze the automatic arrival-to-boarding waiting window. Any later\n    # waiting is started manually with the button shown during the ride.\n    waiting_minutes, waiting_cost = waiting_service.snapshot(session, order)\n    waiting_service.stop_waiting(session, order)\n    order.status = "in_progress"\n    timers.cancel("waiting", order.id)\n    # Retire only this order\'s arrival/waiting card. The durable outbox\n    # cancels an unsent card or retries deletion after an in-flight send.\n    arrival_notice_id = getattr(order, "arrival_notice_outbox_id", None)\n    if arrival_notice_id:\n        from . import outbox_service\n        if outbox_service.cancel_or_delete(session, arrival_notice_id):\n            order.arrival_notice_outbox_id = None\n    if _is_dispatcher_order(order):\n        dispatcher = session.get(User, order.dispatcher_id) if order.dispatcher_id else None\n        if dispatcher:\n            vk.send_message(\n                dispatcher.vk_id,\n                f"🚕 Пассажиры сели и поехали по заявке #{order.number}",\n            )\n    else:\n        passenger = session.get(User, order.passenger_id)\n        if passenger:\n            seated_text = (\n                "📦 Водитель забрал заказ и везёт его клиенту."\n                if delivery_service.is_partner_delivery(order)\n                else "🚗 Поехали! Хорошей поездки."\n            )\n            car_label = order_service.multi_car_label(session, order)\n            if car_label:\n                seated_text = (\n                    f"🚕 {car_label}: водитель {user.full_name or (\'id\' + str(user.vk_id))} "\n                    f"уехал с пассажиром. Автомобиль: {user.car_full}."\n                )\n            vk.send_message(\n                passenger.vk_id,\n                seated_text,\n                keyboard=kb.passenger_in_ride_keyboard(order.id),\n            )\n            set_state(session, passenger.vk_id, States.P_IN_RIDE, {"order_id": order.id})\n    # Pre-boarding waiting remains recorded for accounting but is not shown\n    # to the driver when the ride starts.\n    vk.send_message(\n        user.vk_id,\n        (\n            "Заказ забран. Едете к клиенту."\n            if delivery_service.is_partner_delivery(order)\n            else "Поездка начата."\n        ),\n        keyboard=_driver_ride_kb(session, order),\n    )\n    set_state(session, user.vk_id, States.D_IN_RIDE)\n\n\ndef driver_bought(session: Session, user: User) -> None:\n    """Delivery: driver bought the goods and is heading to the client."""\n    order = active_order_for(session, user, as_driver=True)\n    if not order:\n        return show_main_menu(session, user)\n    order.status = "in_progress"\n    if not _is_dispatcher_order(order):\n        passenger = session.get(User, order.passenger_id)\n        if passenger:\n            vk.send_message(passenger.vk_id, "\\U0001F6CD Водитель сделал покупку и едет к вам.")\n    vk.send_message(user.vk_id, "Отмечено. Когда доставите — нажмите «\\U0001F3C1 Завершить доставку».", keyboard=kb.driver_delivery_keyboard("bought"))\n    set_state(session, user.vk_id, States.D_IN_RIDE, {"order_id": order.id})\n\n\ndef _ride_stage(order: Order) -> str:\n    if order.status == "in_progress":\n        return "in_progress"\n    if order.status == "arrived":\n        return "arrived"\n    return "assigned"\n\n\ndef _driver_ride_kb(session: Session, order: Order):\n    from . import parallel_orders\n\n    driver = session.get(User, order.driver_id) if order.driver_id else None\n    # Партнёрская доставка: реквизиты водитель не отправляет.\n    is_partner_delivery = delivery_service.is_partner_delivery(order)\n    payment_details_enabled = bool(\n        driver\n        and driver.show_payment_details\n        and _payment_details_ready(driver)\n        and not is_partner_delivery\n    )\n    has_parallel = session.query(Order.id).filter(\n        Order.parallel_driver_id == order.driver_id,\n        Order.status == "parallel_assigned",\n    ).first() is not None\n    return kb.driver_ride_keyboard(\n        _ride_stage(order),\n        waiting=waiting_service.is_running(order),\n        eta_set=order.arrival_eta is not None,\n        has_parallel=has_parallel,\n        parallel_available=parallel_orders.has_available_for_current(session, order),\n        payment_details_enabled=payment_details_enabled,\n        payment_details_sent=bool(order.payment_details_sent),\n        driver_gender=driver.driver_gender if driver else None,\n        partner_delivery=is_partner_delivery,\n    )\n\n\ndef _payment_details_text(user: User) -> str:\n    if user.payment_type == "card":\n        details = f"карта {user.payment_card}"\n        duplicate_values = {str(user.payment_card or "").strip().casefold()}\n    else:\n        bank = " ".join(str(user.payment_bank or "").split())\n        bank = re.sub(\n            r"^(?:банк\\s*[:—–-]?\\s*)+",\n            "",\n            bank,\n            flags=re.IGNORECASE,\n        ).strip() or bank\n        details = f"телефон {user.payment_phone}, банк {bank}"\n        duplicate_values = {\n            str(user.payment_phone or "").strip().casefold(),\n            bank.casefold(),\n        }\n    recipient = " ".join(str(user.payment_recipient or "").split())\n    # Repair display for records corrupted by the old cancel/skip flow, where\n    # the bank could also be accidentally stored as the recipient.\n    if recipient and recipient.casefold() not in duplicate_values:\n        details += f", получатель {recipient}"\n    return details\n\n\ndef driver_send_payment_details(session: Session, user: User) -> None:\n    order = active_order_for(session, user, as_driver=True)\n    if not order:\n        return show_main_menu(session, user)\n    if order.status not in ("assigned", "arrived", "in_progress"):\n        return vk.send_message(\n            user.vk_id,\n            "Отправить реквизиты можно после принятия заявки.",\n            keyboard=_driver_ride_kb(session, order),\n        )\n    if delivery_service.is_partner_delivery(order):\n        # По доставкам от партнёров реквизиты не отправляются.\n        return vk.send_message(\n            user.vk_id,\n            "По доставкам от партнёров реквизиты не отправляются.",\n            keyboard=_driver_ride_kb(session, order),\n        )\n    if not user.show_payment_details or not _payment_details_ready(user):\n        return vk.send_message(\n            user.vk_id,\n            "Показ реквизитов выключен или реквизиты не заполнены.",\n            keyboard=_driver_ride_kb(session, order),\n        )\n    if order.payment_details_sent:\n        return vk.send_message(\n            user.vk_id,\n            "Реквизиты по этой поездке уже отправлены.",\n            keyboard=_driver_ride_kb(session, order),\n        )\n    if _is_dispatcher_order(order):\n        return vk.send_message(user.vk_id, "По диспетчерской заявке отправка реквизитов пассажиру недоступна.")\n    passenger = session.get(User, order.passenger_id)\n    if not passenger:\n        return vk.send_message(user.vk_id, "Пассажир не найден.")\n    payment_text = (\n        f"Реквизиты для оплаты по заявке #{order.number}\\n"\n        f"{_payment_details_text(user)}"\n    )\n    car_label = order_service.multi_car_label(session, order)\n    if car_label:\n        payment_text = (\n            f"🚕 {car_label}\\nВодитель: {user.full_name or (\'id\' + str(user.vk_id))}\\n"\n            f"Автомобиль: {user.car_full}\\n\\n" + payment_text\n        )\n    queued = vk.send_message(\n        passenger.vk_id,\n        payment_text,\n        keyboard=kb.passenger_in_ride_keyboard(),\n    )\n    if not queued:\n        return vk.send_message(\n            user.vk_id,\n            "Не удалось поставить реквизиты в отправку. Попробуйте ещё раз.",\n            keyboard=_driver_ride_kb(session, order),\n        )\n    # Mark only after the transactional outbox accepted the passenger message.\n    # A permanent VK failure resets this flag in outbox_service so the button\n    # becomes available for a retry.\n    order.payment_details_sent = True\n    waiting_minutes, waiting_cost = waiting_service.snapshot(session, order)\n    confirmation = "Реквизиты отправлены пассажиру."\n    if waiting_cost > 0:\n        confirmation += (\n            f"\\nНачислено за платное ожидание: "\n            f"{waiting_minutes} мин, {waiting_cost:.0f} ₽"\n        )\n    vk.send_message(\n        user.vk_id,\n        confirmation,\n        keyboard=_driver_ride_kb(session, order),\n    )\n\n\ndef driver_waiting_start(session: Session, user: User) -> None:\n    """Requirement 2: driver starts the paid waiting timer during the ride."""\n    order = active_order_for(session, user, as_driver=True)\n    if not order:\n        return show_main_menu(session, user)\n    if order.status != "in_progress":\n        return vk.send_message(\n            user.vk_id,\n            "До посадки пассажира ожидание считается автоматически.",\n            keyboard=_driver_ride_kb(session, order),\n        )\n    waiting_service.start_waiting(session, order)\n    # Keep the driver-facing status short; paid waiting is calculated at finish.\n    vk.send_message(\n        user.vk_id,\n        f"Ожидание запущено по заявке #{order.number}.",\n        keyboard=_driver_ride_kb(session, order),\n    )\n    if not _is_dispatcher_order(order):\n        passenger = session.get(User, order.passenger_id)\n        if passenger:\n            vk.send_message(passenger.vk_id, "⏳ Водитель ожидает вас.")\n    audit.record(session, "waiting_start", f"order={order.id}")\n\n\ndef driver_waiting_stop(session: Session, user: User) -> None:\n    order = active_order_for(session, user, as_driver=True)\n    if not order:\n        return show_main_menu(session, user)\n    minutes, cost = waiting_service.snapshot(session, order)\n    waiting_service.stop_waiting(session, order)\n    vk.send_message(\n        user.vk_id,\n        f"Вы продолжили поездку по заявке #{order.number}.",\n        keyboard=_driver_ride_kb(session, order),\n    )\n    if not _is_dispatcher_order(order):\n        passenger = session.get(User, order.passenger_id)\n        if passenger:\n            vk.send_message(passenger.vk_id, msg(session, "msg_waiting_passenger_continued"))\n    audit.record(session, "waiting_stop", f"order={order.id} minutes={minutes} cost={cost}")\n\n\ndef driver_cancel_order(session: Session, user: User) -> None:\n    """Requirement 5: driver cancels after accepting; penalise if past grace."""\n    order = active_order_for(session, user, as_driver=True)\n    if not order:\n        return show_main_menu(session, user)\n    if getattr(order, "enroute_notice_outbox_id", None):\n        order_service.clear_enroute_notice(session, order)\n    within = driver_block_service.within_grace(session, order.driver_accept_time)\n    order.status = "cancelled"\n    order.cancelled_at = time_utils.now()\n    order.cancelled_by = "driver"\n    from . import parallel_orders\n    parallel_orders.release_route_offers_for_trip(session, order)\n    passenger_queue.remove(session, order.id)\n    timers.cancel_all_for_order(order.id)\n    if within:\n        if order.order_type in ("delivery", "partner_delivery"):\n            queue_service.move_to_front(session, user)\n        else:\n            queue_service.return_to_queue(session, user)\n        vk.send_message(user.vk_id, "Заказ отменён. Штрафа нет (в течение 2 минут после принятия).", keyboard=kb.driver_menu(on_line=True, show_role_switch=can_switch_role(user)))\n        audit.record(session, "driver_cancel_free", f"order={order.id} driver={user.id}")\n    else:\n        until = driver_block_service.apply_violation(session, user)\n        queue_service.leave_queue(session, user)\n        vk.send_message(user.vk_id, msg(session, "msg_driver_blocked", until=driver_block_service.blocked_until_text(user)), keyboard=kb.driver_menu(on_line=False, show_role_switch=can_switch_role(user)))\n        audit.record(session, "driver_cancel_penalty", f"order={order.id} driver={user.id} until={until}")\n    set_state(session, user.vk_id, States.D_MENU)\n    passenger = session.get(User, order.passenger_id)\n    if passenger and not _is_dispatcher_order(order):\n        vk.send_message(passenger.vk_id, f"❌ Водитель отменил заявку #{order.number}. Пожалуйста, оформите новый заказ.", keyboard=kb.passenger_menu(can_switch_role(passenger), _passenger_labels(session)))\n        reset(session, passenger.vk_id, States.MAIN_MENU)\n    passenger_queue.try_promote(session)\n\n\ndef driver_cancel_passenger_order(session: Session, user: User) -> None:\n    """Bug #7: driver cancels the current order on the passenger\'s behalf."""\n    order = active_order_for(session, user, as_driver=True)\n    if not order:\n        return show_main_menu(session, user)\n    if getattr(order, "enroute_notice_outbox_id", None):\n        order_service.clear_enroute_notice(session, order)\n    order.status = "cancelled"\n    order.cancelled_at = time_utils.now()\n    order.cancelled_by = "driver"\n    from . import parallel_orders\n    parallel_orders.release_route_offers_for_trip(session, order)\n    passenger_queue.remove(session, order.id)\n    timers.cancel_all_for_order(order.id)\n    if order.order_type in ("delivery", "partner_delivery"):\n        queue_service.move_to_front(session, user)\n    else:\n        queue_service.return_to_queue(session, user)\n    audit.record(session, "driver_cancel_passenger", f"order={order.id} driver={user.id}")\n    vk.send_message(\n        user.vk_id,\n        "❌ Заявка отменена от имени пассажира.",\n        keyboard=kb.driver_menu(on_line=True, show_role_switch=can_switch_role(user)),\n    )\n    set_state(session, user.vk_id, States.D_MENU)\n    passenger = session.get(User, order.passenger_id)\n    if passenger and not _is_dispatcher_order(order):\n        vk.send_message(\n            passenger.vk_id,\n            "❌ Ваша заявка была отменена водителем. При необходимости оформите новый заказ.",\n            keyboard=kb.passenger_menu(can_switch_role(passenger), _passenger_labels(session)),\n        )\n        reset(session, passenger.vk_id, States.MAIN_MENU)\n    passenger_queue.try_promote(session)\n\n\ndef driver_complete_delivery(session: Session, user: User, order: Order) -> None:\n    """Delivery finish: no price prompt (driver set it when taking the order)."""\n    price = float(order.price or 0)\n    order.status = "completed"\n    order.completed_at = time_utils.now()\n    booking_service.mark_completed_for_order(session, order.id)\n    commission = 0.0\n    if order.dispatcher_id:\n        commission = round(price * config.DISPATCHER_COMMISSION, 2)\n        session.add(\n            DispatcherCommission(\n                order_id=order.id,\n                dispatcher_id=order.dispatcher_id,\n                driver_id=user.id,\n                amount=commission,\n                is_paid=False,\n            )\n        )\n    timers.cancel_all_for_order(order.id)\n    from . import parallel_orders\n    parallel_orders.release_route_offers_for_trip(session, order)\n    has_parallel = parallel_orders.has_pending(session, user)\n    _leave_temporary_chat_line(session, user, order)\n\n    client = session.get(User, order.passenger_id) if order.passenger_id else None\n    if client and not _is_dispatcher_order(order):\n        client_label = _vk_label(client)\n    else:\n        client_label = "диспетчер"\n    summary = "\\u2705 Вы выполнили доставку #%d.\\n\\U0001F4B0 Сумма: %.0f \\u20bd\\n\\U0001F464 Клиент: %s" % (order.number, price, client_label)\n    if commission:\n        summary += "\\nКомиссия диспетчеру (10%%): \\u2212%.0f \\u20bd" % commission\n    vk.send_message(user.vk_id, summary)\n\n    if not _is_dispatcher_order(order):\n        if client:\n            order.passenger_rating_prompt_outbox_id = vk.send_tracked_message(\n                client.vk_id,\n                "\\U0001F64F Спасибо за заказ!\\n\\U0001F4B0 Сумма доставки: %.0f \\u20bd + оплата по чеку из магазина." % price,\n                keyboard=kb.rating_keyboard(order.id),\n            )\n            if order.passenger_rating_prompt_outbox_id:\n                from . import rating_expiry_service\n                rating_expiry_service.schedule_expiry(order.id, driver_side=False)\n            set_state(session, client.vk_id, States.P_RATE, {"order_id": order.id})\n\n    if has_parallel:\n        # queue_service.move_to_tail_after_success is intentionally not used:\n        # a parallel order is promoted only after the explicit line choice.\n        # Legacy compatibility marker: queue_service.move_to_tail_after_success(session, user)\n        parallel_orders.promote_after_current(session, user)\n    else:\n        # Explicit branch marker: if not has_parallel: the driver must choose\n        # a post-ride action before returning to any line.\n        _ask_driver_rate_passenger(session, user, order)\n        # Always require the post-ride line decision. The old automatic return\n        # to the queue skipped the «stay / change / leave line» menu.\n        lines.ask_post_ride_line(session, user)\n\n\ndef driver_finish_prompt(session: Session, user: User) -> None:\n    """Requirement 4: at finish the driver enters the price manually."""\n    order = active_order_for(session, user, as_driver=True)\n    if not order:\n        return show_main_menu(session, user)\n    if delivery_service.is_delivery(order):\n        return driver_complete_delivery(session, user, order)\n    # Waiting and night tariff are hints for the driver. The bot never adds\n    # them to the entered total automatically: the driver decides the final sum.\n    waiting_minutes, waiting_cost = waiting_service.snapshot(session, order)\n    night_cost = night_tariff.amount(session) if order.night_surcharge else 0.0\n    additions: list[str] = []\n    if waiting_cost > 0:\n        additions.append(\n            f"⏳ Начислено за платное ожидание: {waiting_minutes} мин, {waiting_cost:.0f} ₽"\n        )\n    if night_cost > 0:\n        additions.append(\n            f"🌙 Ночной тариф (23:00–06:00): +{night_cost:.0f} ₽"\n        )\n    prompt_parts: list[str] = []\n    if order.dispatcher_id:\n        prompt_parts.append("🎧 Это заявка от диспетчера.")\n    # Dispatcher-created rides must show the same accumulated waiting/night\n    # additions as ordinary rides. The driver still enters the final total\n    # manually, so nothing is silently added twice.\n    if additions:\n        prompt_parts.append(\n            "Доплаты к поездке:\\n"\n            + "\\n".join(additions)\n            + "\\n\\nБот НЕ добавляет эти суммы автоматически. "\n              "При необходимости добавьте их к итоговой стоимости самостоятельно."\n        )\n    prompt_parts.append("Введите итоговую стоимость поездки одним числом (₽):")\n    prompt = "\\n\\n".join(prompt_parts)\n    # Keep the active-ride keyboard available below the fare prompt. Entering\n    # a number still finishes the ride; buttons are routed as actions.\n    set_state(session, user.vk_id, States.D_FINISH_PRICE, {"order_id": order.id}, merge=False)\n    vk.send_message(\n        user.vk_id,\n        prompt,\n        keyboard=_active_driver_order_keyboard(session, order),\n    )\n\n\nPRICE_MIN = 100.0\nPRICE_MAX = 50_000.0\n\n\ndef _parse_price(text: str) -> float | None:\n    """Parse a driver-entered amount without rejecting harmless VK formatting.\n\n    Accepts examples such as ``170``, ``170 ₽``, ``170р``, ``170 руб.``,\n    non-breaking spaces and a comma as the decimal separator. Extra words or\n    more than two decimal places are rejected instead of being guessed.\n    """\n    if not isinstance(text, str):\n        return None\n    cleaned = text.strip().casefold()\n    cleaned = cleaned.replace("\\u00a0", "").replace("\\u202f", "").replace(" ", "")\n    cleaned = re.sub(r"(?:₽|р\\.?|руб\\.?|рубля|рублей)$", "", cleaned).strip()\n    cleaned = cleaned.replace(",", ".")\n    if not re.fullmatch(r"\\d+(?:\\.\\d{1,2})?", cleaned):\n        return None\n    try:\n        value = float(cleaned)\n    except (TypeError, ValueError, OverflowError):\n        return None\n    if not math.isfinite(value) or value < 0:\n        return None\n    return round(value, 2)\n\n\ndef _price_in_range(value: float) -> bool:\n    return PRICE_MIN <= value <= PRICE_MAX\n\n\ndef _price_range_message() -> str:\n    return "Пожалуйста, перепроверьте цену. Сумма должна быть от 100 до 50 000 рублей."\n\n\ndef driver_complete_ride(session: Session, user: User, text: str) -> None:\n    """Requirement 3 (fix crash) + 1 (earnings) + 10 (dispatcher commission)."""\n    order = active_order_for(session, user, as_driver=True)\n    if not order:\n        return show_main_menu(session, user)\n\n    price = _parse_price(text)\n    if price is None:\n        vk.send_message(user.vk_id, "Введите стоимость числом, например 350:")\n        return\n    if not _price_in_range(price):\n        log.warning("Rejected ride price: driver_vk_id=%s raw=%r parsed=%s", user.vk_id, text, price)\n        vk.send_message(user.vk_id, _price_range_message())\n        return\n\n    # Requirement 2/1/3: finalise waiting, extra services and night tariff.\n    waiting_minutes, waiting_cost = waiting_service.finalize(session, order)\n    night_cost = night_tariff.amount(session) if order.night_surcharge else 0.0\n    waiting = waiting_cost\n    order.waiting_fee = waiting_cost\n    order.price = price\n    order.status = "completed"\n    order.completed_at = time_utils.now()\n    booking_service.mark_completed_for_order(session, order.id)\n\n    # Dispatcher commission (requirement 10): driver owes 10% of the price.\n    commission = 0.0\n    if order.dispatcher_id:\n        commission = round(price * config.DISPATCHER_COMMISSION, 2)\n        session.add(\n            DispatcherCommission(\n                order_id=order.id,\n                dispatcher_id=order.dispatcher_id,\n                driver_id=user.id,\n                amount=commission,\n                is_paid=False,\n            )\n        )\n\n    # Requirement 11 — the historic crash: ``total_earned`` was a Decimal while\n    # ``price``/``waiting`` are floats, so ``Decimal + float`` raised TypeError\n    # on completion. The column has been removed entirely; ``net`` stays a plain\n    # float used only for the summary message, so no mixed-type arithmetic.\n    # The entered price is already the final amount chosen by the driver.\n    # Waiting and night tariff are informational and are never added again.\n    net = round(price - commission, 2)\n\n    timers.cancel_all_for_order(order.id)\n    from . import parallel_orders\n    parallel_orders.release_route_offers_for_trip(session, order)\n    has_parallel = parallel_orders.has_pending(session, user)\n    _leave_temporary_chat_line(session, user, order)\n\n    summary = f"✅ Поездка #{order.number} завершена.\\nСтоимость: {price:.0f} ₽"\n    if waiting:\n        summary += f"\\n⏳ Платное ожидание: {waiting:.0f} ₽ (не добавлялось автоматически)"\n    if night_cost:\n        summary += f"\\n🌙 Ночной тариф: +{night_cost:.0f} ₽ (не добавлялся автоматически)"\n    if commission:\n        summary += f"\\nКомиссия диспетчеру (10%): −{commission:.0f} ₽"\n    summary += f"\\n💰 На руки: {net:.0f} ₽"\n    vk.send_message(user.vk_id, summary)\n    # Requirement 3: after entering the price the driver rates the passenger;\n    # the post-ride line prompt follows once rating is submitted or skipped.\n    if not has_parallel:\n        _ask_driver_rate_passenger(session, user, order)\n        # No automatic return to the queue: the driver is away until choosing\n        # the ordinary post-ride line menu.\n        # queue_service.move_to_tail_after_success(session, user) is deliberately\n        # deferred until stay_line handles the driver\'s explicit choice.\n        lines.ask_post_ride_line(session, user)\n\n    # Ask the passenger to rate — only for real passengers (not dispatcher orders).\n    if not _is_dispatcher_order(order):\n        passenger = session.get(User, order.passenger_id)\n        if passenger:\n            total = price\n            # Requisites are never attached to the final summary: the passenger\n            # only gets them when the driver taps «Отправить реквизиты» during the\n            # ride. If the button was not used, nothing has to be transferred.\n            if order.payment_details_sent:\n                payment_block = (\n                    "\\n\\nЕсли вы уже оплатили поездку, ничего не надо переводить."\n                )\n            else:\n                payment_block = ""\n            # По доставкам от партнёров итог по поездке не пишется.\n            if not delivery_service.is_partner_delivery(order):\n                vk.send_message(\n                    passenger.vk_id,\n                    "🧾 Итог по поездке #%d:\\nИтого: %.0f ₽%s" % (order.number, total, payment_block),\n                )\n            rating_text, rating_file = bm.render(session, "ride_finished", total=f"{total:.0f}")\n            order.passenger_rating_prompt_outbox_id = vk.send_tracked_message(\n                passenger.vk_id,\n                rating_text,\n                keyboard=kb.rating_keyboard(order.id),\n                attachment=rating_file or None,\n            )\n            if order.passenger_rating_prompt_outbox_id:\n                from . import rating_expiry_service\n                rating_expiry_service.schedule_expiry(order.id, driver_side=False)\n            reset(session, passenger.vk_id, States.MAIN_MENU)\n            show_main_menu(session, passenger)\n    if has_parallel:\n        parallel_orders.promote_after_current(session, user)\n\n\ndef _is_dispatcher_order(order: Order) -> bool:\n    return order.dispatcher_id is not None and order.dispatcher_id == order.passenger_id\n\n\n# --------------------------------------------------------------------------- #\n#  Advance bookings                                                            #\n# --------------------------------------------------------------------------- #\ndef passenger_booking_start(session: Session, user: User) -> None:\n    ban_msg = _order_ban_message(user)\n    if ban_msg:\n        return vk.send_message(user.vk_id, ban_msg)\n    existing = None if user.role == ROLE_DISPATCHER else booking_service.active_for_passenger(session, user)\n    if existing:\n        return passenger_show_booking(session, user)\n    # Passenger and dispatcher use one booking product: long-distance trips.\n    # There is no intermediate early/specific-time type selector.\n    return passenger_booking_fill(session, user)\n\n\ndef passenger_booking_fill(session: Session, user: User) -> None:\n    draft = {"type": "far_distance"}\n    set_state(session, user.vk_id, States.P_BOOKING_DATE, {"booking": draft}, merge=False)\n    vk.send_message(\n        user.vk_id,\n        "На какое число бронируем дальнюю поездку?",\n        keyboard=kb.booking_date_keyboard(),\n    )\n\n\ndef passenger_booking_type(session: Session, user: User, booking_type: str | None) -> None:\n    """Compatibility for buttons sent before v35: always open long distance."""\n    return passenger_booking_fill(session, user)\n\n\ndef passenger_booking_date_quick(session: Session, user: User, days) -> None:\n    try:\n        offset = int(days)\n    except (TypeError, ValueError):\n        offset = 1\n    offset = max(1, min(365, offset))\n    data = get_data(session, user.vk_id)\n    draft = data.get("booking", {})\n    booking_date = time_utils.now().date() + dt.timedelta(days=offset)\n    draft["date"] = booking_date.isoformat()\n    passenger_booking_ask_time(session, user, draft)\n\n\ndef passenger_booking_date_custom(session: Session, user: User) -> None:\n    data = get_data(session, user.vk_id)\n    draft = data.get("booking", {})\n    set_state(session, user.vk_id, States.P_BOOKING_DATE, {"booking": draft}, merge=False)\n    vk.send_message(\n        user.vk_id,\n        "Введите дату в формате ДД.ММ.ГГГГ, например 18.07.2026:",\n        keyboard=kb.booking_only_cancel_keyboard(),\n    )\n\n\ndef passenger_booking_date_input(session: Session, user: User, text: str) -> None:\n    booking_date = booking_service.parse_date(text)\n    if booking_date is None:\n        return vk.send_message(user.vk_id, "Неверная дата. Введите её как ДД.ММ.ГГГГ:")\n    if booking_date < time_utils.now().date():\n        return vk.send_message(user.vk_id, "Нельзя выбрать прошедшую дату. Введите будущую дату:")\n    data = get_data(session, user.vk_id)\n    draft = data.get("booking", {})\n    draft["date"] = booking_date.isoformat()\n    passenger_booking_ask_time(session, user, draft)\n\n\ndef passenger_booking_ask_time(session: Session, user: User, draft: dict) -> None:\n    set_state(session, user.vk_id, States.P_BOOKING_TIME, {"booking": draft}, merge=False)\n    vk.send_message(\n        user.vk_id,\n        "Введите время поездки, например 05:30 или 05 30:",\n        keyboard=kb.booking_only_cancel_keyboard(),\n    )\n\n\ndef passenger_booking_time(session: Session, user: User, text: str) -> None:\n    clock = booking_service.parse_clock(text)\n    if clock is None:\n        return vk.send_message(\n            user.vk_id,\n            "Неверный формат. Введите время как 05:30 или 05 30:",\n            keyboard=kb.booking_only_cancel_keyboard(),\n        )\n    data = get_data(session, user.vk_id)\n    draft = data.get("booking", {})\n    draft["time"] = clock.strftime("%H:%M")\n    set_state(session, user.vk_id, States.P_BOOKING_ADDRESS, {"booking": draft}, merge=False)\n    vk.send_message(\n        user.vk_id,\n        "Напишите адреса откуда и куда одним сообщением:",\n        keyboard=kb.booking_only_cancel_keyboard(),\n    )\n\n\ndef passenger_booking_address(session: Session, user: User, text: str) -> None:\n    route = " ".join((text or "").split())\n    if not route:\n        return vk.send_message(\n            user.vk_id,\n            "Адрес не может быть пустым. Напишите откуда и куда едем:",\n            keyboard=kb.booking_only_cancel_keyboard(),\n        )\n    data = get_data(session, user.vk_id)\n    draft = data.get("booking", {})\n    draft["route"] = route\n    return passenger_booking_extras_start(session, user, draft)\n\n\ndef passenger_booking_extras_start(session: Session, user: User, draft: dict) -> None:\n    """Requirement: the booking extras step reuses the same interactive\n    toggle-and-«Далее» menu as a regular order, instead of free text."""\n    set_state(session, user.vk_id, States.P_BOOKING_EXTRAS, {"booking": draft, "extras": []}, merge=False)\n    vk.send_message(user.vk_id, msg(session, "msg_extras_prompt"), keyboard=kb.extras_keyboard([]))\n\n\ndef passenger_booking_toggle_extra(session: Session, user: User, key) -> None:\n    data = get_data(session, user.vk_id)\n    selection = extra_services.toggle(data.get("extras", []), key or "")\n    set_state(session, user.vk_id, States.P_BOOKING_EXTRAS, {"extras": selection})\n    vk.send_message(user.vk_id, msg(session, "msg_extras_prompt"), keyboard=kb.extras_keyboard(selection))\n\n\ndef passenger_booking_extras_done(session: Session, user: User) -> None:\n    data = get_data(session, user.vk_id)\n    selection = data.get("extras", [])\n    draft = data.get("booking", {})\n    descriptions = extra_services.describe(session, selection)\n    draft["extras"] = ", ".join(descriptions) if descriptions else "Нет"\n    set_state(session, user.vk_id, States.P_BOOKING_COMMENT, {"booking": draft}, merge=False)\n    vk.send_message(\n        user.vk_id,\n        "Добавьте комментарий. Желательно укажите номер телефона, чтобы водитель мог вам позвонить, или нажмите «Пропустить комментарий».",\n        keyboard=kb.booking_comment_keyboard(),\n    )\n\n\ndef passenger_booking_comment(session: Session, user: User, text: str) -> None:\n    comment = (text or "").strip() or "Нет"\n    data = get_data(session, user.vk_id)\n    draft = data.get("booking", {})\n    draft["comment"] = comment\n    clock = booking_service.parse_clock(draft.get("time", ""))\n    if clock is None:\n        return passenger_booking_fill(session, user)\n    date_text = ""\n    if draft.get("date"):\n        parsed_date = booking_service.parse_date(draft["date"])\n        if parsed_date:\n            date_text = f"Дата: {parsed_date.strftime(\'%d.%m.%Y\')}\\n"\n    preview = (\n        "Проверьте бронь:\\n"\n        f"Тип: {booking_service.type_label(draft.get(\'type\', \'\'))}\\n"\n        f"{date_text}"\n        f"Время: {clock.strftime(\'%H:%M\')}\\n"\n        f"Маршрут: {draft.get(\'route\', \'\')}\\n"\n        f"Доп. услуги: {draft.get(\'extras\', \'Нет\')}\\n"\n        f"Комментарий: {comment}"\n    )\n    set_state(session, user.vk_id, States.P_BOOKING_CONFIRM, {"booking": draft}, merge=False)\n    vk.send_message(user.vk_id, preview, keyboard=kb.booking_confirm_keyboard())\n\n\ndef passenger_booking_confirm(session: Session, user: User) -> None:\n    if user.role != ROLE_DISPATCHER and booking_service.active_for_passenger(session, user):\n        return passenger_show_booking(session, user)\n    data = get_data(session, user.vk_id)\n    draft = data.get("booking", {})\n    clock = booking_service.parse_clock(draft.get("time", ""))\n    if (\n        clock is None\n        or draft.get("type") not in ("far_distance", "early_time")\n        or not draft.get("route")\n        or not draft.get("comment")\n    ):\n        return passenger_booking_fill(session, user)\n    booking_date = booking_service.parse_date(draft.get("date", "")) if draft.get("date") else None\n    if draft["type"] == "far_distance" and booking_date is None:\n        return passenger_booking_fill(session, user)\n    scheduled_at = booking_service.scheduled_datetime(clock, booking_date)\n    if scheduled_at <= time_utils.now():\n        return vk.send_message(user.vk_id, "Выбранные дата и время уже прошли. Создайте бронь заново.")\n    booking = booking_service.create_booking(\n        session,\n        user,\n        draft["type"],\n        clock,\n        draft["route"],\n        draft.get("extras", "Нет"),\n        draft["comment"],\n        booking_date=booking_date,\n    )\n    reset(session, user.vk_id, States.DISP_MENU if user.role == ROLE_DISPATCHER else States.MAIN_MENU)\n    vk.send_message(user.vk_id, "Бронь сохранена, когда мы найдем водителя мы вас уведомим.")\n    show_main_menu(session, user)\n    _broadcast_booking_to_driver_chat(session, booking)\n\n\ndef _broadcast_booking_to_driver_chat(\n    session: Session,\n    booking: Booking,\n    reopened: bool = False,\n) -> None:\n    """Publish every new booking into the separate requests chat."""\n    creator = session.get(User, booking.passenger_id)\n    dispatcher_suffix = " (диспетчер)" if creator and creator.role == ROLE_DISPATCHER else ""\n    creator_line = f"От кого: {_vk_label(creator)}{dispatcher_suffix}\\n" if creator else "От кого: неизвестно\\n"\n    title = (\n        f"↩️ Бронь №{booking.number} снова доступна: водитель отменил её.\\n"\n        if reopened\n        else f"📅 Новая бронь №{booking.number}!\\n"\n    )\n    text = title + creator_line + booking_service.format_summary(booking)\n    outbox_id = order_service.send_fallback_chat_tracked_notice(\n        session, text, keyboard=kb.booking_take_keyboard(booking.id, booking.number)\n    )\n    if not outbox_id:\n        log.error("Could not publish booking %s to the fallback chat", booking.id)\n        return\n    booking.chat_notice_outbox_id = outbox_id\n    timers.schedule(\n        "booking_chat", booking.id, booking_service.CHAT_UNCLAIMED_TIMEOUT_SECONDS,\n        lambda: booking_service.expire_unclaimed_booking(booking.id),\n    )\n\n\ndef _delete_booking_chat_notice(session: Session, booking: Booking) -> bool:\n    outbox_id = booking.chat_notice_outbox_id\n    if not outbox_id:\n        return True\n    from . import outbox_service\n    removed = outbox_service.cancel_or_delete(session, outbox_id)\n    if removed:\n        booking.chat_notice_outbox_id = None\n    return removed\n\n\ndef _finalize_booking_chat_notice(session: Session, booking: Booking, driver: User) -> bool:\n    name = driver.full_name or ("id" + str(driver.vk_id))\n    text = f"✅ Бронь взял водитель: {name}"\n    outbox_id = booking.chat_notice_outbox_id\n    if not outbox_id:\n        return order_service.send_fallback_chat_notice(session, text)\n    from . import outbox_service\n    if outbox_service.finalize_tracked_message(session, outbox_id, text):\n        booking.chat_notice_outbox_id = None\n        return True\n    outbox_service.cancel_or_delete(session, outbox_id)\n    booking.chat_notice_outbox_id = None\n    return order_service.send_fallback_chat_notice(session, text)\n\n\ndef passenger_show_booking(session: Session, user: User) -> None:\n    booking = booking_service.active_for_passenger(session, user)\n    if booking is None:\n        vk.send_message(user.vk_id, "У вас нет активной брони.")\n        return show_main_menu(session, user)\n    text = booking_service.format_summary(booking)\n    if booking.driver:\n        text += (\n            "\\n\\nВодитель:\\n"\n            f"{booking.driver.full_name or (\'id\' + str(booking.driver.vk_id))}\\n"\n            f"Автомобиль: {booking.driver.car_full}\\n"\n            f"Связь: {_vk_link(booking.driver)}"\n        )\n    else:\n        text += "\\n\\nВодитель пока не назначен."\n    vk.send_message(user.vk_id, text, keyboard=kb.my_booking_keyboard(booking.id))\n\n\ndef passenger_cancel_booking(session: Session, user: User, booking_id) -> None:\n    booking = (\n        session.query(Booking)\n        .filter(Booking.id == int(booking_id or 0), Booking.passenger_id == user.id)\n        .with_for_update()\n        .one_or_none()\n    )\n    if booking is None or booking.status not in booking_service.ACTIVE_STATUSES:\n        return vk.send_message(user.vk_id, "Бронь уже недоступна.")\n    timers.cancel("booking_chat", booking.id)\n    _delete_booking_chat_notice(session, booking)\n    driver = session.get(User, booking.driver_id) if booking.driver_id else None\n    was_en_route = booking.status == "driver_en_route"\n    was_pending = booking.status == "pending"\n    booking_number = booking.number\n    booking.status = "canceled"\n    booking.canceled_by = "passenger"\n    if was_en_route and booking.order_id and driver:\n        order = session.get(Order, booking.order_id)\n        if order:\n            order.status = "cancelled"\n            order.cancelled_at = time_utils.now()\n            timers.cancel_all_for_order(order.id)\n            queue_service.restore_position(session, driver)\n            fake_calls_service.create(session, order, driver)\n            reset(session, driver.vk_id, States.D_MENU)\n            vk.send_message(driver.vk_id, "Пассажир отменил бронь после вашего выезда. Создан ложный вызов.")\n            booking_service.cancel_for_order(\n                session, order.id, canceled_by="passenger"\n            )\n        reset(session, user.vk_id, States.P_FAKE_CALL_LOCK)\n        # Keep the closed row for admin history. Its canceled status and\n        # cleared driver remove it from both active booking lists immediately.\n        return\n    if driver:\n        vk.send_message(driver.vk_id, f"Бронь #{booking.number} отменена пассажиром до выезда.")\n    if was_pending:\n        order_service.send_fallback_chat_notice(\n            session,\n            f"❌ Бронь №{booking_number} отменена пассажиром до назначения водителя.",\n        )\n    session.delete(booking)\n    reset(session, user.vk_id, States.MAIN_MENU)\n    vk.send_message(user.vk_id, "Бронь отменена без последствий.")\n    show_main_menu(session, user)\n\n\ndef driver_take_booking(session: Session, user: User, booking_id) -> None:\n    booking = booking_service.take_booking(session, int(booking_id or 0), user)\n    if booking is None:\n        return vk.send_message(user.vk_id, "Эту бронь уже взял другой водитель или она отменена.")\n    timers.cancel("booking_chat", booking.id)\n    _finalize_booking_chat_notice(session, booking, user)\n    passenger = session.get(User, booking.passenger_id)\n    when = time_utils.format_local(booking.scheduled_at, "%d.%m.%Y %H:%M")\n    if passenger:\n        vk.send_message(\n            passenger.vk_id,\n            f"Вашу бронь №{booking.number} взял водитель "\n            f"{user.full_name or (\'id\' + str(user.vk_id))}.\\n"\n            f"Автомобиль: {user.car_full}.\\n"\n            f"Он будет на месте в {when}.\\n"\n            f"Связь: {_vk_link(user)}",\n        )\n    vk.send_message(user.vk_id, f"✅ Бронь #{booking.number} закреплена за вами.")\n    # Keep the current line menu: taking a future reservation must not move an\n    # on-line driver into the main menu or remove them from ordinary dispatch.\n\n\ndef driver_mark_booking_unclaimed(session: Session, user: User, booking_id) -> None:\n    booking = (\n        session.query(Booking)\n        .filter(Booking.id == int(booking_id or 0))\n        .with_for_update()\n        .one_or_none()\n    )\n    if booking is None or booking.status != "pending":\n        return vk.send_message(user.vk_id, "Эта бронь уже взята, отменена или недоступна.")\n    passenger = session.get(User, booking.passenger_id)\n    timers.cancel("booking_chat", booking.id)\n    _delete_booking_chat_notice(session, booking)\n    booking_number = booking.number\n    session.delete(booking)\n    if passenger:\n        vk.send_message(passenger.vk_id, "Не удалось найти водителя на бронь. Бронь отменена.")\n        reset(session, passenger.vk_id, States.MAIN_MENU)\n        show_main_menu(session, passenger)\n    order_service.send_fallback_chat_notice(session, f"❌ Бронь №{booking_number}: водителя найти не удалось.")\n\n\ndef driver_mark_chat_order_unclaimed(session: Session, user: User, order_id) -> None:\n    order = (\n        session.query(Order)\n        .filter(Order.id == int(order_id or 0))\n        .with_for_update()\n        .one_or_none()\n    )\n    if order is None or order.status != "chat_search":\n        return vk.send_message(user.vk_id, "Эта заявка уже взята, отменена или недоступна.")\n    label = order_service.driver_chat_reason_label(session, order) or "заявку"\n    passenger = session.get(User, order.passenger_id)\n    timers.cancel("driver_chat", order.id)\n    order_service.delete_chat_order_notice(session, order)\n    order.status = "cancelled"\n    order.cancelled_at = time_utils.now()\n    if passenger:\n        vk.send_message(passenger.vk_id, f"Не удалось найти водителя на {label}. Заявка отменена.")\n        reset(session, passenger.vk_id, States.MAIN_MENU)\n        show_main_menu(session, passenger)\n    order_service.send_fallback_chat_notice(session, f"❌ Заявка №{order.number}: водителя найти не удалось.")\n\n\ndef driver_show_taken_bookings(session: Session, user: User) -> None:\n    rows = booking_service.taken_bookings(session, user)\n    if not rows:\n        return vk.send_message(user.vk_id, "У вас нет взятых броней.")\n    for booking in rows:\n        passenger = session.get(User, booking.passenger_id)\n        passenger_info = "Пассажир: —"\n        if passenger:\n            passenger_info = (\n                f"Пассажир: {passenger.full_name or (\'id\' + str(passenger.vk_id))}\\n"\n                f"Связь: {_vk_link(passenger)}"\n            )\n        text = booking_service.format_summary(booking) + "\\n\\n" + passenger_info\n        keyboard = kb.booking_depart_keyboard(booking.id) if booking.status == "assigned" else None\n        vk.send_message(user.vk_id, text, keyboard=keyboard)\n\n\ndef driver_depart_booking(session: Session, user: User, booking_id) -> None:\n    current = active_order_for(session, user, as_driver=True)\n    if current:\n        return vk.send_message(user.vk_id, "Сначала завершите текущую активную поездку.")\n    booking = (\n        session.query(Booking)\n        .filter(Booking.id == int(booking_id or 0))\n        .with_for_update()\n        .one_or_none()\n    )\n    if booking is None or booking.driver_id != user.id or booking.status != "assigned":\n        return vk.send_message(user.vk_id, "Бронь уже недоступна для выезда.")\n    passenger = session.get(User, booking.passenger_id)\n    comment = f"Доп. услуги: {booking.extra_services or \'Нет\'}\\n{booking.comment}"\n    pickup_city, _ = lines.parse_pickup_city_for_session(session, booking.route_text)\n    order = Order(\n        passenger_id=booking.passenger_id,\n        dispatcher_id=booking.passenger_id if passenger and passenger.role == ROLE_DISPATCHER else None,\n        driver_id=user.id,\n        city_id=lines.city_id_by_name(session, pickup_city),\n        order_type="regular",\n        address_from=booking.from_address,\n        address_to=booking.to_address or booking.route_text,\n        route_text=booking.route_text,\n        comment=comment,\n        status="assigned",\n        line=pickup_city,\n        pickup_city=pickup_city,\n        driver_accept_time=time_utils.now(),\n    )\n    session.add(order)\n    session.flush()\n    booking.status = "driver_en_route"\n    booking.order_id = order.id\n    queue_service.mark_assigned(session, user)\n    if passenger:\n        vk.send_message(\n            passenger.vk_id,\n            f"Водитель {user.full_name or (\'id\' + str(user.vk_id))} выехал по вашей брони #{booking.number}.",\n            keyboard=None if passenger.role == ROLE_DISPATCHER else kb.passenger_ride_keyboard(),\n        )\n        if passenger.role != ROLE_DISPATCHER:\n            set_state(session, passenger.vk_id, States.P_IN_RIDE, {"order_id": order.id}, merge=False)\n    vk.send_message(user.vk_id, "Выезд подтверждён. Переходим к обычному сценарию поездки.")\n    _show_eta_menu(session, user, order)\n\n\ndef driver_cancel_booking(session: Session, user: User, booking_id) -> None:\n    booking = (\n        session.query(Booking)\n        .filter(Booking.id == int(booking_id or 0))\n        .with_for_update()\n        .one_or_none()\n    )\n    if booking is None or booking.driver_id != user.id or booking.status != "assigned":\n        return vk.send_message(user.vk_id, "Бронь уже недоступна для отмены.")\n    passenger = session.get(User, booking.passenger_id)\n    booking_number = booking.number\n    booking.status = "pending"\n    booking.driver_id = None\n    booking.order_id = None\n    booking.canceled_by = "driver"\n    queue_service.return_to_queue(session, user)\n    if passenger:\n        vk.send_message(passenger.vk_id, f"Водитель отменил бронь №{booking_number}. Мы снова ищем водителя.")\n    _broadcast_booking_to_driver_chat(session, booking, reopened=True)\n    vk.send_message(user.vk_id, f"Бронь #{booking_number} отменена. Она снова доступна для водителей.")\n\n\n# --------------------------------------------------------------------------- #\n#  Dispatcher flow                                                             #\n# --------------------------------------------------------------------------- #\n_DISPATCHER_REPORT_STATES = (\n    States.DISP_REPORT_INPUT,\n)\n\n\ndef _handle_dispatcher_report(session, user, state, text, payload, attachments):\n    """«Отправить отчет водителям» steps (dispatchers only).\n\n    Returns True when the message was consumed by the report flow.\n    """\n    cmd = payload.get("cmd")\n    if cmd == "disp_driver_report":\n        disp_report_start(session, user)\n        return True\n    if cmd == "cancel_flow" and state in _DISPATCHER_REPORT_STATES:\n        disp_report_cancel(session, user)\n        return True\n    if cmd:\n        return False\n    if state == States.DISP_REPORT_INPUT:\n        disp_report_submit(session, user, text, attachments)\n        return True\n    return False\n\n\ndef handle_dispatcher(session, user, state, text, payload, attachments):\n    cmd = payload.get("cmd")\n\n    # «Отправить отчет водителям»: one message containing text and a photo.\n    if state in _DISPATCHER_REPORT_STATES or cmd == "disp_driver_report":\n        if _handle_dispatcher_report(session, user, state, text, payload, attachments):\n            return\n\n    # The compact dispatcher flow uses the shared cancel keyboard whose\n    # command is ``cancel_flow``.  It must be handled before P_ADDR text input;\n    # otherwise the visible text «Отмена» is parsed as a route and immediately\n    # creates a real order.\n    cancel_text = " ".join((text or "").split()).casefold()\n    if cmd in ("cancel_flow", "cancel_order") or (\n        state == States.P_ADDR and cancel_text in {"отмена", "❌ отмена"}\n    ):\n        set_state(session, user.vk_id, States.DISP_MENU, {}, merge=False)\n        return vk.send_message(\n            user.vk_id,\n            "Создание заявки отменено.",\n            keyboard=kb.dispatcher_menu(can_switch_role(user)),\n        )\n\n    if cmd == "disp_new_order":\n        return disp_start_order(session, user)\n    if cmd == "disp_reply":\n        return dispatcher_reply_start(session, user, payload.get("order_id"))\n    if cmd == "disp_booking_menu":\n        set_state(session, user.vk_id, States.DISP_MENU, {}, merge=False)\n        return show_main_menu(session, user)\n    if cmd == "disp_booking_new":\n        return passenger_booking_start(session, user)\n    if cmd == "disp_bookings":\n        return disp_show_bookings(session, user, payload.get("page", 1))\n    if cmd == "disp_booking_cancel":\n        return disp_cancel_booking(session, user, payload.get("booking_id"), payload.get("page", 1))\n    if cmd == "booking_fill":\n        return passenger_booking_fill(session, user)\n    if cmd == "booking_back":\n        set_state(session, user.vk_id, States.DISP_MENU, {}, merge=False)\n        return show_main_menu(session, user)\n    if cmd == "booking_type":\n        return passenger_booking_type(session, user, payload.get("type"))\n    if cmd == "booking_date_quick":\n        return passenger_booking_date_quick(session, user, payload.get("days"))\n    if cmd == "booking_date_custom":\n        return passenger_booking_date_custom(session, user)\n    if cmd == "booking_comment_skip":\n        return passenger_booking_comment(session, user, "")\n    if cmd == "booking_confirm":\n        return passenger_booking_confirm(session, user)\n    if cmd == "toggle_service" and state == States.P_BOOKING_EXTRAS:\n        return passenger_booking_toggle_extra(session, user, payload.get("service"))\n    if cmd == "extras_done" and state == States.P_BOOKING_EXTRAS:\n        return passenger_booking_extras_done(session, user)\n    if cmd == "drivers":\n        return show_all_drivers(session, user)\n    if cmd == "queue":\n        return show_queue(session, user, dispatcher_view=True)\n    if cmd == "price":\n        return show_price(session, user)\n    if cmd == "price_section":\n        return show_price_section(session, user, payload.get("key"))\n    if cmd == "price_calculate":\n        return retired_price_calculator(session, user)\n    if cmd == "price_back":\n        return return_from_price(session, user)\n    if cmd == "disp_orders":\n        return disp_show_orders(session, user, payload.get("page", 1))\n    if cmd == "disp_order":\n        return disp_show_order(session, user, payload.get("order_id"))\n    if cmd == "disp_cancel_order":\n        return disp_cancel_order(session, user, payload.get("order_id"))\n    if cmd == "toggle_service":\n        return toggle_extra_service(session, user, payload.get("service"))\n    if cmd == "extras_done":\n        return finish_extras(session, user)\n    if cmd == "edit_order":\n        return start_edit_order(session, user)\n    if cmd == "confirm_order":\n        return disp_create_order_from_draft(session, user)\n    if state == States.P_ADDR:\n        voice_attachment = vk.voice_attachment_reference(attachments)\n        if voice_attachment:\n            return order_set_voice(session, user, voice_attachment)\n        return order_set_addresses(session, user, text)\n    if state == States.P_BOOKING_TIME:\n        return passenger_booking_time(session, user, text)\n    if state == States.P_BOOKING_DATE:\n        return passenger_booking_date_input(session, user, text)\n    if state == States.P_BOOKING_ADDRESS:\n        return passenger_booking_address(session, user, text)\n    if state == States.P_BOOKING_COMMENT:\n        return passenger_booking_comment(session, user, text)\n    if state == "passenger_price_calc_route":\n        return retired_price_calculator(session, user)\n    if state == States.DISP_CHAT_REPLY:\n        return dispatcher_reply_send(session, user, text, attachments)\n\n    return show_main_menu(session, user)\n\n\ndef disp_show_bookings(session: Session, user: User, page=1) -> None:\n    page_size = 6\n    try:\n        page = max(1, int(page or 1))\n    except (TypeError, ValueError):\n        page = 1\n    query = session.query(Booking).filter(\n        Booking.passenger_id == user.id,\n        Booking.status.in_(booking_service.ACTIVE_STATUSES),\n    )\n    total = query.count()\n    if not total:\n        return vk.send_message(\n            user.vk_id,\n            "У вас нет активных броней.",\n            keyboard=kb.dispatcher_menu(can_switch_role(user)),\n        )\n    total_pages = max(1, (total + page_size - 1) // page_size)\n    page = min(page, total_pages)\n    rows = query.order_by(Booking.scheduled_at.asc()).offset((page - 1) * page_size).limit(page_size).all()\n    text = "🗓 Мои брони:\\n\\n" + "\\n\\n".join(booking_service.format_summary(row) for row in rows)\n    items = [\n        (row.id, row.number, time_utils.format_local(row.scheduled_at, "%d.%m %H:%M"))\n        for row in rows\n    ]\n    vk.send_message(\n        user.vk_id,\n        text,\n        keyboard=kb.dispatcher_bookings_keyboard(items, page, total_pages),\n    )\n\n\ndef disp_cancel_booking(session: Session, user: User, booking_id, page=1) -> None:\n    booking = (\n        session.query(Booking)\n        .filter(Booking.id == int(booking_id or 0), Booking.passenger_id == user.id)\n        .with_for_update()\n        .one_or_none()\n    )\n    if booking is None or booking.status not in booking_service.ACTIVE_STATUSES:\n        vk.send_message(user.vk_id, "Бронь уже отменена или завершена.")\n        return disp_show_bookings(session, user, page)\n    timers.cancel("booking_chat", booking.id)\n    _delete_booking_chat_notice(session, booking)\n    driver = session.get(User, booking.driver_id) if booking.driver_id else None\n    if booking.order_id:\n        order = session.get(Order, booking.order_id)\n        if order:\n            order.status = "cancelled"\n            order.cancelled_at = time_utils.now()\n            order.cancelled_by = "dispatcher"\n            timers.cancel_all_for_order(order.id)\n            if driver:\n                queue_service.restore_position(session, driver)\n                reset(session, driver.vk_id, States.D_MENU)\n    if driver:\n        vk.send_message(driver.vk_id, f"Бронь №{booking.number} отменена диспетчером.")\n    booking_number = booking.number\n    session.delete(booking)\n    session.flush()\n    vk.send_message(user.vk_id, f"Бронь №{booking_number} отменена.")\n    return disp_show_bookings(session, user, page)\n\n\ndef disp_start_order(session: Session, user: User) -> None:\n    # Same compact creation flow as for passengers, but without the one-active\n    # order restriction: dispatchers may create any number of orders.\n    set_state(session, user.vk_id, States.P_ADDR,\n              {"draft": {"order_type": "regular", "dispatcher": True}}, merge=False)\n    vk.send_message(user.vk_id, msg(session, "msg_ask_addresses"), keyboard=kb.cancel_keyboard())\n\n\ndef disp_create_order_from_draft(session: Session, user: User) -> None:\n    data = get_data(session, user.vk_id)\n    draft = data.get("draft", {})\n    if not draft.get("address_from") or not draft.get("address_to"):\n        return disp_start_order(session, user)\n    selection = data.get("extras", [])\n    order_type = (\n        draft.get("order_type")\n        if draft.get("order_type") in ("delivery", delivery_service.PARTNER_DELIVERY_TYPE)\n        else "regular"\n    )\n    car_count = (\n        2\n        if order_type == "regular"\n        and int(draft.get("requested_car_count") or 1) == 2\n        else 1\n    )\n    orders = []\n    for _car_index in range(car_count):\n        order = Order(\n            passenger_id=user.id, dispatcher_id=user.id,\n            city_id=draft.get("city_id"),\n            address_from=draft["address_from"], address_to=draft["address_to"],\n            route_text=draft.get("route_text"), voice_attachment=draft.get("voice_attachment"),\n            comment=draft.get("comment"),\n            order_type=order_type, status="created", line=draft.get("line"),\n            pickup_city=draft.get("pickup_city"),\n            extra_services=extra_services.to_json(selection),\n            night_surcharge=(order_type == "regular" and night_tariff.is_night(session)),\n            customer_name=draft.get("customer_name"),\n            customer_phone=draft.get("customer_phone"),\n            customer_price=draft.get("customer_price"),\n            # A freshly created dispatcher order has no refusal history and has\n            # not entered a route fallback stage.\n            last_decline_reason=None,\n            parallel_route_fallback=False,\n        )\n        session.add(order)\n        session.flush()\n        orders.append(order)\n        timers.schedule(\n            "dispatcher_unclaimed",\n            order.id,\n            30 * 60,\n            lambda order_id=order.id: passenger_queue._dispatcher_unclaimed_timeout(order_id),\n        )\n    set_state(session, user.vk_id, States.DISP_MENU, {}, merge=False)\n    if parallel_orders.local_village_line(orders[0]):\n        confirmation = "✅ Заявка создана. Ищем водителя на соответствующей линии."\n    elif car_count == 2:\n        # До V130 две заявки уходили «по порядку очереди»; теперь обе идут в чат.\n        ids = " и ".join(f"#{order.number}" for order in orders)\n        confirmation = (\n            f"✅ Созданы две заявки: {ids}. "\n            "Они отправлены в водительский чат."\n        )\n    else:\n        confirmation = f"✅ Заявка #{orders[0].number} создана и отправлена в водительский чат."\n    vk.send_message(\n        user.vk_id,\n        confirmation,\n        keyboard=kb.dispatcher_menu(can_switch_role(user)),\n    )\n    for order in orders:\n        # Dispatcher requests use the normal first-free-driver offer. On a\n        # 60-second unanswered offer, order_service moves them to the shared\n        # driver chat and mentions @all.\n        # The actual first offer is still made by offer_to_next_driver inside\n        # dispatch_new_order, preserving route-line priority and ETA flow.\n        # Compatibility marker: order_service.offer_to_next_driver(session, order)\n        passenger_queue.dispatch_new_order(session, order)\n\n\n\n_DISPATCHER_ACTIVE_STATUSES = {\n    "created": "создана", "searching": "водитель рассматривает",\n    "queued": "ждёт водителя", "chat_search": "ищем через чат",\n    "parallel_assigned": "водитель назначен", "assigned": "водитель взял заявку",\n    "arrived": "водитель подъехал", "in_progress": "выполняется",\n}\n\n\ndef disp_show_orders(session: Session, user: User, page=1) -> None:\n    """Show dispatcher orders in VK-safe pages, including 50+ active orders."""\n    per_page = 8  # eight rows + navigation + menu stay within VK\'s row limit\n    try:\n        page = max(1, int(page))\n    except (TypeError, ValueError):\n        page = 1\n    base = (session.query(Order)\n        .filter(Order.dispatcher_id == user.id, Order.status.in_(tuple(_DISPATCHER_ACTIVE_STATUSES))))\n    total = base.count()\n    if not total:\n        return vk.send_message(user.vk_id, "У вас нет заявок, которые ждут водителя или уже взяты водителем.", keyboard=kb.dispatcher_menu(can_switch_role(user)))\n    total_pages = max(1, (total + per_page - 1) // per_page)\n    page = min(page, total_pages)\n    orders = (base.order_by(Order.created_at.desc())\n        .offset((page - 1) * per_page).limit(per_page).all())\n    items, lines = [], [f"📋 Мои заявки: {total} (страница {page}/{total_pages})"]\n    for order in orders:\n        label = _DISPATCHER_ACTIVE_STATUSES[order.status]\n        route = order.route_text or f"{order.address_from} → {order.address_to}"\n        lines.append(f"#{order.number} — {label}\\n{route}")\n        items.append((order.id, order.number, label))\n    vk.send_message(\n        user.vk_id,\n        "\\n\\n".join(lines),\n        keyboard=kb.dispatcher_orders_keyboard(items, page=page, total_pages=total_pages),\n    )\n\ndef disp_show_order(session: Session, user: User, order_id) -> None:\n    order = session.get(Order, int(order_id or 0))\n    if not order or order.dispatcher_id != user.id or order.status not in _DISPATCHER_ACTIVE_STATUSES:\n        return disp_show_orders(session, user)\n    route = order.route_text or f"{order.address_from} → {order.address_to}"\n    lines = [f"Заявка #{order.number}", f"Статус: {_DISPATCHER_ACTIVE_STATUSES[order.status]}", f"Маршрут: {route}"]\n    driver = session.get(User, order.driver_id) if order.driver_id else None\n    if driver:\n        lines.append(f"Водитель: {driver.full_name or (\'id\' + str(driver.vk_id))}, {driver.car_full}")\n    vk.send_message(user.vk_id, "\\n".join(lines), keyboard=kb.dispatcher_order_keyboard(order.id, order.number))\n\n\ndef disp_cancel_order(session: Session, user: User, order_id) -> None:\n    order = (session.query(Order)\n        .filter(Order.id == int(order_id or 0), Order.dispatcher_id == user.id)\n        .with_for_update().one_or_none())\n    if not order or order.status not in _DISPATCHER_ACTIVE_STATUSES:\n        return disp_show_orders(session, user)\n    previous_status = order.status\n    reserved_driver = (\n        session.get(User, order.parallel_driver_id)\n        if order.parallel_driver_id and previous_status == "parallel_assigned"\n        else None\n    )\n    driver = (\n        session.get(User, order.driver_id)\n        if order.driver_id and previous_status != "parallel_assigned"\n        else None\n    )\n    from . import parallel_orders\n    # Close one-minute route cards tied to the trip before freeing its driver.\n    parallel_orders.release_route_offers_for_trip(session, order)\n    order.status = "cancelled"\n    order.cancelled_at = time_utils.now()\n    order.cancelled_by = "dispatcher"\n    passenger_queue.remove(session, order.id)\n    timers.cancel_all_for_order(order.id)\n    if order.offered_driver_id and not order.driver_id:\n        offered = session.get(User, order.offered_driver_id)\n        if offered:\n            queue_service.release_offer(session, offered)\n            vk.send_message(offered.vk_id, f"Диспетчер отменил заявку #{order.number}.")\n        order.offered_driver_id = None\n    if reserved_driver:\n        order.parallel_driver_id = None\n        order.driver_id = None  # compatibility repair for pre-V165 rows\n        current = (\n            session.query(Order)\n            .filter(\n                Order.driver_id == reserved_driver.id,\n                Order.status.in_(parallel_orders.ACTIVE),\n            )\n            .order_by(Order.created_at.asc())\n            .first()\n        )\n        if current:\n            set_state(\n                session,\n                reserved_driver.vk_id,\n                States.D_IN_RIDE,\n                {"order_id": current.id},\n                merge=False,\n            )\n            vk.send_message(\n                reserved_driver.vk_id,\n                f"Диспетчер отменил параллельную заявку #{order.number}. "\n                f"Текущая заявка #{current.number} продолжается.",\n                keyboard=_driver_ride_kb(session, current),\n            )\n        else:\n            queue_service.restore_position(session, reserved_driver)\n            reset(session, reserved_driver.vk_id, States.D_MENU)\n            vk.send_message(\n                reserved_driver.vk_id,\n                f"Диспетчер отменил параллельную заявку #{order.number}. "\n                "Вы возвращены в очередь.",\n                keyboard=kb.driver_menu(\n                    on_line=reserved_driver.is_on_line,\n                    show_role_switch=can_switch_role(reserved_driver),\n                ),\n            )\n    if driver:\n        vk.send_message(driver.vk_id, f"Диспетчер отменил заявку #{order.number}. Ложный вызов не начисляется.")\n        if parallel_orders.has_pending(session, driver):\n            parallel_orders.promote_after_current(session, driver)\n        else:\n            if order.order_type in ("delivery", "partner_delivery"):\n                queue_service.move_to_front(session, driver)\n            else:\n                queue_service.restore_position(session, driver)\n            reset(session, driver.vk_id, States.D_MENU)\n            show_main_menu(session, driver)\n    vk.send_message(user.vk_id, f"✅ Заявка #{order.number} отменена. Ложный вызов не создан.", keyboard=kb.dispatcher_menu(can_switch_role(user)))\n\ndef disp_report_start(session: Session, user: User) -> None:\n    """Ask a dispatcher for one message containing both text and a photo."""\n    vk.send_message(\n        user.vk_id,\n        "📤 Отчет водителям.\\n\\n"\n        "Отправьте одним сообщением:\\n"\n        "• фотографию;\\n"\n        "• текст отчета с указанием реквизитов.\\n\\n"\n        "После отправки отчет получат все пользователи с ролью водителя.",\n        keyboard=kb.cancel_keyboard(),\n    )\n    set_state(session, user.vk_id, States.DISP_REPORT_INPUT, {}, merge=False)\n\n\ndef disp_report_submit(\n    session: Session,\n    user: User,\n    text: str,\n    attachments,\n) -> None:\n    """Validate and immediately broadcast a dispatcher report to drivers."""\n    if not user.has_role(ROLE_DISPATCHER):\n        set_state(session, user.vk_id, States.DISP_MENU, {}, merge=False)\n        return vk.send_message(user.vk_id, "Недостаточно прав.")\n\n    text = (text or "").strip()\n    if not text:\n        return vk.send_message(\n            user.vk_id,\n            "Текст не найден. Отправьте фотографию и текст с реквизитами одним сообщением.",\n            keyboard=kb.cancel_keyboard(),\n        )\n\n    # Only a VK photo is accepted. Documents, videos and other attachments\n    # must never be forwarded by this dispatcher-only flow.\n    photos = [\n        attachment\n        for attachment in (attachments or [])\n        if attachment.get("type") == "photo"\n    ]\n    if not photos:\n        return vk.send_message(\n            user.vk_id,\n            "Фотография не найдена. Отправьте фотографию и текст с реквизитами одним сообщением.",\n            keyboard=kb.cancel_keyboard(),\n        )\n\n    uploaded = vk.reupload_attachments(user.vk_id, photos[:1])\n    if not uploaded:\n        return vk.send_message(\n            user.vk_id,\n            "Не удалось обработать фотографию. Отправьте сообщение ещё раз.",\n            keyboard=kb.cancel_keyboard(),\n        )\n    attachment = ",".join(uploaded)\n    set_state(session, user.vk_id, States.DISP_MENU, {}, merge=False)\n    # target="driver" reaches every user with the driver role — and only them.\n    broadcast_service.start(user.vk_id, text, attachment, "driver")\n    vk.send_message(\n        user.vk_id,\n        "✅ Отчет отправляется всем водителям. Ожидайте отчёт о доставке.",\n        keyboard=kb.dispatcher_menu(can_switch_role(user)),\n    )\n\n\ndef disp_report_cancel(session: Session, user: User) -> None:\n    set_state(session, user.vk_id, States.DISP_MENU, {}, merge=False)\n    vk.send_message(\n        user.vk_id,\n        "Отправка отчета отменена.",\n        keyboard=kb.dispatcher_menu(can_switch_role(user)),\n    )\n\n\n# --------------------------------------------------------------------------- #\n#  Admin flow (in-bot)                                                         #\n# --------------------------------------------------------------------------- #\ndef handle_admin(session, user, state, text, payload, attachments):\n    cmd = payload.get("cmd")\n\n    if cmd == "admin_broadcast":\n        vk.send_message(user.vk_id, "Введите обязательный текст рассылки:", keyboard=kb.cancel_keyboard())\n        return set_state(session, user.vk_id, States.ADM_BROADCAST_TEXT, {}, merge=False)\n    if cmd == "broadcast_no_media":\n        return admin_broadcast_media(session, user, [], skip=True)\n    if cmd == "broadcast_send":\n        return admin_broadcast_send(session, user, payload.get("target", "all"))\n    if cmd == "admin_messages":\n        return admin_list_messages(session, user)\n    if cmd == "admin_back":\n        return show_main_menu(session, user)\n    if cmd == "edit_msg":\n        return admin_edit_message(session, user, payload.get("key"))\n    if cmd == "skip_photo":\n        return admin_save_message_photo(session, user, None, skip=True)\n    if cmd == "admin_price":\n        return admin_list_price_sections(session, user)\n    if cmd == "edit_price":\n        return admin_edit_price_section(session, user, payload.get("key"))\n    if cmd == "skip_price_title":\n        return admin_save_price_title(session, user, None, skip=True)\n    if cmd == "skip_price_photo":\n        return admin_save_price_photo(session, user, None, skip=True)\n    if cmd == "admin_add_driver":\n        vk.send_message(user.vk_id, "Отправьте ссылку на страницу (например, https://vk.ru/brodiaga59), @короткое_имя или числовой VK ID пользователя, которого назначить водителем:", keyboard=kb.cancel_keyboard())\n        return set_state(session, user.vk_id, States.ADM_ADD_DRIVER)\n    if cmd == "admin_add_dispatcher":\n        vk.send_message(user.vk_id, "Отправьте ссылку VK.ru/VK.com, @юзернейм или числовой VK ID пользователя, которого назначить диспетчером:", keyboard=kb.cancel_keyboard())\n        return set_state(session, user.vk_id, States.ADM_ADD_DISPATCHER)\n    if cmd == "admin_temp_driver":\n        vk.send_message(\n            user.vk_id,\n            "Отправьте страницу пользователя и время выдачи роли.\\n\\n"\n            "Поддерживаются ссылка VK.ru/VK.com, @юзернейм, id123 или числовой ID.\\n"\n            "Выдать сразу: https://vk.ru/id123456 1 день\\n"\n            "Выдать в указанное время на сутки: https://vk.ru/id123456 20.08 12:00\\n"\n            "Другой срок: https://vk.ru/id123456 20.08 12:00 на 3 дня",\n            keyboard=kb.cancel_keyboard(),\n        )\n        return set_state(session, user.vk_id, States.ADM_TEMP_DRIVER)\n    if cmd == "admin_remove_role":\n        vk.send_message(user.vk_id, "Отправьте ссылку на страницу VK пользователя, у которого нужно удалить роль администратора:", keyboard=kb.cancel_keyboard())\n        return set_state(session, user.vk_id, States.ADM_REMOVE_ROLE)\n    if cmd == "admin_block_user":\n        vk.send_message(\n            user.vk_id,\n            "Отправьте любую ссылку на страницу VK, @короткое_имя или числовой VK ID. "\n            "Если пользователь активен — он будет заблокирован, если уже заблокирован — разблокирован.",\n            keyboard=kb.cancel_keyboard(),\n        )\n        return set_state(session, user.vk_id, States.ADM_BLOCK_USER)\n    if cmd == "adm_revoke":\n        return admin_revoke_role(session, user, payload.get("uid"), payload.get("role"))\n    if cmd == "cancel_flow":\n        return show_main_menu(session, user)\n\n    # State-driven text input\n    if state == States.ADM_ADD_DRIVER:\n        return admin_assign_role(session, user, text, ROLE_DRIVER)\n    if state == States.ADM_ADD_DISPATCHER:\n        return admin_assign_role(session, user, text, ROLE_DISPATCHER)\n    if state == States.ADM_TEMP_DRIVER:\n        return admin_assign_temporary_driver(session, user, text)\n    if state == States.ADM_REMOVE_ROLE:\n        return admin_remove_role(session, user, text)\n    if state == States.ADM_BLOCK_USER:\n        return admin_toggle_user_block(session, user, text)\n    if state == States.ADM_MSG_TEXT:\n        return admin_save_message_text(session, user, text)\n    if state == States.ADM_MSG_PHOTO:\n        return admin_save_message_photo(session, user, attachments)\n    if state == States.ADM_PRICE_TITLE:\n        return admin_save_price_title(session, user, text)\n    if state == States.ADM_PRICE_TEXT:\n        return admin_save_price_text(session, user, text)\n    if state == States.ADM_PRICE_PHOTO:\n        return admin_save_price_photo(session, user, attachments)\n    if state == States.ADM_BROADCAST_TEXT:\n        return admin_broadcast_text(session, user, text)\n    if state == States.ADM_BROADCAST_MEDIA:\n        return admin_broadcast_media(session, user, attachments)\n\n    return show_main_menu(session, user)\n\n\ndef admin_broadcast_text(session: Session, user: User, text: str) -> None:\n    text = (text or "").strip()\n    if not text:\n        return vk.send_message(user.vk_id, "Текст обязателен. Введите текст рассылки:")\n    set_state(session, user.vk_id, States.ADM_BROADCAST_MEDIA, {"broadcast_text": text, "broadcast_attachment": None}, merge=False)\n    vk.send_message(user.vk_id, "Прикрепите фото, видео или документ одним сообщением либо нажмите «Без медиа».", keyboard=kb.broadcast_media_keyboard())\n\n\ndef admin_broadcast_media(session: Session, user: User, attachments, skip: bool = False) -> None:\n    data = get_data(session, user.vk_id)\n    media = None\n    if not skip:\n        uploaded = vk.reupload_attachments(user.vk_id, attachments or [])\n        if not uploaded:\n            return vk.send_message(user.vk_id, "Медиа не найдено. Прикрепите файл или нажмите «Без медиа».", keyboard=kb.broadcast_media_keyboard())\n        media = ",".join(uploaded)\n    set_state(session, user.vk_id, States.ADM_BROADCAST_MEDIA, {"broadcast_attachment": media})\n    vk.send_message(user.vk_id, "Выберите получателей и запустите рассылку:", keyboard=kb.broadcast_target_keyboard())\n\n\ndef admin_broadcast_send(session: Session, user: User, target: str) -> None:\n    if not user.has_role(ROLE_ADMIN):\n        return vk.send_message(user.vk_id, "Недостаточно прав.")\n    data = get_data(session, user.vk_id)\n    text = (data.get("broadcast_text") or "").strip()\n    if not text:\n        return vk.send_message(user.vk_id, "Текст рассылки потерян. Начните заново.", keyboard=kb.admin_menu(can_switch_role(user)))\n    broadcast_service.start(user.vk_id, text, data.get("broadcast_attachment"), target if target in ("all", "driver", "passenger") else "all")\n    vk.send_message(user.vk_id, "Рассылка запущена. Ожидайте отчёт о доставке", keyboard=kb.admin_menu(can_switch_role(user)))\n    set_state(session, user.vk_id, States.ADM_MENU, {}, merge=False)\n\n\ndef admin_list_messages(session: Session, user: User) -> None:\n    bm.ensure_defaults(session)\n    keys_titles = [(k, bm.title_for(k)) for k in bm.all_keys()]\n    vk.send_message(\n        user.vk_id,\n        "✉️ Сообщения бота. Выберите, что отредактировать:",\n        keyboard=kb.admin_messages_keyboard(keys_titles),\n    )\n    set_state(session, user.vk_id, States.ADM_MENU)\n\n\ndef admin_edit_message(session: Session, user: User, key: str | None) -> None:\n    if not key:\n        return admin_list_messages(session, user)\n    current, file_id = bm.get_message(session, key)\n    preview = current or "(пусто)"\n    vk.send_message(\n        user.vk_id,\n        f"Текущий текст «{bm.title_for(key)}»:\\n\\n{preview}\\n\\nВведите новый текст сообщения:",\n        keyboard=kb.cancel_keyboard(),\n    )\n    set_state(session, user.vk_id, States.ADM_MSG_TEXT, {"edit_key": key}, merge=False)\n\n\ndef admin_save_message_text(session: Session, user: User, text: str) -> None:\n    data = get_data(session, user.vk_id)\n    key = data.get("edit_key")\n    if not key:\n        return admin_list_messages(session, user)\n    bm.set_message(session, key, text=text)\n    vk.send_message(\n        user.vk_id,\n        "Текст сохранён. Прикрепите фото к сообщению или нажмите «Без фото».",\n        keyboard=kb.skip_photo_keyboard(),\n    )\n    set_state(session, user.vk_id, States.ADM_MSG_PHOTO, {"edit_key": key})\n\n\ndef admin_save_message_photo(session: Session, user: User, attachments, skip: bool = False) -> None:\n    data = get_data(session, user.vk_id)\n    key = data.get("edit_key")\n    if not key:\n        return admin_list_messages(session, user)\n    if skip:\n        vk.send_message(user.vk_id, "Готово. Фото оставлено без изменений.", keyboard=kb.admin_menu(can_switch_role(user)))\n        return show_main_menu(session, user)\n    file_id = None\n    for att in attachments or []:\n        if att.get("type") == "photo":\n            reup = vk.reupload_attachments(user.vk_id, [att])\n            if reup:\n                file_id = reup[0]\n            break\n    if file_id:\n        bm.set_message(session, key, file_id=file_id, update_file=True)\n        vk.send_message(user.vk_id, "✅ Фото сохранено.", keyboard=kb.admin_menu(can_switch_role(user)))\n    else:\n        vk.send_message(user.vk_id, "Фото не найдено. Сообщение сохранено без фото.", keyboard=kb.admin_menu(can_switch_role(user)))\n    show_main_menu(session, user)\n\n\ndef admin_list_price_sections(session: Session, user: User) -> None:\n    """Requirement: «Прайс / Популярные направления» editing from the admin menu."""\n    ps.ensure_defaults(session)\n    keys_titles = [(k, ps.title_for(k)) for k in ps.all_keys()]\n    vk.send_message(\n        user.vk_id,\n        "🏷 Прайс / Направления. Выберите раздел, чтобы отредактировать заголовок кнопки, "\n        "текст и фото:",\n        keyboard=kb.admin_price_keyboard(keys_titles),\n    )\n    set_state(session, user.vk_id, States.ADM_MENU)\n\n\ndef admin_edit_price_section(session: Session, user: User, key: str | None) -> None:\n    if not key:\n        return admin_list_price_sections(session, user)\n    row = ps.get_section(session, key)\n    current_title = (row.title if row else None) or ps.title_for(key)\n    vk.send_message(\n        user.vk_id,\n        f"Раздел «{ps.title_for(key)}».\\nТекущее название кнопки: «{current_title}»\\n\\n"\n        f"Введите новое название кнопки, или нажмите «Оставить как есть»:",\n        keyboard=kb.skip_price_title_keyboard(),\n    )\n    set_state(session, user.vk_id, States.ADM_PRICE_TITLE, {"edit_key": key}, merge=False)\n\n\ndef admin_save_price_title(session: Session, user: User, text: str | None, skip: bool = False) -> None:\n    data = get_data(session, user.vk_id)\n    key = data.get("edit_key")\n    if not key:\n        return admin_list_price_sections(session, user)\n    if not skip:\n        title = (text or "").strip()\n        if not title:\n            vk.send_message(user.vk_id, "Название не может быть пустым. Введите ещё раз:", keyboard=kb.skip_price_title_keyboard())\n            return\n        current = ps.get_section(session, key)\n        old_title = (current.title if current else "") or ""\n        ps.set_section(session, key, title=title)\n        if title != old_title:\n            broadcast_service.start(\n                user.vk_id,\n                f"🏷 Изменение прайса\\nНазвание: {title}",\n                None,\n                "driver",\n            )\n\n    row = ps.get_section(session, key)\n    preview = (row.content if row else "") or "(пусто)"\n    vk.send_message(\n        user.vk_id,\n        f"Текущий текст раздела:\\n\\n{preview}\\n\\nВведите новый текст, который увидит пассажир:",\n        keyboard=kb.cancel_keyboard(),\n    )\n    set_state(session, user.vk_id, States.ADM_PRICE_TEXT, {"edit_key": key})\n\n\ndef admin_save_price_text(session: Session, user: User, text: str) -> None:\n    data = get_data(session, user.vk_id)\n    key = data.get("edit_key")\n    if not key:\n        return admin_list_price_sections(session, user)\n    text = (text or "").strip()\n    if not text:\n        vk.send_message(user.vk_id, "Текст не может быть пустым. Введите ещё раз:", keyboard=kb.cancel_keyboard())\n        return\n    current = ps.get_section(session, key)\n    old_content = (current.content if current else "") or ""\n    ps.set_section(session, key, content=text)\n    changed_lines = ps.changed_content_lines(old_content, text)\n    if changed_lines:\n        broadcast_service.start(\n            user.vk_id,\n            "🏷 Изменение прайса\\n" + "\\n".join(changed_lines),\n            None,\n            "driver",\n        )\n    vk.send_message(\n        user.vk_id,\n        "Текст сохранён. Прикрепите фото к разделу или нажмите «Без фото».",\n        keyboard=kb.skip_price_photo_keyboard(),\n    )\n    set_state(session, user.vk_id, States.ADM_PRICE_PHOTO, {"edit_key": key})\n\n\ndef admin_save_price_photo(session: Session, user: User, attachments, skip: bool = False) -> None:\n    data = get_data(session, user.vk_id)\n    key = data.get("edit_key")\n    if not key:\n        return admin_list_price_sections(session, user)\n    if skip:\n        vk.send_message(user.vk_id, "Готово. Фото оставлено без изменений.", keyboard=kb.admin_menu(can_switch_role(user)))\n        return show_main_menu(session, user)\n    file_id = None\n    for att in attachments or []:\n        if att.get("type") == "photo":\n            reup = vk.reupload_attachments(user.vk_id, [att])\n            if reup:\n                file_id = reup[0]\n            break\n    if file_id:\n        ps.set_section(session, key, file_id=file_id, update_file=True)\n        vk.send_message(user.vk_id, "✅ Фото сохранено.", keyboard=kb.admin_menu(can_switch_role(user)))\n    else:\n        vk.send_message(user.vk_id, "Фото не найдено. Раздел сохранён без фото.", keyboard=kb.admin_menu(can_switch_role(user)))\n    show_main_menu(session, user)\n\n\ndef _resolve_target(session: Session, text: str) -> User | None:\n    vk_id = vk.resolve_user_id(text)\n    if not vk_id:\n        return None\n    target = session.query(User).filter(User.vk_id == vk_id).one_or_none()\n    if target is None:\n        target = User(vk_id=vk_id, full_name=vk.full_name(vk_id))\n        session.add(target)\n        session.flush()\n    return target\n\n\ndef admin_toggle_user_block(session: Session, user: User, text: str) -> None:\n    if not user.has_role(ROLE_ADMIN):\n        return vk.send_message(user.vk_id, "Недостаточно прав.")\n    target = _resolve_target(session, text)\n    if not target:\n        return vk.send_message(\n            user.vk_id,\n            "Не удалось распознать страницу VK. Отправьте ссылку, @короткое_имя или числовой VK ID:",\n            keyboard=kb.cancel_keyboard(),\n        )\n    if target.id == user.id:\n        return vk.send_message(\n            user.vk_id,\n            "Нельзя заблокировать самого себя.",\n            keyboard=kb.admin_menu(can_switch_role(user)),\n        )\n    blocked_row = session.query(BlockedUser).filter(BlockedUser.vk_id == target.vk_id).one_or_none()\n    currently_blocked = bool(target.is_blocked or blocked_row)\n    name = target.full_name or ("id" + str(target.vk_id))\n    if currently_blocked:\n        target.is_blocked = False\n        session.query(BlockedUser).filter(BlockedUser.vk_id == target.vk_id).delete()\n        _invalidate_blocked_cache()\n        vk.send_message(target.vk_id, "✅ Администратор разблокировал вам доступ к боту. Напишите «Меню».")\n        result = f"✅ Пользователь {name} (id{target.vk_id}) разблокирован."\n    else:\n        target.is_blocked = True\n        if not blocked_row:\n            session.add(BlockedUser(\n                vk_id=target.vk_id,\n                reason=f"Заблокирован администратором id{user.vk_id}",\n                notice_sent=False,\n            ))\n        if target.driver_status != "offline" or target.is_on_line:\n            queue_service.leave_queue(session, target)\n            target.is_on_line = False\n        _invalidate_blocked_cache()\n        result = f"🚫 Пользователь {name} (id{target.vk_id}) заблокирован. При первом обращении бот уведомит один раз, затем будет молчать."\n    vk.send_message(user.vk_id, result, keyboard=kb.admin_menu(can_switch_role(user)))\n    set_state(session, user.vk_id, States.ADM_MENU, {}, merge=False)\n\n\ndef admin_assign_role(session: Session, user: User, text: str, role: str) -> None:\n    target = _resolve_target(session, text)\n    if not target:\n        vk.send_message(user.vk_id, "Не удалось распознать VK ID. Попробуйте ещё раз:")\n        return\n    target.grant_role(role)\n    if role == ROLE_DRIVER:\n        # Explicit «Водителя» makes a previous temporary grant permanent.\n        target.temporary_driver_starts_at = None\n        target.temporary_driver_until = None\n    role_title = {"driver": "водитель", "dispatcher": "диспетчер"}.get(role, role)\n    vk.send_message(\n        user.vk_id,\n        f"✅ Пользователь {target.full_name} (id{target.vk_id}) теперь {role_title}.",\n        keyboard=kb.admin_menu(can_switch_role(user)),\n    )\n    vk.send_message(target.vk_id, f"Вам назначена роль: {role_title}. Напишите «Меню».")\n    show_main_menu(session, user)\n\n\ndef _parse_temporary_driver_request(text: str) -> tuple[str, int] | None:\n    """Parse «profile reference N day(s)» from the admin\'s single message."""\n    match = re.match(\n        r"^\\s*(.+?)\\s+(\\d+)\\s*(?:день|дня|дней|дн\\.?|day|days)\\s*$",\n        text or "",\n        flags=re.IGNORECASE,\n    )\n    if not match:\n        return None\n    days = int(match.group(2))\n    if days < 1 or days > 365:\n        return None\n    return match.group(1).strip(), days\n\n\ndef _days_word(days: int) -> str:\n    if 10 <= days % 100 <= 20:\n        return "дней"\n    if days % 10 == 1:\n        return "день"\n    if 2 <= days % 10 <= 4:\n        return "дня"\n    return "дней"\n\n\ndef _scheduled_local_datetime(\n    day: int,\n    month: int,\n    hour: int,\n    minute: int,\n    year: int | None = None,\n    now: dt.datetime | None = None,\n) -> dt.datetime | None:\n    """Build the next future Asia/Yekaterinburg datetime from admin input."""\n    now = now or time_utils.now()\n    target_year = year or now.year\n    try:\n        naive = dt.datetime(target_year, month, day, hour, minute)\n    except ValueError:\n        return None\n    timezone = time_utils.LOCAL_TZ\n    target = timezone.localize(naive) if hasattr(timezone, "localize") else naive.replace(tzinfo=timezone)\n    if year is None and target <= now:\n        try:\n            naive = naive.replace(year=target_year + 1)\n        except ValueError:\n            return None\n        target = timezone.localize(naive) if hasattr(timezone, "localize") else naive.replace(tzinfo=timezone)\n    if target <= now or target - now > dt.timedelta(days=366):\n        return None\n    return target\n\n\ndef _parse_scheduled_temporary_driver_request(\n    text: str,\n    now: dt.datetime | None = None,\n) -> tuple[str, dt.datetime, int] | None:\n    """Parse «profile DD.MM[.YYYY] [в] HH:MM [на N дней]».\n\n    ``HH MM`` is accepted too, matching the natural admin input\n    «20.08 в 12 00». Without a duration the role lasts exactly one day.\n    """\n    match = re.match(\n        r"^\\s*(.+?)\\s+(\\d{1,2})\\.(\\d{1,2})(?:\\.(\\d{4}))?\\s+"\n        r"(?:в\\s+)?(\\d{1,2})(?::|\\s+)(\\d{2})"\n        r"(?:\\s+на\\s+(\\d+)\\s*(?:день|дня|дней|дн\\.?))?\\s*$",\n        text or "",\n        flags=re.IGNORECASE,\n    )\n    if not match:\n        return None\n    days = int(match.group(7) or 1)\n    if not 1 <= days <= 365:\n        return None\n    hour, minute = int(match.group(5)), int(match.group(6))\n    if hour > 23 or minute > 59:\n        return None\n    start = _scheduled_local_datetime(\n        int(match.group(2)), int(match.group(3)), hour, minute,\n        int(match.group(4)) if match.group(4) else None,\n        now=now,\n    )\n    if start is None:\n        return None\n    return match.group(1).strip(), start, days\n\n\ndef admin_assign_temporary_driver(session: Session, user: User, text: str) -> None:\n    immediate = _parse_temporary_driver_request(text)\n    scheduled = _parse_scheduled_temporary_driver_request(text)\n    if not immediate and not scheduled:\n        return vk.send_message(\n            user.vk_id,\n            "Не удалось распознать данные.\\n"\n            "Сразу: https://vk.ru/id123456 1 день\\n"\n            "По расписанию: https://vk.ru/id123456 20.08 12:00\\n"\n            "Или: https://vk.ru/id123456 20.08 в 12 00 на 3 дня",\n            keyboard=kb.cancel_keyboard(),\n        )\n    if scheduled:\n        reference, starts_at, days = scheduled\n    else:\n        reference, days = immediate\n        starts_at = None\n    target = _resolve_target(session, reference)\n    if not target:\n        return vk.send_message(\n            user.vk_id,\n            "Не удалось найти пользователя. Проверьте ссылку, ID или юзернейм и попробуйте ещё раз:",\n            keyboard=kb.cancel_keyboard(),\n        )\n    if target.has_role(ROLE_DRIVER) and target.temporary_driver_until is None:\n        return vk.send_message(\n            user.vk_id,\n            "У этого пользователя уже есть постоянная роль водителя. Срок не установлен.",\n            keyboard=kb.admin_menu(can_switch_role(user)),\n        )\n    name = target.full_name or ("id" + str(target.vk_id))\n    if starts_at is not None:\n        if target.has_role(ROLE_DRIVER):\n            return vk.send_message(\n                user.vk_id,\n                "У пользователя уже действует временная роль водителя. "\n                "Сначала дождитесь окончания или уберите роль.",\n                keyboard=kb.admin_menu(can_switch_role(user)),\n            )\n        target.temporary_driver_starts_at = starts_at\n        target.temporary_driver_until = starts_at + dt.timedelta(days=days)\n        starts = time_utils.format_local(starts_at, "%d.%m.%Y %H:%M")\n        expires = time_utils.format_local(target.temporary_driver_until, "%d.%m.%Y %H:%M")\n        vk.send_message(\n            user.vk_id,\n            f"✅ Для {name} (id{target.vk_id}) запланирована роль водителя.\\n"\n            f"Начало: {starts}.\\nОкончание: {expires}.",\n            keyboard=kb.admin_menu(can_switch_role(user)),\n        )\n        vk.send_message(\n            target.vk_id,\n            f"Вам запланирована временная роль водителя с {starts} до {expires}.",\n        )\n        return set_state(session, user.vk_id, States.ADM_MENU, {}, merge=False)\n\n    target.grant_role(ROLE_DRIVER)\n    target.temporary_driver_starts_at = None\n    target.temporary_driver_until = time_utils.now() + dt.timedelta(days=days)\n    expires = time_utils.format_local(target.temporary_driver_until, "%d.%m.%Y %H:%M")\n    vk.send_message(\n        user.vk_id,\n        f"✅ {name} (id{target.vk_id}) назначен водителем на {days} {_days_word(days)}.\\n"\n        f"Роль действует до {expires}.",\n        keyboard=kb.admin_menu(can_switch_role(user)),\n    )\n    vk.send_message(\n        target.vk_id,\n        f"Вам временно назначена роль водителя до {expires}. Напишите «Меню».",\n    )\n    set_state(session, user.vk_id, States.ADM_MENU, {}, merge=False)\n\n\ndef admin_remove_role(session: Session, user: User, text: str) -> None:\n    if not user.has_role(ROLE_ADMIN):\n        return vk.send_message(user.vk_id, "Недостаточно прав.")\n    vk_id = vk.resolve_user_id(text)\n    target = session.query(User).filter(User.vk_id == vk_id).one_or_none() if vk_id else None\n    if not target:\n        vk.send_message(user.vk_id, "Пользователь не найден. Проверьте ссылку", keyboard=kb.cancel_keyboard())\n        return\n    if target.driver_status != "offline":\n        queue_service.leave_queue(session, target)\n    target.granted_roles = ROLE_PASSENGER\n    target.role = ROLE_PASSENGER\n    target.temporary_driver_until = None\n    target.temporary_driver_starts_at = None\n    target.is_on_line = False\n    reset(session, target.vk_id, States.MAIN_MENU)\n    vk.send_message(target.vk_id, "Роль администратора удалена. Вы теперь пассажир.", keyboard=kb.passenger_menu(False, _passenger_labels(session)))\n    vk.send_message(user.vk_id, "Роль администратора удалена. Пользователь теперь имеет роль „пассажир“", keyboard=kb.admin_menu(can_switch_role(user)))\n    set_state(session, user.vk_id, States.ADM_MENU)\n\ndef admin_show_remove_role_menu(session: Session, user: User) -> None:\n    """Show a menu of current drivers and dispatchers so the admin can pick\n    exactly whose role to revoke (no manual VK ID typing required)."""\n    items = []\n    for u in session.query(User).all():\n        name = u.full_name or ("id" + str(u.vk_id))\n        if u.has_role(ROLE_DRIVER):\n            items.append((u.vk_id, "🚗 %s (id%s)" % (name, u.vk_id), "driver"))\n        if u.has_role(ROLE_DISPATCHER):\n            items.append((u.vk_id, "🎧 %s (id%s)" % (name, u.vk_id), "dispatcher"))\n        if u.has_role(ROLE_ADMIN) and u.id != user.id:\n            items.append((u.vk_id, "🛠 %s (id%s)" % (name, u.vk_id), "admin"))\n    if not items:\n        vk.send_message(user.vk_id, "Нет водителей или диспетчеров для снятия роли.", keyboard=kb.admin_menu(can_switch_role(user)))\n        return set_state(session, user.vk_id, States.ADM_MENU)\n    vk.send_message(user.vk_id, "Выберите, у кого снять роль:", keyboard=kb.admin_remove_role_keyboard(items))\n    set_state(session, user.vk_id, States.ADM_MENU)\n\n\ndef admin_revoke_role(session: Session, user: User, uid, role_token) -> None:\n    if not uid or not role_token:\n        return admin_show_remove_role_menu(session, user)\n    target = session.query(User).filter(User.vk_id == int(uid)).one_or_none()\n    role = {"driver": ROLE_DRIVER, "dispatcher": ROLE_DISPATCHER, "admin": ROLE_ADMIN}.get(role_token)\n    if not target or not role:\n        vk.send_message(user.vk_id, "Не удалось найти пользователя.", keyboard=kb.admin_menu(can_switch_role(user)))\n        return set_state(session, user.vk_id, States.ADM_MENU)\n    if role == ROLE_DRIVER and target.driver_status != "offline":\n        queue_service.leave_queue(session, target)\n    target.revoke_role(role)\n    if role == ROLE_DRIVER:\n        target.temporary_driver_starts_at = None\n        target.temporary_driver_until = None\n    role_title = {"driver": "водителя", "dispatcher": "диспетчера", "admin": "администратора"}.get(role_token, role_token)\n    name = target.full_name or ("id" + str(target.vk_id))\n    vk.send_message(user.vk_id, "✅ У пользователя %s (id%s) снята роль %s." % (name, target.vk_id, role_title))\n    # Update the affected user\'s active role and keyboard immediately.\n    if target.role == ROLE_PASSENGER:\n        vk.send_message(target.vk_id, "Роль администратора снята.", keyboard=kb.passenger_menu(can_switch_role(target), _passenger_labels(session)))\n        reset(session, target.vk_id, States.MAIN_MENU)\n    return admin_show_remove_role_menu(session, user)\n\n\n# --------------------------------------------------------------------------- #\n#  Passenger extras (requirements 2, 5, 6, 7): price, support, reviews,        #\n#  delivery FSM, address re-request and spam bans.                             #\n# --------------------------------------------------------------------------- #\ndef _passenger_labels(session: Session) -> dict:\n    """Admin-editable captions for the passenger menu (cached ~5 min)."""\n    return {\n        "btn_new_order": button_label(session, "btn_new_order", "🚕 Заказать авто"),\n        "btn_booking": button_label(session, "btn_booking", "📅 Бронь дальние поездки"),\n        "btn_rules": button_label(session, "btn_rules", "📜 Правила"),\n        "btn_my_booking": button_label(session, "btn_my_booking", "🗓 Моя бронь"),\n        "btn_drivers": button_label(session, "btn_drivers", "👥 Водители"),\n        "btn_price": button_label(session, "btn_price", "\\U0001F3F7 \\u041f\\u0440\\u0430\\u0439\\u0441"),\n        "btn_price_back": button_label(session, "btn_price_back", "\\u2B05\\uFE0F \\u041d\\u0430\\u0437\\u0430\\u0434"),\n        "btn_my_reviews": button_label(session, "btn_my_reviews", "\\u2B50 \\u041c\\u043e\\u0438 \\u043e\\u0442\\u0437\\u044b\\u0432\\u044b"),\n        "btn_support": button_label(session, "btn_support", "\\U0001F198 \\u041f\\u043e\\u0434\\u0434\\u0435\\u0440\\u0436\\u043a\\u0430"),\n    }\n\n\ndef _price_children(session: Session) -> list[tuple[str, str]]:\n    return [\n        (row.section_key, row.title or ps.title_for(row.section_key))\n        for row in ps.get_children(session)\n    ]\n\n\ndef _active_driver_price_order(session: Session, user: User) -> Order | None:\n    if user.role != ROLE_DRIVER:\n        return None\n    return active_order_for(session, user, as_driver=True)\n\n\ndef _price_keyboard(session: Session, user: User) -> str:\n    return kb.price_menu_keyboard(\n        _price_children(session),\n        _passenger_labels(session),\n        active_order=_active_driver_price_order(session, user) is not None,\n    )\n\n\ndef _reset_price_state(session: Session, user: User) -> None:\n    active_order = _active_driver_price_order(session, user)\n    if active_order:\n        set_state(session, user.vk_id, States.D_IN_RIDE, {"order_id": active_order.id})\n    elif user.role == ROLE_DISPATCHER:\n        reset(session, user.vk_id, States.DISP_MENU)\n    elif user.role == ROLE_DRIVER:\n        reset(session, user.vk_id, States.D_MENU)\n    else:\n        reset(session, user.vk_id, States.MAIN_MENU)\n\n\ndef _active_driver_order_keyboard(session: Session, order: Order) -> str:\n    if delivery_service.is_delivery(order):\n        stage = "bought" if order.status == "in_progress" else "shopping"\n        return kb.driver_delivery_keyboard(stage)\n    return _driver_ride_kb(session, order)\n\n\ndef driver_return_to_active(session: Session, user: User) -> None:\n    """Restore the current trip and its keyboard from any auxiliary screen."""\n    order = active_order_for(session, user, as_driver=True)\n    if not order:\n        return show_main_menu(session, user)\n    waiting_for_price = get_state(session, user.vk_id).state == States.D_FINISH_PRICE\n    if waiting_for_price:\n        set_state(\n            session,\n            user.vk_id,\n            States.D_FINISH_PRICE,\n            {"order_id": order.id},\n            merge=False,\n        )\n        text = (\n            f"Возвращаемся к активной заявке #{order.number}.\\n"\n            "Введите итоговую стоимость поездки одним числом (₽):"\n        )\n    else:\n        set_state(\n            session,\n            user.vk_id,\n            States.D_IN_RIDE,\n            {"order_id": order.id},\n            merge=False,\n        )\n        text = f"Возвращаемся к активной заявке #{order.number}."\n    vk.send_message(\n        user.vk_id,\n        text,\n        keyboard=_active_driver_order_keyboard(session, order),\n    )\n\n\ndef return_from_price(session: Session, user: User) -> None:\n    return driver_return_to_active(session, user)\n\n\ndef show_price(session: Session, user: User) -> None:\n    """Open the same public price for passengers, drivers and dispatchers."""\n    root = ps.get_section(session, ps.ROOT_KEY)\n    text = root.content if root and root.content else ps.title_for(ps.ROOT_KEY)\n    file_id = root.file_id if root else None\n    vk.send_message(\n        user.vk_id,\n        text,\n        keyboard=_price_keyboard(session, user),\n        attachment=file_id or None,\n    )\n\n\ndef show_price_section(session: Session, user: User, key: str | None) -> None:\n    if not key or key not in ps.children_keys():\n        return show_price(session, user)\n    if key == "city_pashiya_kusya":\n        root = ps.get_section(session, ps.ROOT_KEY)\n        text = root.content if root and root.content else ps.title_for(ps.ROOT_KEY)\n        file_id = root.file_id if root else None\n    else:\n        text, file_id = ps.get_content(session, key)\n    vk.send_message(\n        user.vk_id,\n        text,\n        keyboard=_price_keyboard(session, user),\n        attachment=file_id or None,\n    )\n\n\ndef retired_price_calculator(session: Session, user: User) -> None:\n    """Recover legacy controls and saved states without calculating fares."""\n    if get_state(session, user.vk_id).state == "passenger_price_calc_route":\n        _reset_price_state(session, user)\n    return show_price(session, user)\n\n\ndef show_support(session: Session, user: User) -> None:\n    """Send the admin-editable support text and link."""\n    link = get_cached(session, "support_link", config.SUPPORT_LINK) or config.SUPPORT_LINK\n    template = get_cached(\n        session,\n        "support_text",\n        "Если нужна помощь, напишите в поддержку: {link}",\n    ) or "{link}"\n    try:\n        text = template.format(link=link)\n    except (KeyError, ValueError):\n        text = f"{template}\\n{link}"\n    vk.send_message(\n        user.vk_id,\n        text,\n        keyboard=kb.passenger_menu(can_switch_role(user), _passenger_labels(session)),\n    )\n\n\ndef show_passenger_reviews(session: Session, user: User) -> None:\n    """Requirement 7: reviews the passenger left previously."""\n    reviews = (\n        session.query(Review)\n        .filter(Review.passenger_id == user.id, Review.kind == "passenger_to_driver")\n        .order_by(Review.created_at.desc())\n        .limit(15)\n        .all()\n    )\n    labels = _passenger_labels(session)\n    if not reviews:\n        vk.send_message(\n            user.vk_id,\n            "Вы пока не оставляли отзывов водителям.",\n            keyboard=kb.passenger_menu(can_switch_role(user), labels),\n        )\n        return\n    lines = ["Ваши отзывы водителям:\\n"]\n    for r in reviews:\n        driver = session.get(User, r.driver_id) if r.driver_id else None\n        name = (driver.full_name if driver else None) or "\\u0412\\u043e\\u0434\\u0438\\u0442\\u0435\\u043b\\u044c"\n        when = time_utils.format_local(r.created_at, "%d.%m.%Y") if r.created_at else ""\n        stars_str = "\\u2B50" * int(r.stars or 0)\n        line = f"{stars_str} \\u2014 {name} ({when})"\n        if r.text:\n            line += f"\\n   \\u00ab{r.text}\\u00bb"\n        lines.append(line)\n    vk.send_message(user.vk_id, "\\n".join(lines), keyboard=kb.passenger_menu(can_switch_role(user), labels))\n\n\n# --- Delivery FSM (requirement 6) ------------------------------------------ #\ndef start_delivery_flow(session: Session, user: User) -> None:\n    data = get_data(session, user.vk_id)\n    draft = data.get("draft", {})\n    draft["order_type"] = "delivery"\n    set_state(session, user.vk_id, States.P_DELIVERY_FROM, {"draft": draft})\n    vk.send_message(user.vk_id, "\\U0001F4E6 Оформляем доставку.\\n\\U0001F4CD Откуда забрать / где купить? Напишите адрес или магазин:", keyboard=kb.cancel_keyboard())\n\n\ndef delivery_set_from(session: Session, user: User, text: str) -> None:\n    if not text:\n        return vk.send_message(user.vk_id, "Напишите, откуда забрать / где купить:")\n    data = get_data(session, user.vk_id)\n    draft = data.get("draft", {})\n    draft["address_from"] = text\n    set_state(session, user.vk_id, States.P_DELIVERY_TO, {"draft": draft})\n    vk.send_message(user.vk_id, "\\U0001F3C1 Куда доставить? Напишите адрес:", keyboard=kb.cancel_keyboard())\n\n\ndef delivery_set_to(session: Session, user: User, text: str) -> None:\n    if not text:\n        return vk.send_message(user.vk_id, "Напишите, куда доставить:")\n    data = get_data(session, user.vk_id)\n    draft = data.get("draft", {})\n    draft["address_to"] = text\n    set_state(session, user.vk_id, States.P_DELIVERY_WHAT, {"draft": draft})\n    vk.send_message(user.vk_id, "\\U0001F6D2 Что нужно купить / доставить?", keyboard=kb.cancel_keyboard())\n\n\ndef delivery_set_what(session: Session, user: User, text: str) -> None:\n    if not text:\n        return vk.send_message(user.vk_id, "Напишите, что нужно купить / доставить:")\n    data = get_data(session, user.vk_id)\n    draft = data.get("draft", {})\n    draft["delivery_what"] = text\n    set_state(session, user.vk_id, States.P_DELIVERY_COMMENT, {"draft": draft})\n    vk.send_message(user.vk_id, "\\U0001F4AC Добавьте комментарий к заказу или нажмите «Пропустить комментарий»:", keyboard=kb.delivery_comment_keyboard())\n\n\ndef delivery_set_comment(session: Session, user: User, text: str) -> None:\n    data = get_data(session, user.vk_id)\n    draft = data.get("draft", {})\n    what = draft.get("delivery_what") or "\\u2014"\n    comment = "" if (text or "").strip() == "-" else (text or "").strip()\n    parts = ["\\U0001F6D2 Купить: %s" % what]\n    if comment:\n        parts.append("\\U0001F4AC %s" % comment)\n    draft["comment"] = "\\n".join(parts)\n    set_state(session, user.vk_id, States.P_WAITING, {"draft": draft})\n    create_passenger_order(session, user, "delivery")\n\n\ndef passenger_update_address(session: Session, user: User, text: str) -> None:\n    """Replace the rejected request text completely and dispatch it again."""\n    raw = " ".join((text or "").split())\n    if not raw:\n        return vk.send_message(\n            user.vk_id,\n            "Напишите исправленный полный текст заявки — откуда и куда:",\n        )\n    data = get_data(session, user.vk_id)\n    order_id = data.get("order_id")\n    order = session.get(Order, order_id) if order_id else active_order_for(session, user)\n    if not order:\n        return show_main_menu(session, user)\n\n    # Driver offers use order_service.order_text(), which prioritises\n    # route_text. Previously only address_from changed, so the stale original\n    # request was sent to every following driver.\n    pickup_city, destination = lines.parse_pickup_city_for_session(session, raw)\n    order.route_text = raw\n    order.address_from = pickup_city or raw\n    order.address_to = destination or raw\n    order.pickup_city = pickup_city\n    order.line = pickup_city\n    order.city_id = lines.city_id_by_name(session, pickup_city)\n    # The typed correction also supersedes an old voice request.\n    order.voice_attachment = None\n    order.last_decline_reason = None\n    order.parallel_route_fallback = False\n    order.parallel_auto_excluded_driver_ids = None\n    order_service._set_current_offer(session, order, None)\n    passenger_queue.remove(session, order.id)\n    order.status = "searching"\n    set_state(\n        session,\n        user.vk_id,\n        States.P_WAITING,\n        {"declined": [], "current_offer": None},\n        merge=False,\n    )\n    vk.send_message(\n        user.vk_id,\n        f"Спасибо! Заявка обновлена:\\n{raw}\\n\\nОтправляем её водителям заново.",\n        keyboard=kb.passenger_waiting_keyboard(),\n    )\n    audit.record(session, "passenger_address_updated", f"order={order.id} route={raw[:300]}")\n    order_service.offer_to_next_driver(session, order)\n\n\n# --- Spam bans (requirement 5) --------------------------------------------- #\ndef _apply_spam_ban(session: Session, passenger: User) -> str:\n    """Escalating order ban: 1h -> 1d -> 1w. Returns a human-readable duration."""\n    count = (passenger.order_ban_count or 0) + 1\n    if count <= 1:\n        delta, human = dt.timedelta(hours=1), "1 \\u0447\\u0430\\u0441"\n    elif count == 2:\n        delta, human = dt.timedelta(days=1), "1 \\u0434\\u0435\\u043d\\u044c"\n    else:\n        delta, human = dt.timedelta(weeks=1), "1 \\u043d\\u0435\\u0434\\u0435\\u043b\\u044e"\n    passenger.order_ban_count = count\n    passenger.order_ban_until = time_utils.now() + delta\n    return human\n\n\ndef _order_ban_message(user: User) -> str | None:\n    """Return a block message if the passenger is currently order-banned."""\n    until = user.order_ban_until\n    if until is None:\n        return None\n    if until.tzinfo is None:\n        until = until.replace(tzinfo=dt.timezone.utc)\n    if until <= time_utils.now():\n        return None\n    local = time_utils.format_local(until) + " UTC+5"\n    return f"🚫 Оформление заявок временно ограничено. Доступ откроется после {local}."\n\n\ndef driver_cancel_active(session: Session, user: User, reason: str) -> None:\n    order = active_order_for(session, user, as_driver=True)\n    if not order: return show_main_menu(session, user)\n    # active_order_for may repair one legacy promoted row in memory. Persist\n    # that repair first, then lock/reload the exact current trip so completion,\n    # passenger cancellation and admin cancellation cannot race this action.\n    session.flush()\n    order = (\n        session.query(Order)\n        .filter(Order.id == order.id)\n        .with_for_update()\n        .populate_existing()\n        .one_or_none()\n    )\n    if (\n        not order\n        or order.driver_id != user.id\n        or order.status not in ("searching", "assigned", "arrived", "in_progress")\n    ):\n        return show_main_menu(session, user)\n    reason = (reason or "").strip().casefold()\n    if reason not in ("no_show", "customer_cancel", "car", "no_false_call"):\n        log.error(\n            "Unknown active-order cancel reason: driver=%s order=%s reason=%r",\n            user.id,\n            order.id,\n            reason,\n        )\n        return vk.send_message(\n            user.vk_id,\n            "Неизвестная причина отмены. Выберите вариант ещё раз.",\n            keyboard=kb.driver_active_cancel_keyboard(),\n        )\n    if getattr(order, "enroute_notice_outbox_id", None):\n        order_service.clear_enroute_notice(session, order)\n    from . import outbox_service\n    for prompt_field in ("departure_prompt_outbox_id", "chat_actuality_prompt_outbox_id"):\n        prompt_id = getattr(order, prompt_field, None)\n        if prompt_id:\n            outbox_service.cancel_or_delete(session, prompt_id)\n            setattr(order, prompt_field, None)\n    timers.cancel_all_for_order(order.id)\n    from . import parallel_orders\n    # Any automatic parallel card was valid only while this exact trip was\n    # active. Close it now instead of waiting for its 60-second callback.\n    parallel_orders.release_route_offers_for_trip(session, order)\n    passenger = session.get(User, order.passenger_id)\n    if reason == "no_false_call":\n        order.status = "cancelled"\n        order.cancelled_at = time_utils.now()\n        order.cancelled_by = "driver"\n        booking_service.cancel_for_order(session, order.id, canceled_by="driver")\n        if passenger:\n            vk.send_message(passenger.vk_id, "Водитель отменил заявку, ложного вызова не будет.")\n            if not _is_dispatcher_order(order):\n                _continue_after_passenger_order_closed(session, passenger, order.id, order.number)\n        has_parallel = parallel_orders.has_pending(session, user)\n        _leave_temporary_chat_line(session, user, order)\n        restored = False\n        if not has_parallel:\n            restored = queue_service.move_to_front(session, user) is not None\n            if not restored:\n                queue_service.set_away(session, user)\n        reset(session, user.vk_id, States.D_MENU)\n        vk.send_message(\n            user.vk_id, f"✅ Заявка #{order.number} отменена без ложного вызова.",\n            keyboard=kb.driver_menu(on_line=True, show_role_switch=can_switch_role(user)) if restored else None,\n        )\n        audit.record(session, "driver_cancel_no_false_call", f"order={order.id} driver={user.id}")\n        if has_parallel:\n            parallel_orders.promote_after_current(session, user)\n        else:\n            passenger_queue.try_promote(session)\n            if not restored:\n                lines.ask_post_ride_line(session, user)\n        return\n    if reason == "customer_cancel":\n        # The two-minute window starts only after the driver has supplied ETA:\n        # _apply_eta records that moment in driver_departed_at.  Reuse the\n        # passenger cancellation setting so both cancellation paths share the\n        # exact same strict boundary (> grace creates a false call; <= does not).\n        past_grace = bool(\n            _parallel_cancellation_is_chargeable(order)\n            or (order.driver_departed_at and not _passenger_within_grace(session, order))\n        )\n        order.status = "cancelled"\n        order.cancelled_at = time_utils.now()\n        order.cancelled_by = "passenger"\n        booking_service.cancel_for_order(\n            session, order.id, canceled_by="passenger"\n        )\n        fake_call_created = False\n        if passenger and not _is_dispatcher_order(order):\n            if past_grace:\n                fake_calls_service.create(session, order, user)\n                fake_call_created = True\n            else:\n                reset(session, passenger.vk_id, States.MAIN_MENU)\n                vk.send_message(\n                    passenger.vk_id,\n                    "Ваша заявка отменена по вашей просьбе.",\n                    keyboard=kb.passenger_menu(\n                        can_switch_role(passenger),\n                        _passenger_labels(session),\n                    ),\n                )\n        elif passenger and _is_dispatcher_order(order):\n            vk.send_message(\n                passenger.vk_id,\n                f"❌ Водитель отменил заявку #{order.number}.\\n"\n                "Причина: клиент захотел отменить. Ложный вызов не начисляется.\\n"\n                f"{order_service.dispatcher_driver_details(user)}",\n            )\n        has_parallel = parallel_orders.has_pending(session, user)\n        restored_to_front = False\n        if not has_parallel:\n            # The client requested this cancellation, so the driver did not\n            # lose the trip through their own fault.  Return them online as\n            # queue position #1 immediately, without the post-ride line menu.\n            restored_to_front = queue_service.move_to_front(session, user) is not None\n            if not restored_to_front:\n                queue_service.set_away(session, user)\n        reset(session, user.vk_id, States.D_MENU)\n        result_text = f"✅ Заявка #{order.number} отменена: клиент захотел отменить."\n        if _is_dispatcher_order(order):\n            result_text += " Диспетчерской заявке ложный вызов не начисляется."\n        elif fake_call_created:\n            if getattr(order, "parallel_accepted_at", None):\n                result_text += " По параллельной заявке после перехода создан ложный вызов."\n            else:\n                result_text += " Прошло более 2 минут после указания времени прибытия — ложный вызов создан."\n        else:\n            result_text += " Прошло не более 2 минут после указания времени прибытия — ложный вызов не создан."\n        if restored_to_front:\n            result_text += " Вы автоматически возвращены на 1-е место в очереди."\n        vk.send_message(\n            user.vk_id,\n            result_text,\n            keyboard=(\n                kb.driver_menu(on_line=True, show_role_switch=can_switch_role(user))\n                if restored_to_front else None\n            ),\n        )\n        audit.record(\n            session,\n            "driver_customer_cancel",\n            f"order={order.id} driver={user.id} fake_call={int(fake_call_created)}",\n        )\n        if has_parallel:\n            parallel_orders.promote_after_current(session, user)\n        elif restored_to_front:\n            # If passengers are waiting, their offer is queued after the\n            # driver\'s confirmation so its action keyboard remains the latest.\n            passenger_queue.try_promote(session)\n        else:\n            passenger_queue.try_promote(session)\n            lines.ask_post_ride_line(session, user)\n        return\n    if reason == "no_show":\n        order.status = "cancelled"\n        order.cancelled_at = time_utils.now()\n        if passenger and not _is_dispatcher_order(order):\n            fake_calls_service.create(\n                session,\n                order,\n                user,\n                notice_key="msg_driver_no_show_false_call",\n            )\n        has_parallel = parallel_orders.has_pending(session, user)\n        _leave_temporary_chat_line(session, user, order)\n        restored_to_front = False\n        if not has_parallel:\n            restored_to_front = queue_service.move_to_front(session, user) is not None\n            if not restored_to_front:\n                queue_service.set_away(session, user)\n        reset(session, user.vk_id, States.D_MENU)\n        result_text = f"✅ Заявка #{order.number} отменена: клиент не вышел."\n        if _is_dispatcher_order(order):\n            result_text += " Диспетчерской заявке ложный вызов не начисляется."\n            if passenger:\n                vk.send_message(\n                    passenger.vk_id,\n                    f"❌ Водитель отменил заявку #{order.number}.\\n"\n                    "Причина: клиент не вышел.\\n"\n                    f"{order_service.dispatcher_driver_details(user)}",\n                )\n        else:\n            result_text += " Ложный вызов создан."\n        if restored_to_front:\n            result_text += " Вы автоматически возвращены на 1-е место в очереди."\n        # This no-show result cannot fall through to the car-failure branch.\n        vk.send_message(\n            user.vk_id,\n            result_text,\n            keyboard=(kb.driver_menu(on_line=True, show_role_switch=can_switch_role(user))\n                      if restored_to_front else None),\n        )\n        if has_parallel:\n            parallel_orders.promote_after_current(session, user)\n        else:\n            passenger_queue.try_promote(session)\n            if not restored_to_front:\n                lines.ask_post_ride_line(session, user)\n        return\n    elif reason == "car":\n        parallel_orders.release_reserved(session, user)\n        if order.chat_driver_was_offline:\n            order.status = "cancelled"\n            order.cancelled_at = time_utils.now()\n            queue_service.leave_queue(session, user)\n            user.is_on_line = False\n            if passenger and _is_dispatcher_order(order):\n                vk.send_message(\n                    passenger.vk_id,\n                    f"❌ Водитель отменил заявку #{order.number}.\\n"\n                    "Причина: неполадка с автомобилем.\\n"\n                    f"{order_service.dispatcher_driver_details(user)}",\n                )\n            elif passenger:\n                vk.send_message(passenger.vk_id, "Водитель отменил заявку. Оформите новую заявку при необходимости.")\n            reset(session, user.vk_id, States.D_MENU)\n            vk.send_message(user.vk_id, f"Заявка #{order.number} отменена из-за неполадки с авто.")\n            lines.ask_post_ride_line(session, user)\n            return\n        order.driver_id = None; order.status = "searching"\n        order.parallel_accepted_at = None\n        queue_service.set_away(session, user)\n        if passenger and _is_dispatcher_order(order):\n            vk.send_message(\n                passenger.vk_id,\n                f"⚠️ Водитель отказался от заявки #{order.number}.\\n"\n                "Причина: неполадка с автомобилем. Заявка отправлена следующему водителю.\\n"\n                f"{order_service.dispatcher_driver_details(user)}",\n            )\n        elif passenger:\n            vk.send_message(passenger.vk_id, "У водителя сломалась машина, ваша заявка отправлена следующему водителю", keyboard=kb.passenger_waiting_keyboard())\n        reset(session, user.vk_id, States.D_MENU)\n        order_service.offer_to_next_driver(session, order)\n        passenger_queue.try_promote(session)\n        vk.send_message(user.vk_id, f"Заявка #{order.number} отменена из-за неполадки с авто.")\n        lines.ask_post_ride_line(session, user)\n\n\ndef driver_cancel_back(session: Session, user: User) -> None:\n    return driver_return_to_active(session, user)\n\n\n# Statuses in which a request can no longer be claimed from the requests chat.\nCHAT_CLAIM_CLOSED_STATUSES = (\n    "assigned", "arrived", "in_progress", "parallel_assigned", "completed", "cancelled",\n)\n\n\ndef driver_take_from_chat(session: Session, user: User, order_id) -> None:\n    """Assign a request published in the requests chat to this driver.\n\n    The claim is refused only when the driver already has an active ride or\n    when somebody else owns the request. Away status, an empty line, a dead\n    offer lock and missing car details are repaired here instead of dropping\n    the claim, so a pressed chat button always has a visible result.\n    """\n    order = (\n        session.query(Order).filter(Order.id == int(order_id)).with_for_update().one_or_none()\n        if order_id\n        else None\n    )\n    if order is None:\n        _chat_claim_reply(session, user, f"заявка №{order_id} не найдена.")\n        log.warning("Chat claim: order %s not found (driver=%s)", order_id, user.id)\n        return vk.send_message(user.vk_id, "Заявка уже недоступна.")\n    from . import parallel_orders\n    if not parallel_orders.local_line_allows(order, user):\n        return vk.send_message(user.vk_id, "Эта заявка доступна только водителям соответствующей линии.")\n    if blacklist_service.blocks(session, user.id, order.passenger_id):\n        return vk.send_message(user.vk_id, "Заявка недоступна.")\n    active = active_order_for(session, user, as_driver=True)\n    if active and active.id != order.id:\n        if parallel_orders.has_pending(session, user):\n            _chat_claim_reply(\n                session, user,\n                "у вас уже есть параллельная заявка — сначала перейдите к ней.",\n            )\n            return vk.send_message(\n                user.vk_id,\n                "У вас уже есть одна параллельная заявка. Новую можно взять после перехода к ней.",\n            )\n        claimed = parallel_orders.take(session, user, order.id, from_chat=True)\n        if claimed is not None and claimed.parallel_driver_id == user.id:\n            session.flush()\n            try:\n                _finalize_chat_claim_notice(session, claimed, user)\n            except Exception as exc:  # noqa: BLE001\n                log.exception("Parallel chat notice finalize failed for order %s: %s", claimed.id, exc)\n            audit.record(\n                session, "driver_chat_parallel_take",\n                f"order={claimed.id} driver={user.id} current={active.id}",\n            )\n        return\n    if order.driver_id and order.driver_id != user.id:\n        holder = session.get(User, order.driver_id)\n        holder_name = (holder.full_name if holder else None) or "другой водитель"\n        _chat_claim_reply(session, user, f"заявку №{order.number} уже взял водитель {holder_name}.")\n        log.warning("Chat claim rejected: order=%s owned by driver=%s", order.id, order.driver_id)\n        return vk.send_message(user.vk_id, "Заявку уже взял другой водитель.")\n    if order.status in CHAT_CLAIM_CLOSED_STATUSES:\n        _chat_claim_reply(session, user, f"заявка №{order.number} уже закрыта.")\n        log.warning("Chat claim rejected: order=%s status=%s", order.id, order.status)\n        return vk.send_message(user.vk_id, "Заявка уже недоступна.")\n    if blacklist_service.blocks(session, user.id, order.passenger_id):\n        return vk.send_message(user.vk_id, "Заявка недоступна.")\n    # A public chat tap only reserves the offer. ETA confirms it within 60 seconds.\n    if order.offered_driver_id and order.offered_driver_id != user.id:\n        return vk.send_message(user.vk_id, "Заявку уже рассматривает другой водитель.")\n    if not lines.has_complete_car(user):\n        vk.send_message(user.vk_id, "Пожалуйста, заполните «Моя машина»: марка, цвет и госномер.")\n    return reserve_eta_offer(session, user, order, source="chat")\n\n\n\n\n\ndef passenger_chat_order_actual(session: Session, user: User, order_id, actual: bool) -> None:\n    order = session.query(Order).filter(Order.id == int(order_id)).with_for_update().one_or_none() if order_id else None\n    if not order or order.passenger_id != user.id or order.status not in ("assigned", "parallel_assigned"):\n        return vk.send_message(user.vk_id, "Эта заявка уже недоступна.")\n    if not order.chat_actuality_prompt_outbox_id:\n        return\n    timers.cancel("chat_actual", order.id)\n    if order.chat_actuality_prompt_outbox_id:\n        from . import outbox_service\n        outbox_service.finalize_tracked_message(\n            session,\n            order.chat_actuality_prompt_outbox_id,\n            "✅ Вы ответили: заявка актуальна." if actual else "❌ Вы ответили: заявка неактуальна.",\n        )\n        order.chat_actuality_prompt_outbox_id = None\n    parallel_confirmation = bool(getattr(order, "parallel_accepted_at", None)) or order.status == "parallel_assigned"\n    driver_id = order.parallel_driver_id if order.status == "parallel_assigned" else order.driver_id\n    driver = session.get(User, driver_id) if driver_id else None\n    if not actual and parallel_confirmation:\n        return passenger_cancel(session, user, order.id)\n    if not actual:\n        order.status = "cancelled"\n        order.cancelled_at = time_utils.now()\n        if driver and order.parallel_driver_id == driver.id:\n            current = active_order_for(session, driver, as_driver=True)\n            if current:\n                set_state(session, driver.vk_id, States.D_IN_RIDE,\n                          {"order_id": current.id}, merge=False)\n                vk.send_message(\n                    driver.vk_id,\n                    "Клиент не подтвердил ожидание. Параллельная заявка отменена; текущая поездка продолжается.",\n                    keyboard=_driver_ride_kb(session, current),\n                )\n            reset(session, user.vk_id, States.MAIN_MENU)\n            vk.send_message(user.vk_id, "Заявка отменена.",\n                            keyboard=kb.passenger_menu(can_switch_role(user), _passenger_labels(session)))\n            return\n        if driver:\n            if order.chat_driver_was_offline:\n                if order.order_type in ("delivery", "partner_delivery"):\n                    queue_service.move_to_front(session, driver)\n                else:\n                    queue_service.leave_queue(session, driver)\n                    driver.is_on_line = False\n            else:\n                if order.order_type in ("delivery", "partner_delivery"):\n                    queue_service.move_to_front(session, driver)\n                else:\n                    queue_service.restore_position(session, driver)\n            reset(session, driver.vk_id, States.D_MENU)\n            text = "Пассажир сообщил, что заявка уже неактуальна."\n            if (\n                order.chat_driver_was_offline\n                and order.order_type not in ("delivery", "partner_delivery")\n            ):\n                text += " Вы не были на линии. Готовы выйти на линию?"\n            vk.send_message(\n                driver.vk_id,\n                text,\n                keyboard=kb.driver_menu(\n                    bool(driver.is_on_line),\n                    can_switch_role(driver),\n                ),\n            )\n        reset(session, user.vk_id, States.MAIN_MENU)\n        vk.send_message(user.vk_id, "Заявка отменена.", keyboard=kb.passenger_menu(can_switch_role(user), _passenger_labels(session)))\n        passenger_queue.try_promote(session)\n        return\n    if driver:\n        if parallel_confirmation:\n            order.actuality_confirmed = True\n            vk.send_message(\n                driver.vk_id,\n                "Клиент по параллельной заявке, ожидает на месте",\n            )\n            if not getattr(order, "enroute_notice_outbox_id", None):\n                order.enroute_notice_outbox_id = vk.send_tracked_message(user.vk_id, "Машинка в пути")\n            vk.send_message(\n                user.vk_id,\n                "Спасибо! Водитель получил подтверждение и укажет время прибытия.",\n                keyboard=kb.passenger_waiting_keyboard(order.id),\n            )\n            set_state(session, user.vk_id, States.P_WAITING, {"order_id": order.id}, merge=False)\n            if order.status == "parallel_assigned":\n                return parallel_orders.prompt_eta_after_actuality(session, driver, order)\n            return driver_show_eta_menu(session, driver)\n        order.actuality_confirmed = True\n        if delivery_service.is_delivery(order):\n            vk.send_message(user.vk_id, "Водитель рассчитывает стоимость доставки.")\n            return delivery_service.request_price(session, driver, order)\n        order.actuality_confirmed = True\n        if order.arrival_eta:\n            return _apply_eta(session, driver, order, order.arrival_eta)\n        else:\n            _show_eta_menu(session, driver, order,\n                           intro=f"Пассажир: {_vk_label(user)} подтвердил: заявка актуальна.\\n"\n                                 f"📌 {order_service.order_text(order)}")\n    vk.send_message(user.vk_id, "Спасибо! Водитель получил подтверждение.", keyboard=kb.passenger_waiting_keyboard())\n    set_state(session, user.vk_id, States.P_IN_RIDE, {"order_id": order.id}, merge=False)\n\n\ndef chat_actuality_timeout(order_id: int) -> None:\n    """Cancel a chat-claimed request when the passenger is silent for 1 minute."""\n    from common.database import session_scope\n    with session_scope() as session:\n        order = session.query(Order).filter(Order.id == int(order_id)).with_for_update().one_or_none()\n        if not order or order.status not in ("assigned", "parallel_assigned") or not order.chat_actuality_prompt_outbox_id:\n            return\n        from . import outbox_service\n        outbox_service.cancel_or_delete(session, order.chat_actuality_prompt_outbox_id)\n        order.chat_actuality_prompt_outbox_id = None\n        was_parallel = order.status == "parallel_assigned"\n        order.status = "cancelled"\n        order.cancelled_at = time_utils.now()\n        order.cancelled_by = "system"\n        passenger = session.get(User, order.passenger_id)\n        driver_id = order.parallel_driver_id if was_parallel else order.driver_id\n        driver = session.get(User, driver_id) if driver_id else None\n        if passenger:\n            vk.send_message(\n                passenger.vk_id,\n                "Вы не подтвердили актуальность заявки, ваша заявка отменена автоматически",\n                keyboard=kb.passenger_menu(can_switch_role(passenger), _passenger_labels(session)),\n            )\n            reset(session, passenger.vk_id, States.MAIN_MENU)\n        if driver:\n            if order.parallel_driver_id == driver.id:\n                current = active_order_for(session, driver, as_driver=True)\n                if current:\n                    set_state(session, driver.vk_id, States.D_IN_RIDE,\n                              {"order_id": current.id}, merge=False)\n                    vk.send_message(\n                        driver.vk_id,\n                        "Клиент не подтвердил ожидание за 1 минуту. Параллельная заявка отменена; текущая поездка продолжается.",\n                        keyboard=_driver_ride_kb(session, current),\n                    )\n                return\n            if order.chat_driver_was_offline:\n                if order.order_type in ("delivery", "partner_delivery"):\n                    queue_service.move_to_front(session, driver)\n                else:\n                    queue_service.leave_queue(session, driver)\n                    driver.is_on_line = False\n            else:\n                if order.order_type in ("delivery", "partner_delivery"):\n                    queue_service.move_to_front(session, driver)\n                else:\n                    queue_service.restore_position(session, driver)\n            reset(session, driver.vk_id, States.D_MENU)\n            vk.send_message(\n                driver.vk_id,\n                "Пассажир не подтвердил актуальность заявки за 1 минуту. Заявка отменена.",\n                keyboard=kb.driver_menu(bool(driver.is_on_line), can_switch_role(driver)),\n            )\n        passenger_queue.try_promote(session)\n\n\ndef driver_depart_from_chat_order(session: Session, user: User, order_id) -> None:\n    order = session.get(Order, int(order_id)) if order_id else None\n    if not order or order.driver_id != user.id or order.status != "assigned":\n        return vk.send_message(user.vk_id, "Заявка уже недоступна.")\n    _show_eta_menu(session, user, order)\n\n\ndef _leave_temporary_chat_line(session: Session, user: User, order: Order) -> None:\n    """Remove a driver who joined the queue only to complete a chat order."""\n    if not order.chat_driver_was_offline:\n        return\n    queue_service.leave_queue(session, user)\n    user.is_on_line = False\n    reset(session, user.vk_id, States.D_MENU)\n    vk.send_message(user.vk_id, "Заявка завершена. Вы сняты с линии. Готовы выйти на линию?", keyboard=kb.driver_menu(False))\n\n\ndef driver_show_unclaimed_chat_requests(session: Session, user: User) -> None:\n    """Send all currently unclaimed driver-chat orders and bookings privately."""\n    orders = (\n        session.query(Order)\n        .filter(Order.status == "chat_search")\n        .order_by(Order.created_at.asc())\n        .limit(30)\n        .all()\n    )\n    bookings = (\n        session.query(Booking)\n        .filter(Booking.status == "pending")\n        .order_by(Booking.scheduled_at.asc())\n        .limit(30)\n        .all()\n    )\n    excluded = blacklist_service.excluded_driver_ids\n    orders = [order for order in orders if user.id not in excluded(session, order.passenger_id)]\n    bookings = [booking for booking in bookings if user.id not in excluded(session, booking.passenger_id)]\n    if not orders and not bookings:\n        vk.send_message(user.vk_id, "Сейчас нет заявок без водителя.")\n        return\n    vk.send_message(user.vk_id, "📋 Заявки без водителя:")\n    for order in orders:\n        label = order_service.driver_chat_reason_label(session, order) or "заявка"\n        vk.send_message(\n            user.vk_id,\n            f"🔔 Заявка №{order.number}\\nПричина: {label.capitalize()}\\nМаршрут: {order_service.order_text(order)}",\n            keyboard=kb.chat_take_keyboard(order.id, order.number),\n        )\n    for booking in bookings:\n        vk.send_message(\n            user.vk_id,\n            "📅 Бронь без водителя\\n" + booking_service.format_summary(booking),\n            keyboard=kb.booking_take_keyboard(booking.id, booking.number),\n        )\n'

