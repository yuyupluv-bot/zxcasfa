# Copy VALUES to BotHost environment variables; never publish a filled file.
# Mandatory: external PostgreSQL URL, not localhost and not the Compose db hostname.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
VK_TOKEN=PASTE_COMMUNITY_TOKEN
VK_GROUP_ID=123456789
ADMIN_VK_IDS=123456789
SECRET_KEY=CHANGE_TO_RANDOM_64_HEX_SECRET
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_TO_STRONG_ADMIN_PASSWORD
# Optional alternative to ADMIN_PASSWORD (Werkzeug hash):
ADMIN_PASSWORD_HASH=

PORT=3000
TZ=Asia/Yekaterinburg
FLASK_COOKIE_SECURE=1
WEB_WORKERS=1
WEB_THREADS=4
ADMIN_WATCHDOG_ENABLED=1
BOT_WATCHDOG_ENABLED=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
BOT_WORKERS=8
OUTBOX_WORKERS=4
TIMER_WORKERS=4
LOG_TO_FILE=0
LOG_LEVEL=INFO
PUSH_SOUND_DIR=/app/data/push_sounds
VK_API_VERSION=5.199

# Driver chat (only when used):
VK_CHAT_USER_TOKEN=
DRIVER_CHAT_PEER_ID=0
DRIVER_FALLBACK_CHAT_PEER_ID=0

# Optional Firebase push, NOT needed for the VK bot and admin themselves.
# Base64 is encoding, not encryption. Store the value only in hosting secrets.
FIREBASE_SERVICE_ACCOUNT_B64=
VK_BOT_URL=https://vk.me/club123456789
SUPPORT_LINK=https://vk.me/club123456789
# Optional custom APK path; see README_BOTHOST_RU.md.
# DRIVER_APP_APK_FILE=/app/downloads/BEZTAKSY.apk
